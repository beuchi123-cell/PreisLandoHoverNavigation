                if (type === "R" || type === "Q") {
                    directions.push([-1,0],[1,0],[0,-1],[0,1]);
                }

                for (let d = 0; d < directions.length; d++) {
                    let rr = r + directions[d][0];
                    let cc = c + directions[d][1];
                    while (inside(rr, cc)) {
                        const at = idx(rr, cc);
