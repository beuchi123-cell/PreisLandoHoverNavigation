/* Mobile */
@media (max-width: 767.98px) {
    .pl-ticket-hero,
    .pl-ticket-hero__side {
        grid-template-columns: 1fr;
    }

    .pl-ticket-card--big,
    .pl-ticket-card--small {
        height: 170px;
        min-height: 170px;
        max-height: none;
    }

    .pl-ticket-card--big .pl-ticket-card__title,
    .pl-ticket-card--sale .pl-ticket-card__title {
        font-size: 34px;
    }

