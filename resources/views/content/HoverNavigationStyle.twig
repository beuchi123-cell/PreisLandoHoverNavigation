<style>
/* =========================================================
   PREISLANDO MEGA-MENÜ
   DESKTOP
   ========================================================= */

@media (min-width: 1200px) {

    /* Gesamte Navigation = Bezugspunkt */
    .kategorie-11-spalten {
        position: relative !important;
        overflow: visible !important;
    }

    .kategorie-11-spalten .widget-inner,
    .kategorie-11-spalten .row {
        overflow: visible !important;
    }


    /* Hauptkategorien */
    .kategorie-11-spalten
    .preis-lando-hover-parent {
        position: relative !important;
        z-index: 1 !important;
        overflow: visible !important;
    }


    /* aktive Hauptkategorie über Mega-Menü halten */
    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active {
        z-index: 20002 !important;
    }


    /* aktive Kachel wie Tab hervorheben */
    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active
    > a
    .nav-item {

        position: relative !important;

        background: #f1f1f1 !important;

        border-left: 1px solid #d5d5d5 !important;
        border-right: 1px solid #d5d5d5 !important;
        border-top: 1px solid #d5d5d5 !important;

        z-index: 20003 !important;
    }


    /* =====================================================
       MEGA-MENÜ
       ===================================================== */

    .preis-lando-hover-menu {
        display: none;

        /*
         * WICHTIG:
         * JS setzt top/left/width passend zum Widget.
         */
        position: fixed !important;

        left: var(--pl-menu-left, 0px) !important;
        top: var(--pl-menu-top, 0px) !important;

        width: var(--pl-menu-width, 100%) !important;

        margin: 0 !important;

        padding:
            48px
            16px
            16px
            16px !important;

        background: #f1f1f1 !important;

        border: 1px solid #d5d5d5 !important;

        border-radius: 0 !important;

        box-shadow:
            0 5px 15px
            rgba(0, 0, 0, 0.18) !important;

        z-index: 20000 !important;

        box-sizing: border-box !important;
    }


    .preis-lando-hover-menu.is-visible {
        display: block !important;
    }


    .preis-lando-hover-menu.is-empty {
        display: none !important;
    }


    /* =====================================================
       AUSBUCHTUNG / TAB NACH OBEN
       ===================================================== */

    .preis-lando-hover-menu.has-notch::before {
        content: "";

        position: absolute !important;

        left: var(--pl-notch-left, 0px) !important;

        top:
            calc(
                -1 *
                var(--pl-notch-height, 30px)
            ) !important;

        width:
            var(--pl-notch-width, 100px) !important;

        height:
            calc(
                var(--pl-notch-height, 30px)
                + 2px
            ) !important;

        background: #f1f1f1 !important;

        border-left:
            1px solid #d5d5d5 !important;

        border-right:
            1px solid #d5d5d5 !important;

        border-top:
            1px solid #d5d5d5 !important;

        box-sizing: border-box !important;

        z-index: -1 !important;
    }


    /*
     * Kleine weiße Linie unten entfernen,
     * damit Tab und grauer Bereich zusammenhängen.
     */
    .preis-lando-hover-menu.has-notch::after {
        content: "";

        position: absolute !important;

        left:
            calc(
                var(--pl-notch-left, 0px)
                + 1px
            ) !important;

        top: -2px !important;

        width:
            calc(
                var(--pl-notch-width, 100px)
                - 2px
            ) !important;

        height: 4px !important;

        background: #f1f1f1 !important;

        z-index: 2 !important;
    }


    /* =====================================================
       SCHLIESSEN
       ===================================================== */

    .preis-lando-hover-close {
        position: absolute !important;

        top: 10px !important;
        right: 18px !important;

        display: flex !important;

        align-items: center !important;

        gap: 8px !important;

        margin: 0 !important;
        padding: 4px 0 !important;

        border: 0 !important;

        background: transparent !important;

        color: #666 !important;

        font-family: inherit !important;
        font-size: 13px !important;
        line-height: 20px !important;

        cursor: pointer !important;
    }


    .preis-lando-hover-close:hover {
        color: #222 !important;
    }


    .preis-lando-hover-close-x {
        font-size: 25px !important;
        line-height: 20px !important;
        font-weight: 300 !important;
    }


    /* =====================================================
       INHALT: 3 SPALTEN
       ===================================================== */

    .preis-lando-hover-content {
        display: grid !important;

        grid-template-columns:
            repeat(3, minmax(0, 1fr)) !important;

        column-gap: 4px !important;
        row-gap: 0 !important;

        width: 100% !important;

        margin: 0 !important;
        padding: 0 !important;

        box-sizing: border-box !important;
    }


    /* =====================================================
       UNTERKATEGORIE
       ===================================================== */

    .preis-lando-hover-item {
        display: flex !important;

        width: 100% !important;
        min-width: 0 !important;

        min-height: 50px !important;

        margin: 0 !important;
        padding: 5px 10px !important;

        align-items: center !important;

        background: #fff !important;

        border: 0 !important;
        border-bottom: 1px solid #ddd !important;

        color: #333 !important;
        text-decoration: none !important;

        box-sizing: border-box !important;

        transition:
            background-color
            0.15s ease !important;
    }


    .preis-lando-hover-item:hover {
        background: #f7f7f7 !important;

        color: #333 !important;
        text-decoration: none !important;
    }


    /* =====================================================
       BILDER
       ===================================================== */

    .preis-lando-hover-image {
        display: block !important;

        flex: 0 0 42px !important;

        width: 42px !important;
        height: 42px !important;

        max-width: 42px !important;
        max-height: 42px !important;

        margin-right: 10px !important;

        object-fit: contain !important;

        background: #fff !important;
    }


    .preis-lando-hover-image-empty {
        background: transparent !important;
    }


    /* =====================================================
       TEXT
       ===================================================== */

    .preis-lando-hover-text {
        display: block !important;

        flex: 1 1 auto !important;

        min-width: 0 !important;

        font-size: 14px !important;
        line-height: 18px !important;

        color: #333 !important;

        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }


    /* =====================================================
       LADEN
       ===================================================== */

    .preis-lando-hover-loading {
        grid-column: 1 / -1 !important;

        padding: 20px !important;

        background: #fff !important;
    }
}


/* =========================================================
   MOBIL
   ========================================================= */

@media (max-width: 1199.98px) {

    .preis-lando-hover-menu {
        display: none !important;
    }
}
</style>
