/* =========================================================
   v1.4.12 – Desktop Hover-Brücke + Mobile Drawer
   ========================================================= */
@media (min-width: 768px) {
    html {
        scrollbar-gutter: stable !important;
    }

    /* Die Kategorie direkt unter der aktiven Hauptkategorie ist nur
       graue Durchgangsfläche. Das LI bleibt pointer-aktiv, damit der
       gemeinsame Navigationsbereich nicht verlassen wird; der Link
       selbst ist währenddessen absichtlich nicht anklickbar. */
    .preis-lando-navigation-root
    .preis-lando-nav-category.preis-lando-hover-under-active {
        pointer-events: auto !important;
        cursor: default !important;
    }

    .preis-lando-navigation-root
    .preis-lando-nav-category.preis-lando-hover-under-active
    > .preis-lando-nav-link {
        color: transparent !important;
        text-shadow: none !important;
        background: #eeeeee !important;
        border-color: #dddddd !important;
        pointer-events: none !important;
        cursor: default !important;
    }
}

