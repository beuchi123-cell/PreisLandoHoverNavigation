/* Tablet */
@media (max-width: 991.98px) {
    .pl-ticket-hero {
        grid-template-columns: 1fr;
        height: auto;
    }

    .pl-ticket-hero__side {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
        height: auto;
    }

    .pl-ticket-card--big {
        height: 180px;
    }

    .pl-ticket-card--small {
        height: 110px;
        max-height: none;
    }

