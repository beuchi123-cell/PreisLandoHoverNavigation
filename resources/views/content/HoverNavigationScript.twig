<script>
(function () {
    "use strict";

    /* =====================================================
       PREISLANDO HOVER NAVIGATION
       Standard-Kategorienavigation -> Root 1838 ausblenden
       und direkte Kinder als sichtbare Hauptnavigation zeigen.
       ===================================================== */

    const ROOT_CATEGORY_ID = 1838;
    const ROOT_CATEGORY_PATH = "/neuetischkultur-sw5";
    const ROOT_CATEGORY_NAME = "neuetischkultur sw5";

    const HOVER_BREAKPOINT = 768;
    const MAX_CHILDREN = 100;
    const HOVER_OPEN_DELAY = 120;
    const HOVER_CLOSE_DELAY = 350;
    const IMAGE_PRELOAD_CONCURRENCY = 4;

    window.PreisLandoHoverVersion = "1.4.5";
    document.documentElement.setAttribute("data-preislando-hover-version", "1.4.5");
    console.info("[PreisLandoHoverNavigation] v1.4.5 geladen");

    let hoverOpenTimer = null;
    let hoverCloseTimer = null;
    let activeHoverBox = null;
    let initializeTimer = null;
    let rootCategoriesPromise = null;

    const childCache = {};
    const childRequests = {};
    const categoryImageCache = {};
    const categoryImageRequests = {};

    const imagePreloadQueue = [];
    let activeImagePreloads = 0;

    function isHoverMode() {
        return window.innerWidth >= HOVER_BREAKPOINT;
    }

    function normalizePath(url) {
        if (!url) return "";

        try {
            return new URL(url, window.location.origin)
                .pathname
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        } catch (error) {
            return String(url)
                .split("?")[0]
                .split("#")[0]
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
    }

    function getCategoryName(category) {
        return category && category.details && category.details[0]
            ? (category.details[0].name || "")
            : "";
    }

    function getCategoryUrl(category) {
        if (!category || !category.url) return "#";

        let url = String(category.url);
        if (url.charAt(0) !== "/") url = "/" + url;

        if (
            typeof App !== "undefined" &&
            App.urls &&
            App.urls.includeLanguage &&
            App.language
        ) {
            const languagePrefix = "/" + App.language;
            if (url !== languagePrefix && url.indexOf(languagePrefix + "/") !== 0) {
                url = languagePrefix + url;
            }
        }

        return url;
    }

    function fetchCategoryChildren(categoryId) {
        const url =
            "/rest/io/categorytree/children" +
            "?categoryId=" + encodeURIComponent(categoryId) +
            "&indexStart=0" +
            "&maxCount=" + MAX_CHILDREN;

        return fetch(url, {
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
            .then(function (response) {
                if (!response.ok) throw new Error("HTTP " + response.status);
                return response.json();
            })
            .then(function (response) {
                if (response && Array.isArray(response.data)) return response.data;
                if (Array.isArray(response)) return response;
                return [];
            });
    }

    function loadCategoryChildren(categoryId) {
        if (Object.prototype.hasOwnProperty.call(childCache, categoryId)) {
            return Promise.resolve(childCache[categoryId]);
        }

        if (childRequests[categoryId]) return childRequests[categoryId];

        childRequests[categoryId] = fetchCategoryChildren(categoryId)
            .then(function (children) {
                childCache[categoryId] = Array.isArray(children) ? children : [];
                return childCache[categoryId];
            })
            .catch(function (error) {
                console.error(
                    "PreisLando HoverNavigation: Unterkategorien konnten nicht geladen werden.",
                    categoryId,
                    error
                );
                childCache[categoryId] = [];
                return [];
            })
            .finally(function () {
                delete childRequests[categoryId];
            });

        return childRequests[categoryId];
    }

    function loadRootCategories() {
        if (!rootCategoriesPromise) {
            rootCategoriesPromise = loadCategoryChildren(ROOT_CATEGORY_ID);
        }
        return rootCategoriesPromise;
    }

    function getCategoryImage(category) {
        if (!category || !category.details || !category.details[0]) return "";

        const details = category.details[0];
        let imagePath = details.image2Path || details.imagePath || "";
        if (!imagePath) return "";

        if (/^https?:\/\//i.test(imagePath)) return imagePath;

        imagePath = imagePath.replace(/^\/+/, "");
        return imagePath.indexOf("documents/") === 0
            ? "/" + imagePath
            : "/documents/" + imagePath;
    }

    function loadFallbackCategoryImage(category) {
        if (!category || !category.id) return Promise.resolve("");

        const categoryId = category.id;

        if (Object.prototype.hasOwnProperty.call(categoryImageCache, categoryId)) {
            return Promise.resolve(categoryImageCache[categoryId]);
        }

        if (categoryImageRequests[categoryId]) {
            return categoryImageRequests[categoryId];
        }

        const url = "/rest/preislando/category-image/" + encodeURIComponent(categoryId);

        categoryImageRequests[categoryId] = fetch(url, {
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
            .then(function (response) {
                if (!response.ok) throw new Error("Kategorie-Bild HTTP " + response.status);
                return response.json();
            })
            .then(function (data) {
                const image = data && data.success && data.image ? data.image : "";
                categoryImageCache[categoryId] = image;
                return image;
            })
            .catch(function (error) {
                console.warn(
                    "PreisLando HoverNavigation: Kategorie-Bild konnte nicht geladen werden",
                    categoryId,
                    error
                );
                categoryImageCache[categoryId] = "";
                return "";
            })
            .finally(function () {
                delete categoryImageRequests[categoryId];
            });

        return categoryImageRequests[categoryId];
    }

    function runImagePreloadQueue() {
        while (
            activeImagePreloads < IMAGE_PRELOAD_CONCURRENCY &&
            imagePreloadQueue.length
        ) {
            const job = imagePreloadQueue.shift();
            activeImagePreloads++;

            Promise.resolve()
                .then(job)
                .catch(function () {})
                .finally(function () {
                    activeImagePreloads--;
                    runImagePreloadQueue();
                });
        }
    }

    function queueImagePreload(job) {
        imagePreloadQueue.push(job);
        runImagePreloadQueue();
    }

    function preloadImage(url) {
        if (!url) return Promise.resolve();
        return new Promise(function (resolve) {
            const img = new Image();
            let done = false;
            function finish() {
                if (done) return;
                done = true;
                resolve();
            }
            img.onload = finish;
            img.onerror = finish;
            img.src = url;
            if (img.complete) finish();
        });
    }

    /* =====================================================
       STANDARDNAVIGATION FINDEN
       ===================================================== */

    function findRootLink() {
        const preferred = document.querySelector(".preis-lando-navigation");
        const scope = preferred || document;

        const links = Array.from(scope.querySelectorAll("li.ddown > a, a"));

        return links.find(function (link) {
            const path = normalizePath(link.getAttribute("href") || link.href);
            const text = (link.textContent || "").trim().toLowerCase();

            return path === ROOT_CATEGORY_PATH ||
                path.endsWith(ROOT_CATEGORY_PATH) ||
                text === ROOT_CATEGORY_NAME;
        }) || null;
    }

    function findTopList(rootLink) {
        if (!rootLink) return null;
        const rootLi = rootLink.closest("li");
        if (!rootLi) return null;
        return rootLi.parentElement && rootLi.parentElement.tagName === "UL"
            ? rootLi.parentElement
            : null;
    }

    function getGeneratedBoxes(topList) {
        return Array.from(
            topList.querySelectorAll(":scope > li.preis-lando-nav-category")
        );
    }

    function categoryMatchesLink(category, link) {
        const categoryPath = normalizePath(getCategoryUrl(category));
        const linkPath = normalizePath(link.getAttribute("href") || link.href);

        if (categoryPath && linkPath && (
            categoryPath === linkPath ||
            linkPath.endsWith(categoryPath) ||
            categoryPath.endsWith(linkPath)
        )) {
            return true;
        }

        return getCategoryName(category).trim().toLowerCase() ===
            (link.textContent || "").trim().toLowerCase();
    }

    /* =====================================================
       HAUPTKATEGORIEN AUS ROOT HOCHZIEHEN
       ===================================================== */

    function buildPromotedNavigation(rootLink, categories) {
        const rootLi = rootLink.closest("li");
        const topList = findTopList(rootLink);

        if (!rootLi || !topList || !categories.length) return null;

        topList.classList.add("preis-lando-navigation-root");
        rootLi.classList.add("preis-lando-original-root");

        if (topList.dataset.preisLandoPromoted === "1") {
            return topList;
        }

        categories.forEach(function (category) {
            if (!category || !category.id) return;

            const box = document.createElement("li");
            box.className =
                "preis-lando-nav-category preis-lando-hover-parent";
            box.dataset.categoryId = String(category.id);

            const link = document.createElement("a");
            link.className = "preis-lando-nav-link";
            link.href = getCategoryUrl(category);
            link.setAttribute("itemprop", "name");
            link.textContent = getCategoryName(category);

            box.appendChild(link);
            topList.insertBefore(box, rootLi);

            prepareCategoryBox(topList, box, category);
        });

        topList.dataset.preisLandoPromoted = "1";
        return topList;
    }

    /* =====================================================
       GEMEINSAMES RASTER / HOVER-MENÜ
       Der Hover-Bereich ist EIN gemeinsames Grid-Element unter
       allen Hauptkategorien. Er hängt nicht mehr an einem einzelnen LI.
       ===================================================== */

    function cancelHoverOpen() {
        if (hoverOpenTimer) {
            clearTimeout(hoverOpenTimer);
            hoverOpenTimer = null;
        }
    }

    function cancelHoverClose() {
        if (hoverCloseTimer) {
            clearTimeout(hoverCloseTimer);
            hoverCloseTimer = null;
        }
    }

    function getSharedMenu(topList) {
        return topList
            ? topList.querySelector(":scope > .preis-lando-hover-menu")
            : null;
    }

    function closeAllHoverMenus() {
        cancelHoverOpen();
        cancelHoverClose();

        document.querySelectorAll(".preis-lando-hover-menu").forEach(function (menu) {
            menu.classList.remove("is-visible", "is-loading", "is-empty");
        });

        document.querySelectorAll(".preis-lando-hover-parent").forEach(function (box) {
            box.classList.remove("is-hover-active");
        });

        document.querySelectorAll(".preis-lando-navigation-root").forEach(function (root) {
            root.classList.remove("preis-lando-hover-open");
        });

        activeHoverBox = null;
    }

    function closeActiveHoverMenu() {
        if (!activeHoverBox) return;

        const topList = activeHoverBox.closest(".preis-lando-navigation-root");
        const menu = getSharedMenu(topList);
        if (menu) menu.classList.remove("is-visible", "is-loading");

        activeHoverBox.classList.remove("is-hover-active");
        if (topList) topList.classList.remove("preis-lando-hover-open");
        activeHoverBox = null;
    }

    function setActiveCategory(topList, box) {
        const boxes = getGeneratedBoxes(topList);
        const activeRect = box ? box.getBoundingClientRect() : null;
        const activeCenter = activeRect ? activeRect.left + activeRect.width / 2 : null;

        boxes.forEach(function (entry) {
            entry.classList.toggle("is-hover-active", entry === box);
            entry.classList.remove("preis-lando-hover-under-active");

            if (!box || entry === box || !activeRect) return;

            const entryRect = entry.getBoundingClientRect();
            const entryCenter = entryRect.left + entryRect.width / 2;

            /* Liegt in einer tieferen Menüzeile exakt unter der aktiven Spalte? */
            if (
                entryRect.top > activeRect.top + 2 &&
                Math.abs(entryCenter - activeCenter) < Math.max(3, activeRect.width * 0.15)
            ) {
                entry.classList.add("preis-lando-hover-under-active");
            }
        });
    }

    function updateSharedMenuPointer(topList, box, menu) {
        if (!topList || !box || !menu) return;

        const rootRect = topList.getBoundingClientRect();
        const boxRect = box.getBoundingClientRect();
        const left = Math.max(0, boxRect.left - rootRect.left) + "px";
        const width = boxRect.width + "px";

        menu.style.setProperty("--pl-active-left", left);
        menu.style.setProperty("--pl-active-width", width);

        /* Auch am Root setzen: damit die freie Zelle unter Spalte 1/6
           nur bei Bedarf grau dargestellt wird. */
        topList.style.setProperty("--pl-active-left", left);
        topList.style.setProperty("--pl-active-width", width);
    }

    function getOrCreateSharedMenu(topList) {
        let menu = getSharedMenu(topList);
        if (menu) return menu;

        menu = document.createElement("li");
        menu.className = "preis-lando-hover-menu";
        menu.setAttribute("aria-live", "polite");

        const closeButton = document.createElement("button");
        closeButton.type = "button";
        closeButton.className = "preis-lando-hover-close";
        closeButton.innerHTML =
            "<span>Schließen</span><span class=\"preis-lando-hover-close-x\">×</span>";

        closeButton.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
            closeAllHoverMenus();
        });

        const content = document.createElement("div");
        content.className = "preis-lando-hover-content";

        menu.appendChild(closeButton);
        menu.appendChild(content);

        menu.addEventListener("mouseenter", function () {
            cancelHoverClose();
        });

        menu.addEventListener("mouseleave", function () {
            cancelHoverClose();
            hoverCloseTimer = setTimeout(function () {
                closeActiveHoverMenu();
            }, HOVER_CLOSE_DELAY);
        });

        const originalRoot = topList.querySelector(":scope > .preis-lando-original-root");
        if (originalRoot) topList.insertBefore(menu, originalRoot);
        else topList.appendChild(menu);

        return menu;
    }

    function showLoading(menu) {
        const content = menu.querySelector(".preis-lando-hover-content");
        if (!content) return;

        content.innerHTML = "";
        menu.classList.remove("is-empty");
        menu.classList.add("is-loading", "is-visible");

        const loading = document.createElement("div");
        loading.className = "preis-lando-hover-loading";
        loading.textContent = "Kategorien werden geladen …";
        content.appendChild(loading);
    }

    function createCategoryImageElement(category) {
        const image = document.createElement("img");
        image.className = "preis-lando-hover-image";
        image.alt = getCategoryName(category);
        image.loading = "lazy";

        const directImage = getCategoryImage(category);
        if (directImage) {
            image.src = directImage;
            return image;
        }

        image.classList.add("preis-lando-hover-image-empty");
        image.style.visibility = "hidden";

        loadFallbackCategoryImage(category).then(function (fallbackImage) {
            if (!fallbackImage) return;
            image.src = fallbackImage;
            image.classList.remove("preis-lando-hover-image-empty");
            image.style.visibility = "visible";
        });

        return image;
    }

    function renderChildren(menu, children) {
        const content = menu.querySelector(".preis-lando-hover-content");
        if (!content) return;

        content.innerHTML = "";
        menu.classList.remove("is-loading");

        if (!children || !children.length) {
            menu.classList.add("is-empty");
            menu.classList.remove("is-visible");
            return;
        }

        menu.classList.remove("is-empty");

        children.forEach(function (category) {
            const item = document.createElement("a");
            item.className = "preis-lando-hover-item";
            item.href = getCategoryUrl(category);

            item.appendChild(createCategoryImageElement(category));

            const text = document.createElement("span");
            text.className = "preis-lando-hover-text";
            text.textContent = getCategoryName(category);
            item.appendChild(text);

            content.appendChild(item);
        });

        menu.classList.add("is-visible");
    }

    function prepareCategoryBox(topList, box, category) {
        if (box.dataset.preisLandoHoverReady === "1") return;
        box.dataset.preisLandoHoverReady = "1";

        function openMenu() {
            if (!isHoverMode()) return;

            cancelHoverClose();

            if (activeHoverBox && activeHoverBox !== box) {
                activeHoverBox.classList.remove("is-hover-active");
            }

            activeHoverBox = box;
            setActiveCategory(topList, box);
            topList.classList.add("preis-lando-hover-open");

            const menu = getOrCreateSharedMenu(topList);
            updateSharedMenuPointer(topList, box, menu);
            const categoryId = String(category.id);

            if (menu.dataset.categoryId === categoryId && menu.dataset.loaded === "1") {
                if (!menu.classList.contains("is-empty")) menu.classList.add("is-visible");
                return;
            }

            menu.dataset.categoryId = categoryId;
            menu.dataset.loaded = "0";
            showLoading(menu);

            loadCategoryChildren(category.id).then(function (children) {
                if (activeHoverBox !== box || menu.dataset.categoryId !== categoryId) return;

                menu.dataset.loaded = "1";
                renderChildren(menu, children);
            });
        }

        box.addEventListener("mouseenter", function () {
            if (!isHoverMode()) return;
            cancelHoverOpen();
            cancelHoverClose();
            hoverOpenTimer = setTimeout(function () {
                hoverOpenTimer = null;
                openMenu();
            }, HOVER_OPEN_DELAY);
        });

        box.addEventListener("mouseleave", function (event) {
            if (!isHoverMode()) return;
            cancelHoverOpen();

            const menu = getSharedMenu(topList);
            if (menu && event.relatedTarget && menu.contains(event.relatedTarget)) return;

            cancelHoverClose();
            hoverCloseTimer = setTimeout(function () {
                if (activeHoverBox === box) closeActiveHoverMenu();
            }, HOVER_CLOSE_DELAY);
        });
    }

    function preloadHoverImages(categories) {
        if (!isHoverMode() || !Array.isArray(categories)) return;

        categories.forEach(function (mainCategory) {
            if (!mainCategory || !mainCategory.id) return;

            loadCategoryChildren(mainCategory.id).then(function (children) {
                children.forEach(function (child) {
                    if (!child || !child.id) return;

                    const directImage = getCategoryImage(child);
                    if (directImage) {
                        queueImagePreload(function () { return preloadImage(directImage); });
                        return;
                    }

                    queueImagePreload(function () {
                        return loadFallbackCategoryImage(child)
                            .then(function (url) { return preloadImage(url); });
                    });
                });
            });
        });
    }

    /* =====================================================
       MOBILE DRAWER – DIALOG / TOP LAYER
       Liegt technisch immer vor Header, Banner und Shopinhalt.
       ===================================================== */

    function getMobileDialog() {
        return document.querySelector(".preis-lando-mobile-drawer");
    }

    function setMobileButtonState(open) {
        document.querySelectorAll(".kategorie-mobile-button").forEach(function (button) {
            button.classList.toggle("is-open", !!open);
            button.setAttribute("aria-expanded", open ? "true" : "false");
        });
    }

    function closeMobileDrawer() {
        document.documentElement.classList.remove("preis-lando-mobile-menu-open");
        document.body.classList.remove("preis-lando-mobile-menu-open");

        const dialog = getMobileDialog();
        if (dialog) {
            dialog.classList.remove("is-open");
            dialog.setAttribute("aria-hidden", "true");
        }

        setMobileButtonState(false);
    }

    function openMobileDrawer() {
        if (isHoverMode()) return;

        const dialog = getMobileDialog();
        if (!dialog) return;

        dialog.setAttribute("aria-hidden", "false");
        requestAnimationFrame(function () {
            dialog.classList.add("is-open");
        });

        document.documentElement.classList.add("preis-lando-mobile-menu-open");
        document.body.classList.add("preis-lando-mobile-menu-open");
        setMobileButtonState(true);
    }

    function toggleMobileDrawer() {
        const dialog = getMobileDialog();
        if (!dialog) return;
        if (dialog.classList.contains("is-open")) closeMobileDrawer();
        else openMobileDrawer();
    }

    function buildMobileDrawer(categories) {
        if (!Array.isArray(categories) || !categories.length) return;

        let dialog = getMobileDialog();

        if (!dialog) {
            dialog = document.createElement("div");
            dialog.className = "preis-lando-mobile-drawer";
            dialog.setAttribute("role", "dialog");
            dialog.setAttribute("aria-modal", "true");
            dialog.setAttribute("aria-hidden", "true");
            dialog.setAttribute("aria-label", "Kategorien");

            const panel = document.createElement("div");
            panel.className = "preis-lando-mobile-drawer-panel";

            const head = document.createElement("div");
            head.className = "preis-lando-mobile-drawer-head";

            const title = document.createElement("strong");
            title.textContent = "Kategorien";

            const close = document.createElement("button");
            close.type = "button";
            close.className = "preis-lando-mobile-drawer-close";
            close.setAttribute("aria-label", "Menü schließen");
            close.textContent = "×";
            close.addEventListener("click", closeMobileDrawer);

            head.appendChild(title);
            head.appendChild(close);

            const list = document.createElement("div");
            list.className = "preis-lando-mobile-drawer-list";

            panel.appendChild(head);
            panel.appendChild(list);
            dialog.appendChild(panel);
            document.body.appendChild(dialog);

            dialog.addEventListener("click", function (event) {
                if (event.target === dialog) closeMobileDrawer();
            });
        }

        const list = dialog.querySelector(".preis-lando-mobile-drawer-list");
        if (!list || list.dataset.ready === "1") return;

        categories.forEach(function (category) {
            if (!category || !category.id) return;

            const row = document.createElement("div");
            row.className = "preis-lando-mobile-row";

            const main = document.createElement("div");
            main.className = "preis-lando-mobile-main";

            const link = document.createElement("a");
            link.className = "preis-lando-mobile-main-link";
            link.href = getCategoryUrl(category);
            link.textContent = getCategoryName(category);

            const toggle = document.createElement("button");
            toggle.type = "button";
            toggle.className = "preis-lando-mobile-sub-toggle";
            toggle.setAttribute("aria-label", "Unterkategorien anzeigen");
            toggle.setAttribute("aria-expanded", "false");
            toggle.textContent = "›";

            const sub = document.createElement("div");
            sub.className = "preis-lando-mobile-sub";

            main.appendChild(link);
            main.appendChild(toggle);
            row.appendChild(main);
            row.appendChild(sub);
            list.appendChild(row);

            let loaded = false;
            toggle.addEventListener("click", function () {
                const open = !row.classList.contains("is-open");

                list.querySelectorAll(".preis-lando-mobile-row.is-open").forEach(function (other) {
                    if (other === row) return;
                    other.classList.remove("is-open");
                    const otherToggle = other.querySelector(".preis-lando-mobile-sub-toggle");
                    if (otherToggle) otherToggle.setAttribute("aria-expanded", "false");
                });

                row.classList.toggle("is-open", open);
                toggle.setAttribute("aria-expanded", open ? "true" : "false");

                if (!open || loaded) return;

                sub.innerHTML = '<div class="preis-lando-mobile-sub-loading">wird geladen …</div>';
                loadCategoryChildren(category.id).then(function (children) {
                    sub.innerHTML = "";
                    loaded = true;

                    const allLink = document.createElement("a");
                    allLink.className = "preis-lando-mobile-sub-link preis-lando-mobile-all-link";
                    allLink.href = getCategoryUrl(category);
                    allLink.textContent = "Alle anzeigen";
                    sub.appendChild(allLink);

                    (children || []).forEach(function (child) {
                        const childLink = document.createElement("a");
                        childLink.className = "preis-lando-mobile-sub-link";
                        childLink.href = getCategoryUrl(child);
                        childLink.textContent = getCategoryName(child);
                        sub.appendChild(childLink);
                    });
                });
            });
        });

        list.dataset.ready = "1";
    }

    function ensureMobileMenuButton() {
        let button = document.querySelector(".kategorie-mobile-button");
        const topBar = document.querySelector(".preis-lando-topbar");
        const host = topBar && (
            topBar.querySelector(".top-bar-items") ||
            topBar.querySelector(":scope > .widget-inner") ||
            topBar
        );

        if (!button && host) {
            button = document.createElement("button");
            button.type = "button";
            button.className = "kategorie-mobile-button";
            button.setAttribute("aria-label", "Kategorien öffnen");
            button.setAttribute("aria-expanded", "false");
            button.innerHTML = "<span>Kategorien</span>";
            host.insertBefore(button, host.firstChild);
        }

        if (!button) return null;

        /* Mobil muss der Button in der sichtbaren Top Bar liegen –
           niemals in der ausgeblendeten Kategorienavigation. */
        if (window.innerWidth < 768 && host && button.parentNode !== host) {
            host.insertBefore(button, host.firstChild);
        }

        if (button.dataset.preisLandoDirectDrawer !== "1") {
            button.dataset.preisLandoDirectDrawer = "1";

            /* Capture: verhindert Doppel-Toggle durch ältere CustomJS-Handler. */
            button.addEventListener("click", function (event) {
                if (window.innerWidth >= 768) return;
                event.preventDefault();
                event.stopImmediatePropagation();
                toggleMobileDrawer();
            }, true);
        }

        return button;
    }

    window.addEventListener("preislando:mobile-menu-toggle", toggleMobileDrawer);
    window.addEventListener("preislando:mobile-menu-close", closeMobileDrawer);

    /* =====================================================
       INITIALISIERUNG
       ===================================================== */

    function initializeHoverNavigation() {
        const rootLink = findRootLink();
        if (!rootLink) return;

        loadRootCategories().then(function (categories) {
            const topList = buildPromotedNavigation(rootLink, categories);
            if (!topList) return;

            buildMobileDrawer(categories);
            ensureMobileMenuButton();

            if (!isHoverMode()) {
                closeAllHoverMenus();
                return;
            }

            if (topList.dataset.preisLandoPreloadStarted !== "1") {
                topList.dataset.preisLandoPreloadStarted = "1";
                setTimeout(function () {
                    preloadHoverImages(categories);
                }, 1500);
            }
        });
    }

    function scheduleInitialize() {
        clearTimeout(initializeTimer);
        initializeTimer = setTimeout(initializeHoverNavigation, 80);
    }

    function start() {
        ensureMobileMenuButton();
        initializeHoverNavigation();

        const observer = new MutationObserver(function () {
            scheduleInitialize();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        let resizeTimer = null;
        window.addEventListener("resize", function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                initializeHoverNavigation();
                if (!isHoverMode()) {
                    closeAllHoverMenus();
                } else {
                    closeMobileDrawer();
                }
            }, 100);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
    } else {
        start();
    }

    /* =====================================================
       PREISLANDO SCHNELLSUCHE – PREISE
       ===================================================== */

    (function setupAutocompletePrices() {
        const priceCache = {};
        const pendingPrices = {};

        function getIdsFromAutocompleteUrl(url) {
            if (!url) return null;

            const cleanUrl = String(url)
                .split("?")[0]
                .replace(/\/+$/, "");

            const match = cleanUrl.match(/_(\d+)_(\d+)$/);
            if (!match) return null;

            return {
                itemId: parseInt(match[1], 10),
                variationId: parseInt(match[2], 10)
            };
        }

        function loadVariationPrice(itemId, variationId) {
            const cacheKey = itemId + "_" + variationId;

            if (Object.prototype.hasOwnProperty.call(priceCache, cacheKey)) {
                return Promise.resolve(priceCache[cacheKey]);
            }

            if (pendingPrices[cacheKey]) return pendingPrices[cacheKey];

            const url = "/rest/preislando/search-price/" + encodeURIComponent(variationId);

            pendingPrices[cacheKey] = fetch(url, {
                credentials: "same-origin",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (response) {
                    if (!response.ok) throw new Error("Preis HTTP " + response.status);
                    return response.json();
                })
                .then(function (data) {
                    const price = data && data.success && data.price ? data.price : "";
                    priceCache[cacheKey] = price;
                    return price;
                })
                .catch(function (error) {
                    console.warn(
                        "PreisLando Schnellsuche: Preis konnte nicht geladen werden",
                        itemId,
                        variationId,
                        error
                    );
                    priceCache[cacheKey] = "";
                    return "";
                })
                .finally(function () {
                    delete pendingPrices[cacheKey];
                });

            return pendingPrices[cacheKey];
        }

        function getOrCreatePriceElement(link) {
            let price = link.querySelector(":scope > .preis-lando-search-price");
            if (price) return price;

            price = document.createElement("span");
            price.className = "preis-lando-search-price";
            link.appendChild(price);
            return price;
        }

        function prepareAutocompleteItem(link) {
            if (link.dataset.preisLandoPriceReady === "1") return;

            const ids = getIdsFromAutocompleteUrl(link.getAttribute("href"));
            if (!ids) return;

            link.dataset.preisLandoPriceReady = "1";
            const priceElement = getOrCreatePriceElement(link);
            priceElement.textContent = "";

            loadVariationPrice(ids.itemId, ids.variationId).then(function (price) {
                if (price) priceElement.textContent = price;
            });
        }

        function initializeAutocompletePrices() {
            document.querySelectorAll(
                ".autocomplete-suggestions a.autocomplete-suggestion"
            ).forEach(prepareAutocompleteItem);
        }

        const autocompleteObserver = new MutationObserver(initializeAutocompletePrices);
        autocompleteObserver.observe(document.body, {
            childList: true,
            subtree: true
        });

        initializeAutocompletePrices();
    })();
})();
</script>
