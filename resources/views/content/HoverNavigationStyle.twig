<style>
/* =========================================================
   PREISLANDO MEGA-MENÜ
   DESKTOP
   ========================================================= */

@media (min-width: 1200px) {

    /* =====================================================
       NAVIGATION / BEZUGSPUNKT
       ===================================================== */

    .kategorie-11-spalten {
        position: relative !important;
        overflow: visible !important;
    }

    .kategorie-11-spalten .widget-inner,
    .kategorie-11-spalten .row {
        overflow: visible !important;
    }

    /* Hauptkategorien */
    .kategorie-11-spalten
    .preis-lando-hover-parent {
        position: static !important;
        overflow: visible !important;
    }

    /* Aktive Hauptkategorie über Mega-Menü halten */
    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active {
        z-index: 20002 !important;
    }

    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active
    > a {
        position: relative !important;
        z-index: 20004 !important;
    }


    /* =====================================================
       AKTIVE HAUPTKATEGORIE GRAU
       ===================================================== */

    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active
    > a
    .nav-item {

        position: relative !important;

        background: #f1f1f1 !important;

        border-top: 1px solid #d5d5d5 !important;
        border-left: 1px solid #d5d5d5 !important;
        border-right: 1px solid #d5d5d5 !important;
        border-bottom: 0 !important;

        box-sizing: border-box !important;

        z-index: 20003 !important;
    }

    .kategorie-11-spalten
    .preis-lando-hover-parent.is-hover-active
    > a
    .nav-text {

        background: #f1f1f1 !important;
    }


    /* =====================================================
       MEGA-MENÜ
       ===================================================== */

    .preis-lando-hover-menu {

        display: none;

        position: absolute !important;

        /*
         * FESTE POSITION:
         * Dadurch öffnen obere UND untere Menüzeile
         * auf derselben Höhe.
         */
        top: 30px !important;

        left: 0 !important;

        /*
         * Unsere aktuell getestete Position:
         *
         * -19px = nach links
         *  28px = nach unten
         */
        transform:
            translate(-19px, 28px) !important;

        width: 100% !important;
        min-width: 100% !important;

        margin: 0 !important;

        padding:
            48px
            16px
            16px
            16px !important;

        background: #f1f1f1 !important;

        border: 1px solid #d5d5d5 !important;

        border-radius: 0 !important;

        box-shadow:
            0 5px 15px
            rgba(0, 0, 0, 0.18) !important;

        z-index: 20000 !important;

        box-sizing: border-box !important;
    }


    /* Menü sichtbar */

    .preis-lando-hover-menu.is-visible {
        display: block !important;
    }


    /* Keine Unterkategorien */

    .preis-lando-hover-menu.is-empty {
        display: none !important;
    }


    /* =====================================================
       AUSBUCHTUNG NACH OBEN

       WICHTIG:
       Das gesamte Mega-Menü wird 19px nach links
       verschoben.

       Deshalb bekommt die Ausbuchtung +19px,
       damit sie trotzdem exakt unter der aktiven
       Hauptkategorie sitzt.
       ===================================================== */

    .preis-lando-hover-menu.has-notch::before {

        content: "";

        position: absolute !important;

        left:
            calc(
                var(--pl-notch-left, 0px)
                + 19px
            ) !important;

        top:
            calc(
                -1 *
                var(--pl-notch-height, 30px)
            ) !important;

        width:
            var(
                --pl-notch-width,
                100px
            ) !important;

        height:
            calc(
                var(--pl-notch-height, 30px)
                + 2px
            ) !important;

        /*
         * Gleiche Farbe wie Mega-Menü.
         * Dadurch wird die Kategorie darunter
         * optisch verdeckt.
         */
        background: #f1f1f1 !important;

        border-left:
            1px solid #d5d5d5 !important;

        border-right:
            1px solid #d5d5d5 !important;

        box-sizing: border-box !important;

        z-index: 20001 !important;

        pointer-events: auto !important;
    }


    /* =====================================================
       SCHLIESSEN
       ===================================================== */

    .preis-lando-hover-close {

        position: absolute !important;

        top: 10px !important;
        right: 18px !important;

        display: flex !important;

        align-items: center !important;

        gap: 8px !important;

        margin: 0 !important;

        padding: 4px 0 !important;

        border: 0 !important;

        background: transparent !important;

        color: #666 !important;

        font-family: inherit !important;

        font-size: 13px !important;

        line-height: 20px !important;

        cursor: pointer !important;
    }


    .preis-lando-hover-close:hover {
        color: #222 !important;
    }


    .preis-lando-hover-close-x {

        font-size: 25px !important;

        line-height: 20px !important;

        font-weight: 300 !important;
    }


    /* =====================================================
       INHALT
       3 SPALTEN
       ===================================================== */

    .preis-lando-hover-content {

        display: grid !important;

        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            ) !important;

        column-gap: 4px !important;

        row-gap: 0 !important;

        width: 100% !important;

        margin: 0 !important;

        padding: 0 !important;

        box-sizing: border-box !important;
    }


    /* =====================================================
       UNTERKATEGORIE
       ===================================================== */

    .preis-lando-hover-item {

        display: flex !important;

        width: 100% !important;

        min-width: 0 !important;

        min-height: 50px !important;

        margin: 0 !important;

        padding: 5px 10px !important;

        align-items: center !important;

        background: #fff !important;

        border: 0 !important;

        border-bottom:
            1px solid #ddd !important;

        color: #333 !important;

        text-decoration: none !important;

        box-sizing: border-box !important;

        transition:
            background-color
            0.15s ease !important;
    }


    .preis-lando-hover-item:hover {

        background: #f7f7f7 !important;

        color: #333 !important;

        text-decoration: none !important;
    }


    /* =====================================================
       KATEGORIEBILDER
       ===================================================== */

    .preis-lando-hover-image {

        display: block !important;

        flex:
            0 0 42px !important;

        width: 42px !important;

        height: 42px !important;

        max-width: 42px !important;

        max-height: 42px !important;

        margin-right: 10px !important;

        padding: 0 !important;

        object-fit: contain !important;

        background: #fff !important;
    }


    /*
     * Wenn für eine Kategorie kein Bild geliefert wird,
     * bleibt der Platzhalter transparent.
     */

    .preis-lando-hover-image-empty {

        display: block !important;

        flex:
            0 0 42px !important;

        width: 42px !important;

        height: 42px !important;

        margin-right: 10px !important;

        background: transparent !important;
    }


    /* =====================================================
       KATEGORIETEXT
       ===================================================== */

    .preis-lando-hover-text {

        display: block !important;

        flex:
            1 1 auto !important;

        min-width: 0 !important;

        font-size: 14px !important;

        line-height: 18px !important;

        color: #333 !important;

        white-space: nowrap !important;

        overflow: hidden !important;

        text-overflow: ellipsis !important;
    }


    /* =====================================================
       LADEN
       ===================================================== */

    .preis-lando-hover-loading {

        grid-column:
            1 / -1 !important;

        padding: 20px !important;

        background: #fff !important;
    }
}


/* =========================================================
   MOBIL / TABLET
   Mega-Menü deaktivieren
   ========================================================= */

@media (max-width: 1199.98px) {

    .preis-lando-hover-menu {
        display: none !important;
    }
}

</style>
