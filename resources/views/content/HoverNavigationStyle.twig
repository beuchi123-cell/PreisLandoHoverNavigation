html[data-pl-a11y-motion="reduced"] *::before,
html[data-pl-a11y-motion="reduced"] *::after { animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
body :focus-visible { outline:3px solid #2f8f13 !important; outline-offset:3px !important; }

.pl-a11y { position:fixed !important; right:18px !important; bottom:18px !important; z-index:2147483005 !important; font-family:Arial,Helvetica,sans-serif; font-size:16px; line-height:1.35; }
