<script>
(function () {
    "use strict";

    /* =====================================================
       PreisLando Clean Rebuild 2.0.0.0
       Eine Initialisierung, ein MutationObserver, kein Polling.
       ===================================================== */
    const VERSION = "2.0.0.0";
    const ROOT_CATEGORY_ID = 1838;
    const ROOT_CATEGORY_PATH = "/neuetischkultur-sw5";
    const ROOT_CATEGORY_NAME = "neuetischkultur sw5";
    const BREAKPOINT = 768;
    const ROOT_CACHE_KEY = "preislando.clean.root.v2";
    const ROOT_CACHE_TTL = 30 * 60 * 1000;
    const MAX_CHILDREN = 100;

    window.PreisLandoHoverVersion = VERSION;
    document.documentElement.setAttribute("data-preislando-hover-version", VERSION);

    const state = {
        rootCategories: null,
        rootPromise: null,
        childCache: new Map(),
        childRequests: new Map(),
        imageCache: new Map(),
        imageRequests: new Map(),
        currentTopList: null,
        hoverOpenTimer: null,
        hoverCloseTimer: null,
        activeBox: null,
        refreshTimer: null,
        observer: null,
        mobileImagesLoaded: false,
        priceCache: new Map(),
        priceRequests: new Map(),
        routeHref: window.location.href
    };

    const refreshHooks = [];
    function registerRefresh(fn) {
        if (typeof fn === "function") refreshHooks.push(fn);
    }

    function onReady(fn) {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", fn, { once: true });
        } else {
            fn();
        }
    }

    function normalizePath(url) {
        if (!url) return "";
        try {
            return new URL(url, window.location.origin).pathname
                .replace(/\/+$/g, "")
                .replace(/\/+/g, "/")
                .toLowerCase();
        } catch (error) {
            return String(url).split("?")[0].split("#")[0]
                .replace(/\/+$/g, "")
                .replace(/\/+/g, "/")
                .toLowerCase();
        }
    }

    function getHeaderScope() {
        return document.querySelector("#page-header-parent") ||
            document.querySelector("#page-header") ||
            document.querySelector(".header-container") ||
            document.querySelector("header") ||
            null;
    }

    function getCategoryName(category) {
        if (!category) return "";
        if (category.name) return category.name;
        if (category.details && category.details[0]) return category.details[0].name || "";
        return "";
    }

    function getCategoryUrl(category) {
        if (!category) return "#";
        let url = category.url || category.href || "#";
        if (url === "#") return url;
        url = String(url);
        if (url.charAt(0) !== "/" && !/^https?:\/\//i.test(url)) url = "/" + url;
        if (/^https?:\/\//i.test(url)) return url;

        if (typeof App !== "undefined" && App.urls && App.urls.includeLanguage && App.language) {
            const prefix = "/" + App.language;
            if (url !== prefix && url.indexOf(prefix + "/") !== 0) url = prefix + url;
        }
        return url;
    }

    function getCategoryImage(category) {
        if (!category) return "";
        if (category.image) return category.image;
        if (!category.details || !category.details[0]) return "";
        const details = category.details[0];
        let imagePath = details.image2Path || details.imagePath || "";
        if (!imagePath) return "";
        if (/^https?:\/\//i.test(imagePath)) return imagePath;
        imagePath = imagePath.replace(/^\/+/, "");
        return imagePath.indexOf("documents/") === 0 ? "/" + imagePath : "/documents/" + imagePath;
    }

    function findRootLink() {
        const header = getHeaderScope();
        if (!header) return null;
        const links = Array.from(header.querySelectorAll("a[href]"));
        return links.find(function (link) {
            const path = normalizePath(link.getAttribute("href") || link.href);
            const text = (link.textContent || "").replace(/\s+/g, " ").trim().toLowerCase();
            return path === ROOT_CATEGORY_PATH || path.endsWith(ROOT_CATEGORY_PATH) || text === ROOT_CATEGORY_NAME;
        }) || null;
    }

    function findTopList(rootLink) {
        const li = rootLink && rootLink.closest("li");
        return li && li.parentElement && li.parentElement.tagName === "UL" ? li.parentElement : null;
    }

    function findNavigationHost(rootLink) {
        if (!rootLink) return null;
        const header = getHeaderScope();
        let node = rootLink.closest("nav, .main-navbar-collapsable, .widget-navigation-tree, .widget-navigation");
        if (node && node.parentElement && header && header.contains(node.parentElement)) return node.parentElement;
        if (node) return node;
        const topList = findTopList(rootLink);
        return topList ? (topList.closest("nav") || topList.parentElement) : null;
    }

    function findLogoHost(header) {
        if (!header) return null;
        const existing = header.querySelector(".preis-lando-logo");
        if (existing) return existing;
        const images = Array.from(header.querySelectorAll("img"));
        let best = null;
        let bestScore = -1;
        images.forEach(function (img) {
            const haystack = [img.currentSrc, img.src, img.alt, img.title].join(" ").toLowerCase();
            let score = 0;
            if (haystack.indexOf("preislando") !== -1 || haystack.indexOf("preis-lando") !== -1) score += 100;
            if (haystack.indexOf("logo") !== -1) score += 30;
            if (haystack.indexOf("preis") !== -1 && haystack.indexOf("lando") !== -1) score += 60;
            if (score > bestScore) { bestScore = score; best = img; }
        });
        if (!best || bestScore < 30) return null;
        return best.closest(".widget-image-box") || best.closest("[class*='widget-image']") || best.parentElement;
    }

    function findTopBarHost(header) {
        if (!header) return null;
        const existing = header.querySelector(".preis-lando-topbar");
        if (existing) return existing;
        const items = header.querySelector(".top-bar-items");
        if (items) return items.parentElement || items;
        const search = header.querySelector(".always-visible-search");
        const controls = header.querySelector(".controls");
        if (!search || !controls) return null;
        let a = search;
        const parents = new Set();
        while (a) { parents.add(a); a = a.parentElement; }
        let b = controls;
        while (b) {
            if (parents.has(b) && b !== header) return b;
            b = b.parentElement;
        }
        return null;
    }

    function commonAncestor(a, b) {
        if (!a || !b) return null;
        const parents = new Set();
        while (a) { parents.add(a); a = a.parentElement; }
        while (b) { if (parents.has(b)) return b; b = b.parentElement; }
        return null;
    }

    const originalPositions = new WeakMap();
    function rememberPosition(el) {
        if (!el || !el.parentNode || originalPositions.has(el)) return;
        originalPositions.set(el, { parent: el.parentNode, next: el.nextSibling });
    }
    function restorePosition(el) {
        const saved = el && originalPositions.get(el);
        if (!saved || !saved.parent || !saved.parent.isConnected) return;
        if (saved.next && saved.next.parentNode === saved.parent) saved.parent.insertBefore(el, saved.next);
        else saved.parent.appendChild(el);
    }

    function ensureHeaderClasses() {
        const header = getHeaderScope();
        if (!header) return null;

        const rootLink = findRootLink();
        const navHost = findNavigationHost(rootLink);
        if (navHost) navHost.classList.add("preis-lando-navigation");

        const logo = findLogoHost(header);
        if (logo) logo.classList.add("preis-lando-logo");

        const topbar = findTopBarHost(header);
        if (topbar) topbar.classList.add("preis-lando-topbar");

        if (logo && topbar && !header.querySelector(".header-logo-suche")) {
            const row = commonAncestor(logo, topbar);
            if (row && row !== header && row !== document.body) row.classList.add("header-logo-suche");
        }

        return { header: header, rootLink: rootLink, navHost: navHost, logo: logo, topbar: topbar };
    }

    function ensureMobileButton(topbar) {
        if (!topbar) return null;
        const host = topbar.querySelector(".top-bar-items") || topbar.querySelector(":scope > .widget-inner") || topbar;
        let button = host.querySelector(".kategorie-mobile-button") || document.querySelector(".kategorie-mobile-button");
        if (!button && window.innerWidth >= BREAKPOINT) return null;
        if (!button) {
            button = document.createElement("button");
            button.type = "button";
            button.className = "kategorie-mobile-button";
            button.setAttribute("aria-label", "Kategorien öffnen");
            button.setAttribute("aria-expanded", "false");
            button.innerHTML = "<span>Kategorien</span>";
        }
        if (window.innerWidth < BREAKPOINT && button.parentNode !== host) host.insertBefore(button, host.firstChild);
        return button;
    }

    function syncHeaderLayout(parts) {
        if (!parts || !parts.topbar) return;
        const topbar = parts.topbar;
        const host = topbar.querySelector(".top-bar-items") || topbar.querySelector(":scope > .widget-inner") || topbar;
        const logo = parts.logo;
        const controls = topbar.querySelector(".controls") || parts.header.querySelector(".controls");
        const search = topbar.querySelector(".always-visible-search") || parts.header.querySelector(".always-visible-search");
        const button = ensureMobileButton(topbar);
        const mobile = window.innerWidth < BREAKPOINT;

        if (mobile) {
            topbar.classList.add("preis-lando-mobile-header");
            rememberPosition(logo);
            rememberPosition(search);

            if (button && button.parentNode !== host) host.insertBefore(button, host.firstChild);
            if (logo && logo.parentNode !== host) {
                if (controls && controls.parentNode === host) host.insertBefore(logo, controls);
                else if (button && button.parentNode === host) button.insertAdjacentElement("afterend", logo);
                else host.appendChild(logo);
            }
            if (search && search.parentNode !== host) host.appendChild(search);
            if (search) search.classList.add("preis-lando-mobile-search");

            requestAnimationFrame(function () {
                const searchBox = search ? (search.querySelector(".position-relative") || search) : topbar;
                const bottom = Math.max(0, Math.ceil(searchBox.getBoundingClientRect().bottom));
                if (bottom) document.documentElement.style.setProperty("--pl-mobile-drawer-top", bottom + "px");
            });
        } else {
            topbar.classList.remove("preis-lando-mobile-header");
            if (search) { search.classList.remove("preis-lando-mobile-search"); restorePosition(search); }
            restorePosition(logo);
            closeMobileDrawer();
        }
    }

    function extractDomCategories(rootLink) {
        const rootLi = rootLink && rootLink.closest("li");
        if (!rootLi) return [];
        let list = Array.from(rootLi.children).find(function (el) { return el.tagName === "UL"; });
        if (!list) list = rootLi.querySelector(":scope ul");
        if (!list) return [];

        return Array.from(list.children).filter(function (li) { return li.tagName === "LI"; }).map(function (li) {
            const a = li.querySelector(":scope > a") || li.querySelector("a[href]");
            if (!a) return null;
            const idRaw = li.getAttribute("data-category-id") || a.getAttribute("data-category-id") || li.dataset.categoryId || a.dataset.categoryId || "";
            const id = /^\d+$/.test(String(idRaw)) ? parseInt(idRaw, 10) : null;
            return {
                id: id,
                url: a.getAttribute("href") || a.href || "#",
                details: [{ name: (a.textContent || "").replace(/\s+/g, " ").trim() }]
            };
        }).filter(function (c) { return c && getCategoryName(c); }).slice(0, 20);
    }

    function readRootCache() {
        try {
            const raw = sessionStorage.getItem(ROOT_CACHE_KEY);
            if (!raw) return null;
            const data = JSON.parse(raw);
            if (!data || !Array.isArray(data.categories) || data.categories.length < 3) return null;
            if (!data.savedAt || Date.now() - data.savedAt > ROOT_CACHE_TTL) {
                sessionStorage.removeItem(ROOT_CACHE_KEY);
                return null;
            }
            return data.categories;
        } catch (error) { return null; }
    }

    function writeRootCache(categories) {
        if (!Array.isArray(categories) || categories.length < 3) return;
        try { sessionStorage.setItem(ROOT_CACHE_KEY, JSON.stringify({ savedAt: Date.now(), categories: categories })); }
        catch (error) {}
    }

    function fetchCategoryChildren(categoryId) {
        const url = "/rest/io/categorytree/children?categoryId=" + encodeURIComponent(categoryId) + "&indexStart=0&maxCount=" + MAX_CHILDREN;
        return fetch(url, { credentials: "same-origin", headers: { "X-Requested-With": "XMLHttpRequest" } })
            .then(function (response) { if (!response.ok) throw new Error("HTTP " + response.status); return response.json(); })
            .then(function (data) {
                if (data && Array.isArray(data.data)) return data.data;
                if (Array.isArray(data)) return data;
                return [];
            });
    }

    function loadChildren(categoryId) {
        if (!categoryId) return Promise.resolve([]);
        if (state.childCache.has(categoryId)) return Promise.resolve(state.childCache.get(categoryId));
        if (state.childRequests.has(categoryId)) return state.childRequests.get(categoryId);
        const request = fetchCategoryChildren(categoryId)
            .then(function (items) { const value = Array.isArray(items) ? items : []; state.childCache.set(categoryId, value); return value; })
            .catch(function (error) { console.warn("[PreisLando] Unterkategorien", categoryId, error); return []; })
            .finally(function () { state.childRequests.delete(categoryId); });
        state.childRequests.set(categoryId, request);
        return request;
    }

    function loadOfficialRootCategories() {
        if (state.rootCategories && state.rootCategories.length) return Promise.resolve(state.rootCategories);
        if (state.rootPromise) return state.rootPromise;
        state.rootPromise = fetchCategoryChildren(ROOT_CATEGORY_ID)
            .then(function (categories) {
                if (Array.isArray(categories) && categories.length >= 3) {
                    state.rootCategories = categories;
                    writeRootCache(categories);
                    return categories;
                }
                return [];
            })
            .catch(function (error) { console.warn("[PreisLando] Root-Kategorien", error); return []; })
            .finally(function () { state.rootPromise = null; });
        return state.rootPromise;
    }

    function categoriesSignature(categories) {
        return categories.map(function (c) { return String(c.id || "x") + ":" + getCategoryName(c) + ":" + normalizePath(getCategoryUrl(c)); }).join("|");
    }

    function closeHoverMenu() {
        clearTimeout(state.hoverOpenTimer);
        clearTimeout(state.hoverCloseTimer);
        state.hoverOpenTimer = null;
        state.hoverCloseTimer = null;
        document.querySelectorAll(".preis-lando-hover-menu.is-visible").forEach(function (m) { m.classList.remove("is-visible"); });
        document.querySelectorAll(".preis-lando-nav-category.is-hover-active").forEach(function (b) { b.classList.remove("is-hover-active"); });
        state.activeBox = null;
    }

    function getSharedMenu(topList) {
        return topList ? topList.querySelector(":scope > .preis-lando-hover-menu") : null;
    }

    function getOrCreateSharedMenu(topList) {
        let menu = getSharedMenu(topList);
        if (menu) return menu;
        menu = document.createElement("li");
        menu.className = "preis-lando-hover-menu";
        menu.innerHTML = '<button type="button" class="preis-lando-hover-close" aria-label="Menü schließen"><span class="preis-lando-hover-close-x">×</span> Schließen</button><div class="preis-lando-hover-content"></div>';
        topList.appendChild(menu);
        menu.addEventListener("pointerenter", function () { clearTimeout(state.hoverCloseTimer); });
        menu.addEventListener("pointerleave", function () { state.hoverCloseTimer = setTimeout(closeHoverMenu, 220); });
        menu.querySelector(".preis-lando-hover-close").addEventListener("click", closeHoverMenu);
        return menu;
    }

    function loadFallbackImage(category) {
        if (!category || !category.id) return Promise.resolve("");
        if (state.imageCache.has(category.id)) return Promise.resolve(state.imageCache.get(category.id));
        if (state.imageRequests.has(category.id)) return state.imageRequests.get(category.id);
        const request = fetch("/rest/preislando/category-image/" + encodeURIComponent(category.id), {
            credentials: "same-origin", headers: { "X-Requested-With": "XMLHttpRequest" }
        }).then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
          .then(function (data) { const image = data && data.success && data.image ? data.image : ""; state.imageCache.set(category.id, image); return image; })
          .catch(function () { return ""; })
          .finally(function () { state.imageRequests.delete(category.id); });
        state.imageRequests.set(category.id, request);
        return request;
    }

    function setImageForElement(img, category, wrap) {
        const direct = getCategoryImage(category);
        if (direct) { img.src = direct; return; }
        loadFallbackImage(category).then(function (url) {
            if (url) img.src = url;
            else if (wrap) wrap.classList.add("is-empty");
        });
    }

    function renderHoverChildren(menu, children) {
        const content = menu.querySelector(".preis-lando-hover-content");
        if (!content) return;
        content.innerHTML = "";
        if (!children.length) {
            menu.classList.add("is-empty");
            menu.classList.remove("is-visible");
            return;
        }
        menu.classList.remove("is-empty");
        children.forEach(function (child) {
            const a = document.createElement("a");
            a.className = "preis-lando-hover-item";
            a.href = getCategoryUrl(child);
            const img = document.createElement("img");
            img.className = "preis-lando-hover-image";
            img.loading = "lazy";
            img.alt = "";
            const text = document.createElement("span");
            text.className = "preis-lando-hover-text";
            text.textContent = getCategoryName(child);
            a.appendChild(img);
            a.appendChild(text);
            content.appendChild(a);
            setImageForElement(img, child, null);
        });
    }

    function openHoverFor(box, category, topList) {
        if (window.innerWidth < BREAKPOINT || !category || !category.id) return;
        closeHoverMenu();
        state.activeBox = box;
        box.classList.add("is-hover-active");
        const menu = getOrCreateSharedMenu(topList);
        menu.classList.add("is-visible");
        const content = menu.querySelector(".preis-lando-hover-content");
        content.innerHTML = '<div class="preis-lando-hover-loading">Unterkategorien werden geladen …</div>';
        loadChildren(category.id).then(function (children) {
            if (state.activeBox !== box) return;
            renderHoverChildren(menu, children);
        });
    }

    function bindHoverBox(box, category, topList) {
        if (!category.id) return;
        box.addEventListener("pointerenter", function () {
            if (window.innerWidth < BREAKPOINT) return;
            clearTimeout(state.hoverOpenTimer);
            clearTimeout(state.hoverCloseTimer);
            state.hoverOpenTimer = setTimeout(function () { openHoverFor(box, category, topList); }, 90);
        });
        box.addEventListener("pointerleave", function () {
            clearTimeout(state.hoverOpenTimer);
            state.hoverCloseTimer = setTimeout(closeHoverMenu, 260);
        });
    }

    function renderNavigation(rootLink, categories) {
        const rootLi = rootLink && rootLink.closest("li");
        const topList = findTopList(rootLink);
        if (!rootLi || !topList || !categories || !categories.length) return null;

        const signature = categoriesSignature(categories);
        topList.classList.add("preis-lando-navigation-root");
        rootLi.classList.add("preis-lando-original-root");
        if (topList.dataset.plCleanSignature === signature && topList.querySelector(".preis-lando-nav-category")) return topList;

        topList.querySelectorAll(":scope > .preis-lando-nav-category, :scope > .preis-lando-hover-menu").forEach(function (el) { el.remove(); });
        delete topList.dataset.plCleanSignature;
        state.activeBox = null;

        categories.slice(0, 10).forEach(function (category, index) {
            const box = document.createElement("li");
            box.className = "preis-lando-nav-category" + (category.id ? " preis-lando-hover-parent" : "");
            box.setAttribute("data-pl-index", String(index + 1));
            if (category.id) box.dataset.categoryId = String(category.id);
            const a = document.createElement("a");
            a.className = "preis-lando-nav-link";
            a.href = getCategoryUrl(category);
            a.textContent = getCategoryName(category);
            box.appendChild(a);
            topList.insertBefore(box, rootLi);
            bindHoverBox(box, category, topList);
        });
        topList.dataset.plCleanSignature = signature;
        state.currentTopList = topList;
        return topList;
    }

    function getMobileDrawer() { return document.querySelector(".preis-lando-mobile-drawer"); }

    function buildMobileDrawer(categories) {
        if (!categories || !categories.length || !document.body) return;
        let drawer = getMobileDrawer();
        if (!drawer) {
            drawer = document.createElement("div");
            drawer.className = "preis-lando-mobile-drawer";
            drawer.setAttribute("role", "dialog");
            drawer.setAttribute("aria-modal", "true");
            drawer.setAttribute("aria-hidden", "true");
            drawer.innerHTML = '<div class="preis-lando-mobile-drawer-panel"><div class="preis-lando-mobile-drawer-list"></div></div>';
            document.body.appendChild(drawer);
        }
        const list = drawer.querySelector(".preis-lando-mobile-drawer-list");
        const signature = categoriesSignature(categories);
        if (list.dataset.plSignature === signature && list.children.length) return;
        list.innerHTML = "";
        categories.slice(0, 10).forEach(function (category) {
            const a = document.createElement("a");
            a.className = "preis-lando-mobile-tile";
            a.href = getCategoryUrl(category);
            const name = document.createElement("span");
            name.className = "preis-lando-mobile-tile-name";
            name.textContent = getCategoryName(category);
            const wrap = document.createElement("span");
            wrap.className = "preis-lando-mobile-tile-image-wrap";
            const img = document.createElement("img");
            img.className = "preis-lando-mobile-tile-image";
            img.loading = "lazy";
            img.alt = "";
            wrap.appendChild(img);
            a.appendChild(name);
            a.appendChild(wrap);
            list.appendChild(a);
            const direct = getCategoryImage(category);
            if (direct) img.src = direct;
            else {
                a.dataset.plCategoryId = category.id ? String(category.id) : "";
                a._plCategory = category;
            }
        });
        list.dataset.plSignature = signature;
        state.mobileImagesLoaded = false;
    }

    function loadMobileDrawerImages() {
        if (state.mobileImagesLoaded) return;
        const drawer = getMobileDrawer();
        if (!drawer) return;
        state.mobileImagesLoaded = true;
        drawer.querySelectorAll(".preis-lando-mobile-tile").forEach(function (a) {
            const category = a._plCategory;
            const img = a.querySelector(".preis-lando-mobile-tile-image");
            const wrap = a.querySelector(".preis-lando-mobile-tile-image-wrap");
            if (category && img && !img.src) setImageForElement(img, category, wrap);
        });
    }

    function setMobileButtonState(open) {
        document.querySelectorAll(".kategorie-mobile-button").forEach(function (button) {
            button.classList.toggle("is-open", !!open);
            button.setAttribute("aria-expanded", open ? "true" : "false");
        });
    }

    function openMobileDrawer() {
        if (window.innerWidth >= BREAKPOINT) return;
        const drawer = getMobileDrawer();
        if (!drawer) return;
        loadMobileDrawerImages();
        drawer.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        document.documentElement.classList.add("preis-lando-mobile-menu-open");
        document.body.classList.add("preis-lando-mobile-menu-open");
        setMobileButtonState(true);
    }

    function closeMobileDrawer() {
        const drawer = getMobileDrawer();
        if (drawer) { drawer.classList.remove("is-open"); drawer.setAttribute("aria-hidden", "true"); }
        document.documentElement.classList.remove("preis-lando-mobile-menu-open");
        if (document.body) document.body.classList.remove("preis-lando-mobile-menu-open");
        setMobileButtonState(false);
    }

    function initNavigation(parts) {
        const rootLink = parts && parts.rootLink ? parts.rootLink : findRootLink();
        if (!rootLink) return;

        let immediate = state.rootCategories && state.rootCategories.length ? state.rootCategories : readRootCache();
        if (!immediate || immediate.length < 3) immediate = extractDomCategories(rootLink);
        if (immediate && immediate.length >= 3) {
            if (!state.rootCategories && immediate.some(function (c) { return c.id; })) state.rootCategories = immediate;
            renderNavigation(rootLink, immediate);
            buildMobileDrawer(immediate);
        }

        loadOfficialRootCategories().then(function (official) {
            if (!official || official.length < 3) return;
            const currentRoot = findRootLink();
            if (!currentRoot) return;
            renderNavigation(currentRoot, official);
            buildMobileDrawer(official);
        });
    }

    function getIdsFromAutocompleteUrl(url) {
        if (!url) return null;
        const match = String(url).split("?")[0].replace(/\/+$/, "").match(/_(\d+)_(\d+)$/);
        return match ? { itemId: parseInt(match[1], 10), variationId: parseInt(match[2], 10) } : null;
    }

    function loadVariationPrice(ids) {
        const key = ids.itemId + "_" + ids.variationId;
        if (state.priceCache.has(key)) return Promise.resolve(state.priceCache.get(key));
        if (state.priceRequests.has(key)) return state.priceRequests.get(key);
        const request = fetch("/rest/preislando/search-price/" + encodeURIComponent(ids.variationId), {
            credentials: "same-origin", headers: { "X-Requested-With": "XMLHttpRequest" }
        }).then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
          .then(function (data) { const p = data && data.success && data.price ? data.price : ""; state.priceCache.set(key, p); return p; })
          .catch(function () { return ""; })
          .finally(function () { state.priceRequests.delete(key); });
        state.priceRequests.set(key, request);
        return request;
    }

