<script>
(function () {

    "use strict";

    const DESKTOP_BREAKPOINT = 1200;
    const MAX_CATEGORIES = 100;

    /*
     * Cache:
     *
     * rootCategories:
     * Hauptkategorien des Step-by-Step-Widgets
     *
     * childCache:
     * Unterkategorien je Hauptkategorie
     */
    let rootCategories = null;
    let rootCategoriesPromise = null;

    const childCache = {};
    const childPromises = {};


    /* =====================================================
       HILFSFUNKTIONEN
       ===================================================== */

    function isDesktop()
    {
        return window.innerWidth >= DESKTOP_BREAKPOINT;
    }


    function normalizePath(url)
    {
        if (!url)
        {
            return "";
        }

        try
        {
            const parsedUrl = new URL(url, window.location.origin);

            return parsedUrl.pathname
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
        catch (error)
        {
            return String(url)
                .split("?")[0]
                .split("#")[0]
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
    }


    function getCategoryName(category)
    {
        if (
            category &&
            category.details &&
            category.details.length &&
            category.details[0] &&
            category.details[0].name
        )
        {
            return category.details[0].name;
        }

        return "";
    }


    function getCategoryUrl(category)
    {
        if (!category || !category.url)
        {
            return "#";
        }

        let url = category.url;

        if (url.charAt(0) !== "/")
        {
            url = "/" + url;
        }

        /*
         * Sprachpräfix berücksichtigen,
         * genauso wie plentyShop es macht.
         */
        if (
            typeof App !== "undefined" &&
            App.urls &&
            App.urls.includeLanguage &&
            App.language
        )
        {
            const languagePrefix = "/" + App.language;

            if (url.indexOf(languagePrefix + "/") !== 0)
            {
                url = languagePrefix + url;
            }
        }

        return url;
    }


    function getImageSource()
    {
        const component = document.querySelector(
            ".kategorie-11-spalten step-by-step-navigation"
        );

        if (!component)
        {
            return "image2Path";
        }

        return (
            component.getAttribute("image-source") ||
            "image2Path"
        );
    }


    function getCategoryImage(category)
    {
        if (
            !category ||
            !category.details ||
            !category.details.length ||
            !category.details[0]
        )
        {
            return "";
        }

        const details = category.details[0];
        const imageSource = getImageSource();

        /*
         * Zuerst die im ShopBuilder gewählte Bildquelle.
         */
        let imagePath = details[imageSource];

        /*
         * Falls dort nichts hinterlegt ist:
         * Bild 2, danach Bild 1 als Fallback.
         */
        if (!imagePath)
        {
            imagePath =
                details.image2Path ||
                details.imagePath ||
                "";
        }

        if (!imagePath)
        {
            return "";
        }

        /*
         * Absolute URLs unverändert übernehmen.
         */
        if (
            imagePath.indexOf("http://") === 0 ||
            imagePath.indexOf("https://") === 0
        )
        {
            return imagePath;
        }

        /*
         * Plenty-Kategoriebilder liegen unter /documents/.
         */
        imagePath = imagePath.replace(/^\/+/, "");

        if (imagePath.indexOf("documents/") === 0)
        {
            return "/" + imagePath;
        }

        return "/documents/" + imagePath;
    }


    /* =====================================================
       KATEGORIE-ID DES STEP-BY-STEP-WIDGETS ERMITTELN
       ===================================================== */

    function getRootCategoryId()
    {
        const component = document.querySelector(
            ".kategorie-11-spalten step-by-step-navigation"
        );

        if (!component)
        {
            return null;
        }

        /*
         * Je nach Vue-/Renderzustand kann Plenty
         * category-id oder :category-id ausgeben.
         */
        const possibleValues = [
            component.getAttribute("category-id"),
            component.getAttribute(":category-id"),
            component.getAttribute("v-bind:category-id")
        ];

        for (const value of possibleValues)
        {
            if (!value)
            {
                continue;
            }

            /*
             * Nur die Zahl auslesen.
             * Funktioniert z.B. bei:
             *
             * 123
             * "123"
             */
            const match = String(value).match(/\d+/);

            if (match)
            {
                return parseInt(match[0], 10);
            }
        }

        return null;
    }


    /* =====================================================
       API
       ===================================================== */

    function fetchCategoryChildren(categoryId)
    {
        const url =
            "/rest/io/categorytree/children" +
            "?categoryId=" + encodeURIComponent(categoryId) +
            "&indexStart=0" +
            "&maxCount=" + MAX_CATEGORIES;

        return fetch(
            url,
            {
                credentials: "same-origin",
                headers:
                {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }
        )
            .then(function (response)
            {
                if (!response.ok)
                {
                    throw new Error(
                        "HTTP " + response.status
                    );
                }

                return response.json();
            });
    }


    /* =====================================================
       HAUPTKATEGORIEN LADEN
       ===================================================== */

    function loadRootCategories()
    {
        if (rootCategories)
        {
            return Promise.resolve(rootCategories);
        }

        if (rootCategoriesPromise)
        {
            return rootCategoriesPromise;
        }

        const rootCategoryId = getRootCategoryId();

        if (!rootCategoryId)
        {
            return Promise.reject(
                new Error(
                    "Kategorie-ID des Step-by-Step-Widgets wurde nicht gefunden."
                )
            );
        }

        rootCategoriesPromise =
            fetchCategoryChildren(rootCategoryId)
                .then(function (categories)
                {
                    rootCategories =
                        Array.isArray(categories)
                            ? categories
                            : [];

                    return rootCategories;
                })
                .finally(function ()
                {
                    rootCategoriesPromise = null;
                });

        return rootCategoriesPromise;
    }


    /* =====================================================
       ID EINER SICHTBAREN HAUPTKATEGORIE FINDEN
       ===================================================== */

    function findCategoryForLink(link)
    {
        return loadRootCategories()
            .then(function (categories)
            {
                const linkPath =
                    normalizePath(link.href);

                for (const category of categories)
                {
                    const categoryPath =
                        normalizePath(
                            getCategoryUrl(category)
                        );

                    if (
                        categoryPath &&
                        categoryPath === linkPath
                    )
                    {
                        return category;
                    }
                }

                /*
                 * Zweiter Versuch:
                 * nur anhand der ursprünglichen category.url.
                 */
                for (const category of categories)
                {
                    const categoryPath =
                        normalizePath(category.url);

                    if (
                        categoryPath &&
                        linkPath.endsWith(categoryPath)
                    )
                    {
                        return category;
                    }
                }

                return null;
            });
    }


    /* =====================================================
       UNTERKATEGORIEN LADEN + CACHEN
       ===================================================== */

    function loadHoverChildren(categoryId)
    {
        if (
            Object.prototype.hasOwnProperty.call(
                childCache,
                categoryId
            )
        )
        {
            return Promise.resolve(
                childCache[categoryId]
            );
        }

        if (childPromises[categoryId])
        {
            return childPromises[categoryId];
        }

        childPromises[categoryId] =
            fetchCategoryChildren(categoryId)
                .then(function (children)
                {
                    childCache[categoryId] =
                        Array.isArray(children)
                            ? children
                            : [];

                    return childCache[categoryId];
                })
                .catch(function (error)
                {
                    console.error(
                        "PreisLando HoverNavigation:",
                        "Unterkategorien konnten nicht geladen werden.",
                        error
                    );

                    return [];
                })
                .finally(function ()
                {
                    delete childPromises[categoryId];
                });

        return childPromises[categoryId];
    }


    /* =====================================================
       DROPDOWN ERZEUGEN
       ===================================================== */

    function getOrCreateMenu(box)
    {
        let menu = box.querySelector(
            ":scope > .preis-lando-hover-menu"
        );

        if (menu)
        {
            return menu;
        }

        menu = document.createElement("div");
        menu.className =
            "preis-lando-hover-menu";

        box.appendChild(menu);

        return menu;
    }


    function showLoading(menu)
    {
        menu.innerHTML = "";

        menu.classList.remove("is-empty");
        menu.classList.add("is-loading");
        menu.classList.add("is-visible");

        const loading = document.createElement("div");

        loading.className =
            "preis-lando-hover-loading";

        loading.textContent =
            "Kategorien werden geladen …";

        menu.appendChild(loading);
    }


    function renderChildren(menu, children)
    {
        menu.innerHTML = "";

        menu.classList.remove("is-loading");

        if (!children || !children.length)
        {
            menu.classList.add("is-empty");
            menu.classList.remove("is-visible");

            return;
        }

        menu.classList.remove("is-empty");


        children.forEach(function (category)
        {
            const link =
                document.createElement("a");

            link.className =
                "preis-lando-hover-item";

            link.href =
                getCategoryUrl(category);


            /* ---------------------------------------------
               BILD
               --------------------------------------------- */

            const imageUrl =
                getCategoryImage(category);

            if (imageUrl)
            {
                const image =
                    document.createElement("img");

                image.className =
                    "preis-lando-hover-image";

                image.src = imageUrl;

                image.alt =
                    getCategoryName(category);

                image.loading = "lazy";

                link.appendChild(image);
            }
            else
            {
                /*
                 * Platzhalter, damit Kategorien ohne Bild
                 * trotzdem sauber ausgerichtet bleiben.
                 */
                const imagePlaceholder =
                    document.createElement("span");

                imagePlaceholder.className =
                    "preis-lando-hover-image " +
                    "preis-lando-hover-image-empty";

                link.appendChild(
                    imagePlaceholder
                );
            }


            /* ---------------------------------------------
               NAME
               --------------------------------------------- */

            const text =
                document.createElement("span");

            text.className =
                "preis-lando-hover-text";

            text.textContent =
                getCategoryName(category);

            link.appendChild(text);


            menu.appendChild(link);
        });


        menu.classList.add("is-visible");
    }


    /* =====================================================
       HOVER AN EINE KATEGORIE HÄNGEN
       ===================================================== */

    function prepareCategoryBox(box)
    {
        if (
            box.dataset.preisLandoHoverReady === "1"
        )
        {
            return;
        }

        const mainLink =
            box.querySelector(":scope > a");

        if (!mainLink)
        {
            return;
        }

        box.dataset.preisLandoHoverReady = "1";

        box.classList.add(
            "preis-lando-hover-parent"
        );


        box.addEventListener(
            "mouseenter",
            function ()
            {
                if (!isDesktop())
                {
                    return;
                }

                const menu =
                    getOrCreateMenu(box);

                /*
                 * Bereits geladen:
                 * sofort wieder anzeigen.
                 */
                if (
                    menu.dataset.loaded === "1"
                )
                {
                    if (
                        !menu.classList.contains(
                            "is-empty"
                        )
                    )
                    {
                        menu.classList.add(
                            "is-visible"
                        );
                    }

                    return;
                }


                showLoading(menu);


                findCategoryForLink(mainLink)
                    .then(function (category)
                    {
                        /*
                         * Die URL konnte keiner Kategorie
                         * zugeordnet werden.
                         */
                        if (
                            !category ||
                            !category.id
                        )
                        {
                            menu.classList.remove(
                                "is-visible"
                            );

                            return [];
                        }

                        return loadHoverChildren(
                            category.id
                        );
                    })
                    .then(function (children)
                    {
                        menu.dataset.loaded = "1";

                        renderChildren(
                            menu,
                            children
                        );
                    })
                    .catch(function (error)
                    {
                        menu.classList.remove(
                            "is-visible"
                        );

                        console.error(
                            "PreisLando HoverNavigation:",
                            error
                        );
                    });
            }
        );


        box.addEventListener(
            "mouseleave",
            function ()
            {
                const menu =
                    box.querySelector(
                        ":scope > .preis-lando-hover-menu"
                    );

                if (menu)
                {
                    menu.classList.remove(
                        "is-visible"
                    );
                }
            }
        );
    }


    /* =====================================================
       NAVIGATION INITIALISIEREN
       ===================================================== */

    function initializeHoverNavigation()
    {
        if (!isDesktop())
        {
            return;
        }

        const widget =
            document.querySelector(
                ".kategorie-11-spalten"
            );

        if (!widget)
        {
            return;
        }

        const boxes =
            widget.querySelectorAll(
                ".row > div"
            );

        boxes.forEach(
            prepareCategoryBox
        );
    }


    /* =====================================================
       MOBIL: HOVER-MENÜS AUSBLENDEN
       ===================================================== */

    function closeAllHoverMenus()
    {
        document
            .querySelectorAll(
                ".preis-lando-hover-menu"
            )
            .forEach(function (menu)
            {
                menu.classList.remove(
                    "is-visible"
                );
            });
    }


    /* =====================================================
       START
       ===================================================== */

    function start()
    {
        initializeHoverNavigation();


        /*
         * Step-by-Step-Navigation wird von Vue nachgeladen.
         * Deshalb beobachten wir DOM-Änderungen.
         */
        const observer =
            new MutationObserver(
                function ()
                {
                    if (isDesktop())
                    {
                        initializeHoverNavigation();
                    }
                }
            );

        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );


        /*
         * Wechsel Desktop <-> Mobil.
         */
        let resizeTimer = null;

        window.addEventListener(
            "resize",
            function ()
            {
                clearTimeout(resizeTimer);

                resizeTimer =
                    setTimeout(
                        function ()
                        {
                            if (isDesktop())
                            {
                                initializeHoverNavigation();
                            }
                            else
                            {
                                closeAllHoverMenus();
                            }
                        },
                        100
                    );
            }
        );
    }


    /*
     * DOMContentLoaded kann schon vorbei sein,
     * wenn Plenty unser Template spät einbindet.
     */
    if (
        document.readyState === "loading"
    )
    {
        document.addEventListener(
            "DOMContentLoaded",
            start
        );
    }
    else
    {
        start();
    }

})();
</script>
