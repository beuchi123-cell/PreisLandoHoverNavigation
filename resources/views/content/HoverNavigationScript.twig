<script>
(function ()
{
    "use strict";

    /* =====================================================
       GRUNDEINSTELLUNGEN
       ===================================================== */

    const DESKTOP_BREAKPOINT = 1200;
    const MAX_CHILDREN = 100;

    const HOVER_OPEN_DELAY = 120;
    const HOVER_CLOSE_DELAY = 350;

    window.PreisLandoHoverVersion = "1.1.7";

    let hoverCloseTimer = null;
    let hoverOpenTimer = null;
    let activeHoverBox = null;


    /* =====================================================
       CACHES
       ===================================================== */

    const childCache = {};
    const childRequests = {};

    const categoryImageCache = {};
    const categoryImageRequests = {};


    /* =====================================================
       ALLGEMEINE HILFSFUNKTIONEN
       ===================================================== */

    function isDesktop()
    {
        return window.innerWidth >= DESKTOP_BREAKPOINT;
    }


    function normalizePath(url)
    {
        if (!url)
        {
            return "";
        }

        try
        {
            const parsed =
                new URL(
                    url,
                    window.location.origin
                );

            return parsed.pathname
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
        catch (error)
        {
            return String(url)
                .split("?")[0]
                .split("#")[0]
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
    }


    function getCategoryName(category)
    {
        if (
            category &&
            category.details &&
            category.details[0] &&
            category.details[0].name
        )
        {
            return category.details[0].name;
        }

        return "";
    }


    function getCategoryUrl(category)
    {
        if (
            !category ||
            !category.url
        )
        {
            return "#";
        }

        let url = category.url;

        if (
            url.charAt(0) !== "/"
        )
        {
            url =
                "/" + url;
        }

        if (
            typeof App !== "undefined" &&
            App.urls &&
            App.urls.includeLanguage &&
            App.language
        )
        {
            const languagePrefix =
                "/" + App.language;

            if (
                url !== languagePrefix &&
                url.indexOf(
                    languagePrefix + "/"
                ) !== 0
            )
            {
                url =
                    languagePrefix + url;
            }
        }

        return url;
    }


    /* =====================================================
       DIREKTES KATEGORIEBILD
       ===================================================== */

    function getCategoryImage(category)
    {
        if (
            !category ||
            !category.details ||
            !category.details[0]
        )
        {
            return "";
        }

        const details =
            category.details[0];

        let imagePath =
            details.image2Path ||
            details.imagePath ||
            "";

        if (!imagePath)
        {
            return "";
        }

        if (
            imagePath.indexOf(
                "https://"
            ) === 0 ||
            imagePath.indexOf(
                "http://"
            ) === 0
        )
        {
            return imagePath;
        }

        imagePath =
            imagePath.replace(
                /^\/+/,
                ""
            );

        if (
            imagePath.indexOf(
                "documents/"
            ) === 0
        )
        {
            return "/" + imagePath;
        }

        return "/documents/" +
            imagePath;
    }


    /* =====================================================
       FALLBACK:
       ARTIKELBILD ÜBER EIGENEN PLUGIN-ENDPOINT
       ===================================================== */

    function loadFallbackCategoryImage(
        category
    )
    {
        if (
            !category ||
            !category.id
        )
        {
            return Promise.resolve(
                ""
            );
        }

        const categoryId =
            category.id;


        /* Bereits im Cache */
        if (
            Object.prototype
                .hasOwnProperty.call(
                    categoryImageCache,
                    categoryId
                )
        )
        {
            return Promise.resolve(
                categoryImageCache[
                    categoryId
                ]
            );
        }


        /* Request läuft bereits */
        if (
            categoryImageRequests[
                categoryId
            ]
        )
        {
            return categoryImageRequests[
                categoryId
            ];
        }


        const url =
            "/rest/preislando/category-image/" +
            encodeURIComponent(
                categoryId
            );


        categoryImageRequests[
            categoryId
        ] =
            fetch(
                url,
                {
                    credentials:
                        "same-origin",

                    headers:
                    {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                }
            )
                .then(
                    function (response)
                    {
                        if (!response.ok)
                        {
                            throw new Error(
                                "Kategorie-Bild HTTP " +
                                response.status
                            );
                        }

                        return response.json();
                    }
                )
                .then(
                    function (data)
                    {
                        const image =
                            data &&
                            data.success &&
                            data.image
                                ? data.image
                                : "";

                        categoryImageCache[
                            categoryId
                        ] =
                            image;

                        return image;
                    }
                )
                .catch(
                    function (error)
                    {
                        console.warn(
                            "PreisLando HoverNavigation:",
                            "Kategorie-Bild konnte nicht geladen werden",
                            categoryId,
                            error
                        );

                        categoryImageCache[
                            categoryId
                        ] =
                            "";

                        return "";
                    }
                )
                .finally(
                    function ()
                    {
                        delete categoryImageRequests[
                            categoryId
                        ];
                    }
                );


        return categoryImageRequests[
            categoryId
        ];
    }


    /* =====================================================
       VUEX NAVIGATION STORE FINDEN
       ===================================================== */

    function findNavigationStore(widget)
    {
        if (
            widget.__vue__ &&
            widget.__vue__.$store &&
            widget.__vue__.$store.state &&
            widget.__vue__.$store.state.navigation
        )
        {
            return widget.__vue__.$store;
        }

        const elements =
            widget.querySelectorAll(
                "*"
            );

        for (const element of elements)
        {
            if (
                element.__vue__ &&
                element.__vue__.$store &&
                element.__vue__.$store.state &&
                element.__vue__.$store.state.navigation
            )
            {
                return element.__vue__.$store;
            }
        }

        return null;
    }


    function getLoadedMainCategories(widget)
    {
        const store =
            findNavigationStore(
                widget
            );

        if (
            store &&
            store.state &&
            store.state.navigation &&
            Array.isArray(
                store.state.navigation.categoryChildren
            )
        )
        {
            return store
                .state
                .navigation
                .categoryChildren;
        }

        return [];
    }


    /* =====================================================
       SICHTBAREN LINK EINER KATEGORIE ZUORDNEN
       ===================================================== */

    function findCategoryForLink(
        widget,
        link
    )
    {
        const categories =
            getLoadedMainCategories(
                widget
            );

        if (!categories.length)
        {
            return null;
        }

        const visiblePath =
            normalizePath(
                link.href
            );


        /* 1. Exakter URL-Vergleich */
        for (const category of categories)
        {
            const categoryPath =
                normalizePath(
                    getCategoryUrl(
                        category
                    )
                );

            if (
                categoryPath &&
                categoryPath === visiblePath
            )
            {
                return category;
            }
        }


        /* 2. URL ohne Sprachpräfix */
        for (const category of categories)
        {
            const categoryPath =
                normalizePath(
                    category.url
                );

            if (
                categoryPath &&
                visiblePath.endsWith(
                    categoryPath
                )
            )
            {
                return category;
            }
        }


        /* 3. Fallback über Kategoriename */
        const visibleName =
            (
                link.textContent ||
                ""
            )
                .trim()
                .toLowerCase();

        for (const category of categories)
        {
            const categoryName =
                getCategoryName(
                    category
                )
                    .trim()
                    .toLowerCase();

            if (
                categoryName &&
                categoryName === visibleName
            )
            {
                return category;
            }
        }

        return null;
    }


    /* =====================================================
       UNTERKATEGORIEN LADEN
       ===================================================== */

    function fetchCategoryChildren(
        categoryId
    )
    {
        const url =
            "/rest/io/categorytree/children" +
            "?categoryId=" +
            encodeURIComponent(
                categoryId
            ) +
            "&indexStart=0" +
            "&maxCount=" +
            MAX_CHILDREN;

        return fetch(
            url,
            {
                credentials:
                    "same-origin",

                headers:
                {
                    "X-Requested-With":
                        "XMLHttpRequest"
                }
            }
        )
            .then(
                function (response)
                {
                    if (!response.ok)
                    {
                        throw new Error(
                            "HTTP " +
                            response.status
                        );
                    }

                    return response.json();
                }
            )
            .then(
                function (response)
                {
                    if (
                        response &&
                        Array.isArray(
                            response.data
                        )
                    )
                    {
                        return response.data;
                    }

                    if (
                        Array.isArray(
                            response
                        )
                    )
                    {
                        return response;
                    }

                    return [];
                }
            );
    }


    function loadCategoryChildren(
        categoryId
    )
    {
        if (
            Object.prototype
                .hasOwnProperty.call(
                    childCache,
                    categoryId
                )
        )
        {
            return Promise.resolve(
                childCache[
                    categoryId
                ]
            );
        }

        if (
            childRequests[
                categoryId
            ]
        )
        {
            return childRequests[
                categoryId
            ];
        }

        childRequests[
            categoryId
        ] =
            fetchCategoryChildren(
                categoryId
            )
                .then(
                    function (children)
                    {
                        childCache[
                            categoryId
                        ] =
                            Array.isArray(
                                children
                            )
                                ? children
                                : [];

                        return childCache[
                            categoryId
                        ];
                    }
                )
                .catch(
                    function (error)
                    {
                        console.error(
                            "PreisLando HoverNavigation:",
                            "Unterkategorien konnten nicht geladen werden.",
                            error
                        );

                        return [];
                    }
                )
                .finally(
                    function ()
                    {
                        delete childRequests[
                            categoryId
                        ];
                    }
                );

        return childRequests[
            categoryId
        ];
    }


    /* =====================================================
       HOVER TIMER
       ===================================================== */

    function cancelHoverClose()
    {
        if (hoverCloseTimer)
        {
            clearTimeout(
                hoverCloseTimer
            );

            hoverCloseTimer =
                null;
        }
    }


    function cancelHoverOpen()
    {
        if (hoverOpenTimer)
        {
            clearTimeout(
                hoverOpenTimer
            );

            hoverOpenTimer =
                null;
        }
    }


    /* =====================================================
       AKTIVE KATEGORIE
       ===================================================== */

    function clearActiveCategory()
    {
        document
            .querySelectorAll(
                ".preis-lando-hover-parent"
            )
            .forEach(
                function (entry)
                {
                    entry.classList.remove(
                        "is-hover-active"
                    );
                }
            );
    }


    function setActiveCategory(
        widget,
        box
    )
    {
        widget
            .querySelectorAll(
                ".preis-lando-hover-parent"
            )
            .forEach(
                function (entry)
                {
                    entry.classList.remove(
                        "is-hover-active"
                    );
                }
            );

        box.classList.add(
            "is-hover-active"
        );
    }


    /* =====================================================
       MENÜS SCHLIESSEN
       ===================================================== */

    function closeAllHoverMenus()
    {
        cancelHoverClose();
        cancelHoverOpen();

        document
            .querySelectorAll(
                ".preis-lando-hover-menu"
            )
            .forEach(
                function (menu)
                {
                    menu.classList.remove(
                        "is-visible"
                    );

                    menu.classList.remove(
                        "has-notch"
                    );
                }
            );

        clearActiveCategory();

        activeHoverBox =
            null;
    }


    function closeActiveHoverMenu()
    {
        cancelHoverClose();

        if (!activeHoverBox)
        {
            return;
        }

        const menu =
            activeHoverBox
                .querySelector(
                    ":scope > " +
                    ".preis-lando-hover-menu"
                );

        if (menu)
        {
            menu.classList.remove(
                "is-visible"
            );

            menu.classList.remove(
                "has-notch"
            );
        }

        activeHoverBox
            .classList
            .remove(
                "is-hover-active"
            );

        activeHoverBox =
            null;
    }


    /* =====================================================
       MEGA-MENÜ POSITION / AUSBUCHTUNG
       ===================================================== */

    function positionMegaMenu(
        widget,
        box,
        menu
    )
    {
        const widgetRect =
            widget.getBoundingClientRect();

        const boxRect =
            box.getBoundingClientRect();

        const boxes =
            Array.from(
                widget.querySelectorAll(
                    ".row > div"
                )
            )
                .filter(
                    function (entry)
                    {
                        return !!entry.querySelector(
                            ":scope > a"
                        );
                    }
                );

        if (!boxes.length)
        {
            return;
        }

        const rowTops =
            [];

        boxes.forEach(
            function (entry)
            {
                const top =
                    Math.round(
                        entry
                            .getBoundingClientRect()
                            .top
                    );

                if (
                    !rowTops.includes(
                        top
                    )
                )
                {
                    rowTops.push(
                        top
                    );
                }
            }
        );

        rowTops.sort(
            function (a, b)
            {
                return a - b;
            }
        );

        const currentTop =
            Math.round(
                boxRect.top
            );

        const currentRowIndex =
            rowTops.indexOf(
                currentTop
            );


        /* =================================================
           OBERE ZEILE
           → AUSBUCHTUNG
           ================================================= */

        if (
            currentRowIndex === 0 &&
            rowTops.length > 1
        )
        {
            const secondRowTop =
                rowTops[1];

            const secondRowBoxes =
                boxes.filter(
                    function (entry)
                    {
                        return (
                            Math.round(
                                entry
                                    .getBoundingClientRect()
                                    .top
                            )
                            === secondRowTop
                        );
                    }
                );

            let secondRowBottom =
                secondRowTop;

            secondRowBoxes.forEach(
                function (entry)
                {
                    const bottom =
                        entry
                            .getBoundingClientRect()
                            .bottom;

                    if (
                        bottom >
                        secondRowBottom
                    )
                    {
                        secondRowBottom =
                            bottom;
                    }
                }
            );

            menu.classList.add(
                "has-notch"
            );

            menu.style.setProperty(
                "--pl-notch-left",
                (
                    boxRect.left -
                    widgetRect.left
                ) + "px"
            );

            menu.style.setProperty(
                "--pl-notch-width",
                boxRect.width + "px"
            );

            menu.style.setProperty(
                "--pl-notch-height",
                (
                    secondRowBottom -
                    secondRowTop
                ) + "px"
            );
        }

        /* =================================================
           UNTERE ZEILE
           ================================================= */

        else
        {
            menu.classList.remove(
                "has-notch"
            );
        }
    }


    /* =====================================================
       MEGA-MENÜ ERZEUGEN
       ===================================================== */

    function getOrCreateMenu(box)
    {
        let menu =
            box.querySelector(
                ":scope > " +
                ".preis-lando-hover-menu"
            );

        if (menu)
        {
            return menu;
        }

        menu =
            document.createElement(
                "div"
            );

        menu.className =
            "preis-lando-hover-menu";


        /* -------------------------------------------------
           SCHLIESSEN
           ------------------------------------------------- */

        const closeButton =
            document.createElement(
                "button"
            );

        closeButton.type =
            "button";

        closeButton.className =
            "preis-lando-hover-close";


        const closeText =
            document.createElement(
                "span"
            );

        closeText.textContent =
            "Schließen";


        const closeX =
            document.createElement(
                "span"
            );

        closeX.className =
            "preis-lando-hover-close-x";

        closeX.textContent =
            "×";


        closeButton.appendChild(
            closeText
        );

        closeButton.appendChild(
            closeX
        );


        closeButton.addEventListener(
            "click",
            function (event)
            {
                event.preventDefault();
                event.stopPropagation();

                closeAllHoverMenus();
            }
        );


        menu.appendChild(
            closeButton
        );


        /* -------------------------------------------------
           INHALT
           ------------------------------------------------- */

        const content =
            document.createElement(
                "div"
            );

        content.className =
            "preis-lando-hover-content";

        menu.appendChild(
            content
        );


        /* -------------------------------------------------
           MENÜ HOVER
           ------------------------------------------------- */

        menu.addEventListener(
            "mouseenter",
            function ()
            {
                cancelHoverClose();

                activeHoverBox =
                    box;
            }
        );


        menu.addEventListener(
            "mouseleave",
            function ()
            {
                cancelHoverClose();

                hoverCloseTimer =
                    setTimeout(
                        function ()
                        {
                            if (
                                activeHoverBox
                                === box
                            )
                            {
                                closeActiveHoverMenu();
                            }
                        },
                        HOVER_CLOSE_DELAY
                    );
            }
        );


        box.appendChild(
            menu
        );

        return menu;
    }


    /* =====================================================
       LADEANZEIGE
       ===================================================== */

    function showLoading(menu)
    {
        const content =
            menu.querySelector(
                ".preis-lando-hover-content"
            );

        if (!content)
        {
            return;
        }

        content.innerHTML =
            "";

        menu.classList.remove(
            "is-empty"
        );

        menu.classList.add(
            "is-loading"
        );

        menu.classList.add(
            "is-visible"
        );


        const loading =
            document.createElement(
                "div"
            );

        loading.className =
            "preis-lando-hover-loading";

        loading.textContent =
            "Kategorien werden geladen …";

        content.appendChild(
            loading
        );
    }


    /* =====================================================
       KATEGORIEBILD-ELEMENT ERZEUGEN
       ===================================================== */

    function createCategoryImageElement(
        category
    )
    {
        const directImage =
            getCategoryImage(
                category
            );


        /* Direktes Kategorie-Bild vorhanden */
        if (directImage)
        {
            const image =
                document.createElement(
                    "img"
                );

            image.className =
                "preis-lando-hover-image";

            image.src =
                directImage;

            image.alt =
                getCategoryName(
                    category
                );

            image.loading =
                "lazy";

            return image;
        }


        /*
         * Kein Kategorie-Bild:
         * Artikelbild über Plugin-Endpunkt laden.
         */
        const image =
            document.createElement(
                "img"
            );

        image.className =
            "preis-lando-hover-image " +
            "preis-lando-hover-image-empty";

        image.alt =
            getCategoryName(
                category
            );

        /*
         * Solange kein Bild geladen:
         * unsichtbar, aber Platz bleibt erhalten.
         */
        image.style.visibility =
            "hidden";


        loadFallbackCategoryImage(
            category
        )
            .then(
                function (fallbackImage)
                {
                    if (!fallbackImage)
                    {
                        return;
                    }

                    image.src =
                        fallbackImage;

                    image.classList.remove(
                        "preis-lando-hover-image-empty"
                    );

                    image.style.visibility =
                        "visible";
                }
            );


        return image;
    }


    /* =====================================================
       UNTERKATEGORIEN RENDERN
       ===================================================== */

    function renderChildren(
        menu,
        children
    )
    {
        const content =
            menu.querySelector(
                ".preis-lando-hover-content"
            );

        if (!content)
        {
            return;
        }

        content.innerHTML =
            "";

        menu.classList.remove(
            "is-loading"
        );


        if (
            !children ||
            !children.length
        )
        {
            menu.classList.add(
                "is-empty"
            );

            menu.classList.remove(
                "is-visible"
            );

            return;
        }

        menu.classList.remove(
            "is-empty"
        );


        for (
            const category
            of children
        )
        {
            const item =
                document.createElement(
                    "a"
                );

            item.className =
                "preis-lando-hover-item";

            item.href =
                getCategoryUrl(
                    category
                );


            /* ---------------------------------------------
               BILD
               --------------------------------------------- */

            const image =
                createCategoryImageElement(
                    category
                );

            item.appendChild(
                image
            );


            /* ---------------------------------------------
               TEXT
               --------------------------------------------- */

            const text =
                document.createElement(
                    "span"
                );

            text.className =
                "preis-lando-hover-text";

            text.textContent =
                getCategoryName(
                    category
                );

            item.appendChild(
                text
            );


            content.appendChild(
                item
            );
        }


        menu.classList.add(
            "is-visible"
        );
    }


    /* =====================================================
       HAUPTKATEGORIE VORBEREITEN
       ===================================================== */

    function prepareCategoryBox(
        widget,
        box
    )
    {
        if (
            box.dataset
                .preisLandoHoverReady
            === "1"
        )
        {
            return;
        }

        const link =
            box.querySelector(
                ":scope > a"
            );

        if (!link)
        {
            return;
        }

        box.dataset
            .preisLandoHoverReady =
            "1";

        box.classList.add(
            "preis-lando-hover-parent"
        );


        function openMenu()
        {
            if (!isDesktop())
            {
                return;
            }

            cancelHoverClose();

            const category =
                findCategoryForLink(
                    widget,
                    link
                );

            if (
                !category ||
                !category.id
            )
            {
                console.warn(
                    "PreisLando HoverNavigation:",
                    "Kategorie konnte nicht zugeordnet werden:",
                    link.href
                );

                return;
            }


            /* vorheriges Menü schließen */
            if (
                activeHoverBox &&
                activeHoverBox !== box
            )
            {
                const oldMenu =
                    activeHoverBox
                        .querySelector(
                            ":scope > " +
                            ".preis-lando-hover-menu"
                        );

                if (oldMenu)
                {
                    oldMenu.classList.remove(
                        "is-visible"
                    );

                    oldMenu.classList.remove(
                        "has-notch"
                    );
                }

                activeHoverBox
                    .classList
                    .remove(
                        "is-hover-active"
                    );
            }


            activeHoverBox =
                box;

            setActiveCategory(
                widget,
                box
            );

            const menu =
                getOrCreateMenu(
                    box
                );

            positionMegaMenu(
                widget,
                box,
                menu
            );


            /* bereits geladen */
            if (
                menu.dataset.loaded
                === "1"
            )
            {
                if (
                    !menu.classList
                        .contains(
                            "is-empty"
                        )
                )
                {
                    menu.classList.add(
                        "is-visible"
                    );
                }

                return;
            }


            showLoading(
                menu
            );


            loadCategoryChildren(
                category.id
            )
                .then(
                    function (children)
                    {
                        menu.dataset.loaded =
                            "1";

                        renderChildren(
                            menu,
                            children
                        );

                        if (
                            activeHoverBox
                            !== box
                        )
                        {
                            menu.classList.remove(
                                "is-visible"
                            );
                        }
                    }
                );
        }


        /* ENTER */
        box.addEventListener(
            "mouseenter",
            function ()
            {
                if (!isDesktop())
                {
                    return;
                }

                cancelHoverClose();
                cancelHoverOpen();

                hoverOpenTimer =
                    setTimeout(
                        function ()
                        {
                            hoverOpenTimer =
                                null;

                            openMenu();
                        },
                        HOVER_OPEN_DELAY
                    );
            }
        );


        /* LEAVE */
        box.addEventListener(
            "mouseleave",
            function ()
            {
                cancelHoverOpen();
                cancelHoverClose();

                hoverCloseTimer =
                    setTimeout(
                        function ()
                        {
                            if (
                                activeHoverBox
                                === box
                            )
                            {
                                closeActiveHoverMenu();
                            }
                        },
                        HOVER_CLOSE_DELAY
                    );
            }
        );
    }


    /* =====================================================
       NAVIGATION INITIALISIEREN
       ===================================================== */

    function initializeHoverNavigation()
    {
        if (!isDesktop())
        {
            return;
        }

        const widget =
            document.querySelector(
                ".kategorie-11-spalten"
            );

        if (!widget)
        {
            return;
        }

        const boxes =
            widget.querySelectorAll(
                ".row > div"
            );

        boxes.forEach(
            function (box)
            {
                if (
                    box.querySelector(
                        ":scope > a"
                    )
                )
                {
                    prepareCategoryBox(
                        widget,
                        box
                    );
                }
            }
        );
    }

/* =========================================================
   KATEGORIEBILDER IM HINTERGRUND VORLADEN
   ========================================================= */

function preloadHoverImages(widget)
{
    if (!isDesktop())
    {
        return;
    }

    const categories =
        getLoadedMainCategories(
            widget
        );

    if (!categories.length)
    {
        return;
    }

    categories.forEach(
        function (mainCategory)
        {
            if (
                !mainCategory ||
                !mainCategory.id
            )
            {
                return;
            }

            loadCategoryChildren(
                mainCategory.id
            )
                .then(
                    function (children)
                    {
                        if (
                            !Array.isArray(
                                children
                            )
                        )
                        {
                            return;
                        }

                        children.forEach(
                            function (child)
                            {
                                /*
                                 * Hat die Kategorie bereits
                                 * ein echtes Kategorie-Bild,
                                 * brauchen wir keinen Fallback.
                                 */
                                if (
                                    getCategoryImage(
                                        child
                                    )
                                )
                                {
                                    return;
                                }

                                /*
                                 * Fallback-Bild schon jetzt
                                 * im Hintergrund laden.
                                 */
                                loadFallbackCategoryImage(
                                    child
                                )
                                    .then(
                                        function (imageUrl)
                                        {
                                            if (!imageUrl)
                                            {
                                                return;
                                            }

                                            /*
                                             * Zusätzlich Browser-Cache
                                             * mit dem echten Bild füllen.
                                             */
                                            const img =
                                                new Image();

                                            img.src =
                                                imageUrl;
                                        }
                                    );
                            }
                        );
                    }
                );
        }
    );
}
    /* =====================================================
       START
       ===================================================== */

    function start()
    {
        initializeHoverNavigation();
    const widget =
        document.querySelector(
            ".kategorie-11-spalten"
        );

    if (widget)
    {
        /*
         * Nicht sofort alles gleichzeitig laden.
         * Erst wenn die Seite grundsätzlich fertig ist.
         */
        setTimeout(
            function ()
            {
                preloadHoverImages(
                    widget
                );
            },
            1500
        );
    }

        const observer =
            new MutationObserver(
                function ()
                {
                    if (isDesktop())
                    {
                        initializeHoverNavigation();
                    }
                }
            );

        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );


        let resizeTimer =
            null;

        window.addEventListener(
            "resize",
            function ()
            {
                clearTimeout(
                    resizeTimer
                );

                resizeTimer =
                    setTimeout(
                        function ()
                        {
                            if (
                                isDesktop()
                            )
                            {
                                initializeHoverNavigation();
                            }
                            else
                            {
                                closeAllHoverMenus();
                            }
                        },
                        100
                    );
            }
        );
    }


    if (
        document.readyState
        === "loading"
    )
    {
        document.addEventListener(
            "DOMContentLoaded",
            start
        );
    }
    else
    {
        start();
    }


    /* =====================================================
       PREISLANDO SCHNELLSUCHE – PREISE
       ===================================================== */

    (function setupAutocompletePrices()
    {
        const priceCache =
            {};

        const pendingPrices =
            {};


        function getIdsFromAutocompleteUrl(
            url
        )
        {
            if (!url)
            {
                return null;
            }

            const cleanUrl =
                String(url)
                    .split("?")[0]
                    .replace(
                        /\/+$/,
                        ""
                    );

            const match =
                cleanUrl.match(
                    /_(\d+)_(\d+)$/
                );

            if (!match)
            {
                return null;
            }

            return {
                itemId:
                    parseInt(
                        match[1],
                        10
                    ),

                variationId:
                    parseInt(
                        match[2],
                        10
                    )
            };
        }


        function loadVariationPrice(
            itemId,
            variationId
        )
        {
            const cacheKey =
                itemId +
                "_" +
                variationId;

            if (
                Object.prototype
                    .hasOwnProperty.call(
                        priceCache,
                        cacheKey
                    )
            )
            {
                return Promise.resolve(
                    priceCache[
                        cacheKey
                    ]
                );
            }

            if (
                pendingPrices[
                    cacheKey
                ]
            )
            {
                return pendingPrices[
                    cacheKey
                ];
            }

            const url =
                "/rest/preislando/search-price/" +
                encodeURIComponent(
                    variationId
                );

            pendingPrices[
                cacheKey
            ] =
                fetch(
                    url,
                    {
                        credentials:
                            "same-origin",

                        headers:
                        {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                )
                    .then(
                        function (response)
                        {
                            if (!response.ok)
                            {
                                throw new Error(
                                    "Preis HTTP " +
                                    response.status
                                );
                            }

                            return response.json();
                        }
                    )
                    .then(
                        function (data)
                        {
                            const price =
                                data &&
                                data.success &&
                                data.price
                                    ? data.price
                                    : "";

                            priceCache[
                                cacheKey
                            ] =
                                price;

                            return price;
                        }
                    )
                    .catch(
                        function (error)
                        {
                            console.warn(
                                "PreisLando Schnellsuche:",
                                "Preis konnte nicht geladen werden",
                                itemId,
                                variationId,
                                error
                            );

                            priceCache[
                                cacheKey
                            ] =
                                "";

                            return "";
                        }
                    )
                    .finally(
                        function ()
                        {
                            delete pendingPrices[
                                cacheKey
                            ];
                        }
                    );

            return pendingPrices[
                cacheKey
            ];
        }


        function getOrCreatePriceElement(
            link
        )
        {
            let price =
                link.querySelector(
                    ":scope > " +
                    ".preis-lando-search-price"
                );

            if (price)
            {
                return price;
            }

            price =
                document.createElement(
                    "span"
                );

            price.className =
                "preis-lando-search-price";

            link.appendChild(
                price
            );

            return price;
        }


        function prepareAutocompleteItem(
            link
        )
        {
            if (
                link.dataset
                    .preisLandoPriceReady
                === "1"
            )
            {
                return;
            }

            const ids =
                getIdsFromAutocompleteUrl(
                    link.getAttribute(
                        "href"
                    )
                );

            if (!ids)
            {
                return;
            }

            link.dataset
                .preisLandoPriceReady =
                "1";

            const priceElement =
                getOrCreatePriceElement(
                    link
                );

            priceElement.textContent =
                "";

            loadVariationPrice(
                ids.itemId,
                ids.variationId
            )
                .then(
                    function (price)
                    {
                        if (price)
                        {
                            priceElement.textContent =
                                price;
                        }
                    }
                );
        }


        function initializeAutocompletePrices()
        {
            const links =
                document.querySelectorAll(
                    ".autocomplete-suggestions " +
                    "a.autocomplete-suggestion"
                );

            links.forEach(
                prepareAutocompleteItem
            );
        }


        const autocompleteObserver =
            new MutationObserver(
                function ()
                {
                    initializeAutocompletePrices();
                }
            );

        autocompleteObserver.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );

        initializeAutocompletePrices();

    })();

})();
</script>
