   --------------------------------------------------------- */
html.pl-chess-open, html.pl-chess-open body { overflow:hidden !important; }
.pl-chess[hidden] { display:none !important; }
.pl-chess { position:fixed; inset:0; z-index:2147483600; font-family:Arial,Helvetica,sans-serif; color:#16360e; }
.pl-chess__backdrop { position:absolute; inset:0; background:rgba(0,0,0,.48); }
.pl-chess__dialog { position:absolute; inset:14px; display:flex; flex-direction:column; max-width:940px; max-height:calc(100dvh - 28px); margin:auto; overflow:hidden; border-radius:18px; background:#fff; box-shadow:0 20px 60px rgba(0,0,0,.34); }
.pl-chess__head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding:18px 20px 16px; background:#f8fff5; border-bottom:1px solid #ddd; }
.pl-chess__eyebrow { margin-bottom:4px; color:#269609; font-size:12px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
.pl-chess__head h2 { margin:0; color:#173d0d; font-size:32px; line-height:1.05; }
.pl-chess__head p { margin:9px 0 0; color:#444; font-size:14px; }
.pl-chess__close { display:grid; place-items:center; width:42px; height:42px; border:1px solid #ccc; border-radius:50%; background:#fff; color:#222; font-size:28px; line-height:1; cursor:pointer; }
.pl-chess__body { display:grid; grid-template-columns:minmax(0,1fr) 250px; gap:22px; min-height:0; padding:20px; overflow:auto; }
.pl-chess__game { min-width:0; }
.pl-chess__status { min-height:44px; margin-bottom:10px; padding:10px 12px; border:1px solid #ddd; border-radius:10px; background:#fff9ef; color:#222; font-weight:700; }
.pl-chess__status[data-mode="win"] { background:#ecffe3; border-color:#68c846; color:#173d0d; }
