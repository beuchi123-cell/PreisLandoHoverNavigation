   ========================================================= */@media (min-width: 768px){.preis-lando-navigation,.preis-lando-navigation > .widget-inner,.preis-lando-navigation-root{overflow:visible !important}.preis-lando-navigation{position:relative !important;z-index:10000 !important}.preis-lando-navigation-root{position:relative !important;z-index:10001 !important}.preis-lando-navigation-root > .preis-lando-hover-menu{position:absolute !important;top:64px !important;left:50% !important;right:auto !important;width:100vw !important;min-width:100vw !important;max-width:100vw !important;transform:translateX(-50%) !important;margin:0 !important;z-index:10002 !important}.preis-lando-navigation-root > .preis-lando-hover-menu.is-visible{display:block !important}}/* =========================================================
   PREISLANDO STARTSEITE – SAFE PATCH v1.4.20
   Basis: vorhandene v1.4.17 bleibt unangetastet.
   Dieser Block darf NUR ganz unten angehängt werden.
   Keine Änderung an Navigation, Suche, Logo oder Mobile-Menü.
   ========================================================= */:root{--pl-start-green:#51c817;--pl-start-bg:#f3f3f3;--pl-start-border:#e3e3e3;--pl-start-text:#171717;--pl-start-muted:#6f6f6f;--pl-start-radius:10px}/* ---------------------------------------------------------
   A) HEADER: nur weiße Fläche bis zum Browserrand erweitern.
   WICHTIG: Die vorhandene 1400px-Geometrie wird NICHT geändert.
   Dadurch bleiben Logo/Suche/Navigation an ihrer Position.
   --------------------------------------------------------- */#page-header-parent{position:relative !important}#page-header-parent::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);background:#fff;pointer-events:none;z-index:0}#page-header-parent > *{position:relative;z-index:1}/* ---------------------------------------------------------
   B) ARTIKELLISTEN
   Klassen auf das jeweilige ShopBuilder-Widget "Artikelliste":
   Bestseller          = start-produkte start-bestseller
   Aktuelle Angebote   = start-produkte start-angebote
   Neu bei PreisLando  = start-produkte start-neu

   Im Widget selbst bitte "Anzahl der sichtbaren Artikel" = 5.
   Die Anzahl wird absichtlich NICHT per CSS erzwungen.
   --------------------------------------------------------- */.start-produkte{margin:10px 0 !important;padding:10px 12px 12px !important;background:#fff !important;border-radius:var(--pl-start-radius) !important;box-shadow:0 1px 3px rgba(0,0,0,.05) !important;overflow:hidden !important}/* rote/gefärbte Überschriftsleiste des Plenty-Erscheinungsbilds neutralisieren */.start-produkte .widget-caption,.start-produkte .widget-title,.start-produkte [class*="widget-caption"],.start-produkte h1,.start-produkte h2,.start-produkte h3,.start-produkte h4{background:transparent !important;background-color:transparent !important;color:var(--pl-start-text) !important;border:0 !important;box-shadow:none !important}.start-produkte .widget-caption,.start-produkte .widget-title,.start-produkte h2,.start-produkte h3{margin:0 0 9px !important;padding:0 !important;font-size:24px !important;line-height:1.15 !important;font-weight:700 !important}/* Plenty-eigene Artikelliste nicht umbauen; nur Abstände/Karten gestalten */.start-produkte .product-list{margin-left:-5px !important;margin-right:-5px !important}.start-produkte .product-list li{padding-left:5px !important;padding-right:5px !important}.start-produkte .cmp-product-thumb{height:100% !important;background:#fff !important;border:1px solid var(--pl-start-border) !important;border-radius:7px !important;box-shadow:none !important;overflow:hidden !important}.start-produkte .cmp-product-thumb:hover{box-shadow:0 3px 12px rgba(0,0,0,.08) !important}.start-produkte .cmp-product-thumb img,.start-produkte .owl-lazy{object-fit:contain !important}.start-produkte .thumb-title{color:#252525 !important}.start-produkte .add-to-basket-lg-container .btn,.start-produkte .btn-primary,.start-produkte .btn-success{background-color:var(--pl-start-green) !important;border-color:var(--pl-start-green) !important}/* Angebotsbereich: Preis darf rot bleiben */.start-angebote .special-offer,.start-angebote .price.special-offer,.start-angebote .sales-price{color:#e30613 !important}/* ---------------------------------------------------------
   C) HERBSTBANNER
   Äußeres Struktur-/Zeilen-Widget: start-herbst-banner
   Bildbox darin zusätzlich:      start-herbst-banner-img
   --------------------------------------------------------- */.start-herbst-banner{margin:10px 0 !important;padding:0 !important;height:auto !important;min-height:0 !important;max-height:none !important;background:transparent !important;overflow:hidden !important;border-radius:var(--pl-start-radius) !important}.start-herbst-banner > .widget-inner,.start-herbst-banner > .widget-inner > div,.start-herbst-banner .start-herbst-banner-img,.start-herbst-banner .start-herbst-banner-img > .widget-inner,.start-herbst-banner .widget-image-box{margin-top:0 !important;margin-bottom:0 !important;padding-top:0 !important;padding-bottom:0 !important;height:auto !important;min-height:0 !important;max-height:none !important;background:transparent !important}.start-herbst-banner .start-herbst-banner-img,.start-herbst-banner .start-herbst-banner-img a,.start-herbst-banner .start-herbst-banner-img picture,.start-herbst-banner .start-herbst-banner-img img,.start-herbst-banner .widget-image-box a,.start-herbst-banner .widget-image-box picture,.start-herbst-banner .widget-image-box img{display:block !important;width:100% !important;margin:0 !important;padding:0 !important}.start-herbst-banner .start-herbst-banner-img img,.start-herbst-banner .widget-image-box img{height:auto !important;min-height:0 !important;max-height:none !important;object-fit:cover !important;object-position:center !important;transform:none !important}.start-herbst-banner .widget-caption:empty,.start-herbst-banner .start-herbst-banner-img .widget-caption:empty{display:none !important}/* ---------------------------------------------------------
   D) IDEEN FÜR DEIN ZUHAUSE
   Äußeres Struktur-Widget = start-ideen
   --------------------------------------------------------- */.start-ideen{margin:10px 0 !important;padding:12px !important;background:#fff !important;border-radius:var(--pl-start-radius) !important}.start-ideen h2,.start-ideen h3{margin:0 0 10px !important;color:var(--pl-start-text) !important;font-size:24px !important;font-weight:700 !important}/* ---------------------------------------------------------
   E) SERVICELEISTE
   HTML-Widget = start-serviceleiste
   Passendes HTML liegt separat bei.
   --------------------------------------------------------- */.start-serviceleiste{margin:10px 0 !important;padding:0 !important}.start-serviceleiste .pl-servicebar{display:grid;grid-template-columns:repeat(4, minmax(0,1fr));gap:0;background:#fff;border-radius:var(--pl-start-radius);overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.05)}.start-serviceleiste .pl-serviceitem{min-height:72px;display:flex;align-items:center;justify-content:center;gap:11px;padding:10px 16px;color:var(--pl-start-text);background:#fff}.start-serviceleiste .pl-serviceitem + .pl-serviceitem{border-left:1px solid #ededed}.start-serviceleiste .pl-serviceicon{flex:0 0 auto;font-size:28px;line-height:1;color:var(--pl-start-green)}.start-serviceleiste .pl-servicetext strong{display:block;margin:0;font-size:13px;line-height:1.2}.start-serviceleiste .pl-servicetext span{display:block;margin-top:2px;font-size:10px;line-height:1.25;color:var(--pl-start-muted)}.start-serviceleiste .pl-brand{font-weight:800;white-space:nowrap}.start-serviceleiste .pl-paypal{color:#163b73}.start-serviceleiste .pl-dhl{color:#d40511}.start-serviceleiste .pl-dpd{color:#dc0032}/* ---------------------------------------------------------
   F) NEWSLETTER
   Klasse auf das ECHTE Plenty-Newsletter-Widget bzw. dessen
   äußeres Struktur-Widget = start-newsletter
   --------------------------------------------------------- */.start-newsletter{margin:10px 0 18px !important;padding:18px 22px !important;background:#fff !important;border-radius:var(--pl-start-radius) !important;box-shadow:0 1px 3px rgba(0,0,0,.05) !important}.start-newsletter h1,.start-newsletter h2,.start-newsletter h3,.start-newsletter h4{color:var(--pl-start-text) !important}.start-newsletter .form-control,.start-newsletter input[type="email"],.start-newsletter input[type="text"]{min-height:42px !important;border-color:#d7d7d7 !important;box-shadow:none !important}.start-newsletter .btn,.start-newsletter button{min-height:42px !important}.start-newsletter .btn-primary,.start-newsletter .btn-success,.start-newsletter button[type="submit"]{background-color:var(--pl-start-green) !important;border-color:var(--pl-start-green) !important;color:#fff !important;font-weight:700 !important}/* ---------------------------------------------------------
   G) RESPONSIVE – nur die neuen Startseitenklassen
   --------------------------------------------------------- */@media (max-width: 991.98px){.start-serviceleiste .pl-servicebar{grid-template-columns:repeat(2, minmax(0,1fr))}.start-serviceleiste .pl-serviceitem:nth-child(3){border-left:0;border-top:1px solid #ededed}.start-serviceleiste .pl-serviceitem:nth-child(4){border-top:1px solid #ededed}}@media (max-width: 767.98px){.start-produkte{padding:9px 8px 10px !important}.start-produkte .widget-caption,.start-produkte .widget-title,.start-produkte h2,.start-produkte h3,.start-ideen h2,.start-ideen h3{font-size:20px !important}.start-serviceleiste .pl-serviceitem{justify-content:flex-start;min-height:66px;padding:9px 11px}.start-newsletter{padding:15px 14px !important}}@media (max-width: 480px){.start-serviceleiste .pl-servicebar{grid-template-columns:1fr}.start-serviceleiste .pl-serviceitem + .pl-serviceitem,.start-serviceleiste .pl-serviceitem:nth-child(3),.start-serviceleiste .pl-serviceitem:nth-child(4){border-left:0;border-top:1px solid #ededed}}/* =========================================================
   PREISLANDO LIVE-F12 FIX – 2026-09-15
   Exakt nach der tatsächlichen ShopBuilder-DOM-Struktur.
   ========================================================= *//* 1) Graue Desktop-Headerfläche */@media (min-width: 768px){.header-logo-suche,.header-logo-suche > .widget-inner,.header-logo-suche > .widget-inner > div,.header-logo-suche > .widget-inner > div > div,.header-logo-suche .preis-lando-logo,.header-logo-suche .top-bar,.header-logo-suche .top-bar > .container-max,.header-logo-suche .top-bar .row,.header-logo-suche .top-bar-items,.header-logo-suche .controls,.header-logo-suche .always-visible-search,.header-logo-suche .always-visible-search > .container-max,.header-logo-suche .always-visible-search > .container-max > .position-relative{background:#fff !important;background-color:#fff !important}}/* 2) Native Plenty-Artikellistenüberschriften *//* Alle Plenty-Artikellisten einheitlich im PreisLando-Look */.widget-item-list-caption.bg-appearance{width:100% !important;min-height:28px !important;margin:0 !important;padding:0 !important;background:#51c817 !important;background-color:#51c817 !important;color:#fff !important;border:0 !important;border-radius:8px 8px 0 0 !important;box-sizing:border-box !important}.widget-item-list-caption.bg-appearance > div{min-height:28px !important;margin:0 !important;padding:0 !important;background:transparent !important}.widget-item-list-caption.bg-appearance :is(h1, h2, h3, h4, p){margin:0 !important;padding:0 14px !important;color:#fff !important;background:transparent !important;font-size:16px !important;line-height:28px !important;font-weight:700 !important}.widget-item-list-caption.bg-appearance a,.widget-item-list-caption.bg-appearance i{color:#fff !important}/* 3) Newsletter – echte Live-DOM */.start-newsletter-row,.widget.widget-grid.widget-three-col.row.start-newsletter-note{margin:10px 0 18px !important;padding:14px 10px !important;background:#fff !important;border-radius:10px !important;box-sizing:border-box !important;align-items:center !important}.start-newsletter-row > .widget-inner,.widget.widget-grid.widget-three-col.row.start-newsletter-note > .widget-inner{display:flex !important;align-items:center !important;min-width:0 !important}.start-newsletter-copy,.start-newsletter-copy > .widget-inner{width:100% !important;background:transparent !important}.start-newsletter-copy{position:relative !important;margin:0 !important;padding:4px 0 4px 60px !important;box-sizing:border-box !important}.start-newsletter-copy::before{content:"✉" !important;position:absolute !important;left:8px !important;top:50% !important;transform:translateY(-50%) !important;color:#51c817 !important;font-size:44px !important;line-height:1 !important}.start-newsletter-copy .pl-news-title{margin:0 0 3px !important;color:#111 !important;font-size:17px !important;line-height:21px !important;font-weight:700 !important}.start-newsletter-copy .pl-news-text{margin:0 !important;color:#666 !important;font-size:12px !important;line-height:16px !important}.start-newsletter-form,.start-newsletter-form > .widget-inner{width:100% !important;min-width:0 !important;margin:0 !important;padding:0 !important;background:transparent !important}.start-newsletter-form > .widget-inner > .row:first-child,.start-newsletter-form > .widget-inner > .row:first-child > .col-12{margin:0 !important;padding:0 !important;min-height:0 !important}.start-newsletter-form form > .row{display:grid !important;grid-template-columns:minmax(0, 1fr) 155px !important;grid-template-rows:auto auto auto !important;column-gap:0 !important;row-gap:4px !important;width:100% !important;margin:0 !important;padding:0 !important;align-items:start !important}.start-newsletter-form form > .row > .col-12:first-child{grid-column:1 !important;grid-row:1 !important;width:100% !important;max-width:none !important;margin:0 !important;padding:0 !important}.start-newsletter-form .input-group,.start-newsletter-form .input-unit{display:block !important;width:100% !important;margin:0 !important;padding:0 !important}.start-newsletter-form .input-unit > label[for^="email-input-id_"]{display:none !important}.start-newsletter-form input[type="email"]{display:block !important;width:100% !important;height:42px !important;min-height:42px !important;margin:0 !important;padding:0 12px !important;color:#333 !important;background:#fff !important;border:1px solid #d4d4d4 !important;border-radius:6px 0 0 6px !important;box-shadow:none !important;box-sizing:border-box !important}.start-newsletter-form input.honey,.start-newsletter-form label[for^="input-username_"]{display:none !important}.start-newsletter-form form > .row > .col-12.mt-3{grid-column:2 !important;grid-row:1 !important;width:155px !important;max-width:155px !important;margin:0 !important;padding:0 !important}.start-newsletter-form .input-group-btn{width:100% !important;margin:0 !important;padding:0 !important}.start-newsletter-form button[data-testing="nl-send"]{display:block !important;width:100% !important;height:42px !important;min-height:42px !important;margin:0 !important;padding:0 12px !important;color:#fff !important;background:#51c817 !important;border:1px solid #51c817 !important;border-radius:0 6px 6px 0 !important;font-size:13px !important;font-weight:700 !important;white-space:nowrap !important;box-sizing:border-box !important}.start-newsletter-form form > .row > .col-12:nth-child(2){grid-column:1/3 !important;grid-row:2 !important;width:100% !important;max-width:none !important;margin:3px 0 0 !important;padding:0 !important}.start-newsletter-form .form-check.small{margin:0 !important;color:#777 !important;font-size:9px !important;line-height:12px !important}.start-newsletter-form form > .row > .col-12.text-right.small.mt-2{grid-column:1/3 !important;grid-row:3 !important;width:100% !important;max-width:none !important;margin:0 !important;padding:0 !important;color:#999 !important;font-size:8px !important;line-height:10px !important}.start-newsletter-row > .widget-inner:nth-child(3) .widget-code > .widget-inner > div,.widget.widget-grid.widget-three-col.row.start-newsletter-note > .widget-inner:nth-child(3) .widget-code > .widget-inner > div,.widget-code.start-newsletter-note > .widget-inner > div{color:#222 !important;font-family:"Comic Sans MS","Segoe Print",cursive !important;font-size:18px !important;line-height:1.1 !important;text-align:center !important;transform:rotate(-4deg) !important}/* Marker: wenn dieser Wert 1 ist, kommt das komplette PreisLando-CSS aus dem Plugin. */html{--pl-all-css-plugin:1}@media (max-width: 767.98px){.start-newsletter-form form > .row{display:block !important}.start-newsletter-form form > .row > .col-12:first-child,.start-newsletter-form form > .row > .col-12:nth-child(2),.start-newsletter-form form > .row > .col-12.mt-3,.start-newsletter-form form > .row > .col-12.text-right.small.mt-2{width:100% !important;max-width:100% !important}.start-newsletter-form input[type="email"],.start-newsletter-form button[data-testing="nl-send"]{border-radius:6px !important}.start-newsletter-form form > .row > .col-12.mt-3{margin-top:6px !important}}/* =========================================================
   PREISLANDO – TICKET HERO v1.1
   Code-Widget-Lösung für die 3 Startseiten-Banner
   FINALER TESTSTAND:
   - max. 900px breit
   - 180px Gesamthöhe
   - rechte Tickets je 85px + 10px Abstand
   - gestrichelte Linie 2px
   ========================================================= */.pl-ticket-hero{display:grid;grid-template-columns:minmax(0, 2fr) minmax(260px, 1fr);gap:10px;width:100%;max-width:900px;height:180px;margin:12px auto 16px}.pl-ticket-hero__side{display:grid;grid-template-rows:85px 85px;gap:10px;height:180px}.pl-ticket-card{--ticket-bg:#ffffff;--ticket-page-bg:#f3f3f3;--ticket-radius:16px;--ticket-notch:16px;position:relative;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;border-radius:var(--ticket-radius);background-color:var(--ticket-bg);background-position:center center;background-repeat:no-repeat;background-size:cover;text-decoration:none;box-shadow:0 2px 6px rgba(0,0,0,.08);isolation:isolate}/* Ticket-Aussparungen links / rechts */.pl-ticket-card::before,.pl-ticket-card::after{content:"";position:absolute;top:50%;width:calc(var(--ticket-notch) * 2);height:calc(var(--ticket-notch) * 2);border-radius:50%;background:var(--ticket-page-bg);transform:translateY(-50%);z-index:3;pointer-events:none}.pl-ticket-card::before{left:calc(var(--ticket-notch) * -1)}.pl-ticket-card::after{right:calc(var(--ticket-notch) * -1)}/* dünne Kontur an den Ticket-Aussparungen */.pl-ticket-card__edge{content:"";position:absolute;inset:0;pointer-events:none;z-index:2;border-radius:var(--ticket-radius);box-shadow:inset 0 0 0 1px rgba(0,0,0,.10)}.pl-ticket-card__edge::before,.pl-ticket-card__edge::after{content:"";position:absolute;top:50%;width:calc(var(--ticket-notch) * 2);height:calc(var(--ticket-notch) * 2);border-radius:50%;transform:translateY(-50%);box-shadow:0 0 0 1px rgba(0,0,0,.14)}.pl-ticket-card__edge::before{left:calc(var(--ticket-notch) * -1)}.pl-ticket-card__edge::after{right:calc(var(--ticket-notch) * -1)}/* Overlay für bessere Lesbarkeit */.pl-ticket-card__overlay{position:absolute;inset:0;z-index:0;background:linear-gradient(to top,
            rgba(255,255,255,.90) 0%,
            rgba(255,255,255,.66) 34%,
            rgba(255,255,255,.12) 72%,
            rgba(255,255,255,.02) 100%)}.pl-ticket-card__content{position:relative;z-index:4;display:block;padding:22px;color:#13281b}/* optionale kleine Ecke oben */.pl-ticket-card__badge{position:absolute;top:14px;left:18px;z-index:4;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.90);color:#2e2e2e;font-size:12px;line-height:14px;font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.08)}.pl-ticket-card__title{display:block;margin:0 0 4px;font-size:28px;line-height:1.08;font-weight:800;color:#0f4d20}.pl-ticket-card__subtitle{display:block;margin:0 0 16px;font-size:16px;line-height:1.25;font-weight:600;color:#203326}.pl-ticket-card__cta{display:inline-flex;align-items:center;gap:10px;padding:12px 20px;border-radius:999px;background:#63ca1b;color:#fff;font-size:16px;line-height:18px;font-weight:700;text-decoration:none;box-shadow:0 1px 3px rgba(0,0,0,.10)}.pl-ticket-card__cta::after{content:"›";font-size:24px;line-height:1;margin-top:-1px}/* kräftigere gestrichelte Ticket-Trennlinie */.pl-ticket-card__footer-line{position:absolute;left:22px;right:22px;bottom:68px;z-index:4;border-top:2px dashed rgba(0,0,0,.35)}/* große Karte links */.pl-ticket-card--big{height:180px;min-height:0;max-height:180px}.pl-ticket-card--big .pl-ticket-card__content{padding:14px 20px}.pl-ticket-card--big .pl-ticket-card__title{font-size:54px;line-height:.98;letter-spacing:-.8px}.pl-ticket-card--big .pl-ticket-card__subtitle{font-size:18px;line-height:1.22;margin-bottom:18px}/* kleine Karten rechts */.pl-ticket-card--small{height:85px;min-height:0;max-height:85px}.pl-ticket-card--small .pl-ticket-card__content{padding:8px 16px}.pl-ticket-card--small .pl-ticket-card__title{font-size:22px;line-height:1.02}.pl-ticket-card--small .pl-ticket-card__subtitle{font-size:14px;line-height:1.2;margin-bottom:12px}.pl-ticket-card--small .pl-ticket-card__cta{padding:9px 16px;font-size:14px;line-height:16px}.pl-ticket-card--small .pl-ticket-card__footer-line{bottom:54px;left:18px;right:18px}/* Farben / spezielle Typen */.pl-ticket-card--newsletter .pl-ticket-card__title{color:#1b1f28}.pl-ticket-card--newsletter .pl-ticket-card__title strong{color:#63ca1b;font-size:60px;line-height:.9;font-weight:900;display:inline-block;margin-right:4px;vertical-align:baseline}.pl-ticket-card--sale .pl-ticket-card__title{color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.14);font-size:56px;line-height:.95}.pl-ticket-card--sale .pl-ticket-card__overlay{background:linear-gradient(to top,
            rgba(255,255,255,.78) 0%,
            rgba(255,255,255,.52) 32%,
            rgba(255,255,255,.10) 100%)}.pl-ticket-card--sale .pl-ticket-card__content{text-align:center}.pl-ticket-card--sale .pl-ticket-card__cta{margin:0 auto}/* aktuelle Plenty-CDN-Hintergründe *//* Ticket-Hintergrundbilder werden bewusst im Custom-CSS gepflegt. *//* Tablet */@media (max-width: 991.98px){.pl-ticket-hero{grid-template-columns:1fr;height:auto}.pl-ticket-hero__side{grid-template-columns:1fr 1fr;grid-template-rows:auto;height:auto}.pl-ticket-card--big{height:180px}.pl-ticket-card--small{height:110px;max-height:none}.pl-ticket-card--big .pl-ticket-card__title{font-size:42px}}/* Mobile */@media (max-width: 767.98px){.pl-ticket-hero,.pl-ticket-hero__side{grid-template-columns:1fr}.pl-ticket-card--big,.pl-ticket-card--small{height:170px;min-height:170px;max-height:none}.pl-ticket-card--big .pl-ticket-card__title,.pl-ticket-card--sale .pl-ticket-card__title{font-size:34px}.pl-ticket-card--newsletter .pl-ticket-card__title strong{font-size:44px}.pl-ticket-card__content{padding:18px}.pl-ticket-card__footer-line{bottom:60px}}/* Marker für F12-Prüfung */html{--pl-ticket-hero-plugin:1}/* =========================================================
   v1.4.17.4 – SCHNELLSUCHE ALS OVERLAY
   - Trefferliste schiebt die Seite nicht mehr nach unten
