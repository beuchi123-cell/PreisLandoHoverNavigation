                if (color === "b" && move.to === 6)  { board[7] = null; board[5] = "bR"; }
                if (color === "b" && move.to === 2)  { board[0] = null; board[3] = "bR"; }
            }

            board[move.to] = move.promotion ? color + move.promotion : piece;

            if (type === "K") {
                next.castle[color + "K"] = false;
                next.castle[color + "Q"] = false;
            }
            if (type === "R") {
                if (move.from === 63) next.castle.wK = false;
                if (move.from === 56) next.castle.wQ = false;
                if (move.from === 7) next.castle.bK = false;
                if (move.from === 0) next.castle.bQ = false;
            }
            if (captured === "wR") {
                if (move.to === 63) next.castle.wK = false;
                if (move.to === 56) next.castle.wQ = false;
            }
            if (captured === "bR") {
                if (move.to === 7) next.castle.bK = false;
                if (move.to === 0) next.castle.bQ = false;
            }

            next.ep = null;
            if (type === "P" && Math.abs(move.to - move.from) === 16) {
                next.ep = (move.to + move.from) / 2;
            }

            next.turn = opposite(s.turn);
            return next;
        }

        function legalMoves(s, color) {
            return pseudoMoves(s, color).filter(function (move) {
                return !isInCheck(makeMove(s, move), color);
            });
        }

        function evaluateGame(s) {
            const moves = legalMoves(s, s.turn);
            if (moves.length) return { over: false, moves: moves };
            if (isInCheck(s, s.turn)) {
                return { over: true, winner: opposite(s.turn), reason: "checkmate", moves: [] };
            }
            return { over: true, winner: null, reason: "stalemate", moves: [] };
        }

        function scoreAiMove(s, move) {
            const moving = s.board[move.from];
            let captured = s.board[move.to];
            if (move.enPassant) captured = "wP";
            let score = captured ? (VALUES[pieceType(captured)] || 0) * 4 : 0;
            if (move.promotion) score += 900;

            const next = makeMove(s, move);
            if (isInCheck(next, "w")) score += 80;

            /* Leichte KI: etwas Materialbewusstsein, aber bewusst genug Zufall,
               damit der Gutschein auch realistisch erspielbar bleibt. */
            score += Math.random() * 260;
            if (pieceType(moving) === "Q") score -= 25;
            return score;
        }

        function chooseAiMove(s) {
            const moves = legalMoves(s, "b");
            if (!moves.length) return null;
            return moves
                .map(function (move) { return { move: move, score: scoreAiMove(s, move) }; })
                .sort(function (a, b) { return b.score - a.score; })[0].move;
        }

        function getRoot() {
            return document.getElementById(ROOT_ID);
        }

        function setStatus(text, mode) {
            const root = getRoot();
            if (!root) return;
            const status = root.querySelector(".pl-chess__status");
            if (!status) return;
            status.textContent = text;
            status.setAttribute("data-mode", mode || "normal");
        }

        function showVoucher() {
            const root = getRoot();
            if (!root) return;
            const prize = root.querySelector(".pl-chess__voucher");
            if (prize) prize.hidden = false;
            try { window.localStorage.setItem(WIN_STORAGE_KEY, "1"); } catch (error) {}
        }

        function wasWinner() {
            try { return window.localStorage.getItem(WIN_STORAGE_KEY) === "1"; }
            catch (error) { return false; }
        }

        function afterMove() {
            const result = evaluateGame(state);
            if (result.over) {
                state.gameOver = true;
                state.winner = result.winner;
                if (result.winner === "w") {
                    setStatus("Schachmatt! Du hast gewonnen – dein 10%-Gutschein ist freigeschaltet.", "win");
                    showVoucher();
                    celebrate();
                } else if (result.winner === "b") {
                    setStatus("Schachmatt. Der Computer gewinnt – noch eine Runde?", "lose");
                } else {
                    setStatus("Patt – unentschieden. Versuch es noch einmal.", "draw");
                }
                renderBoard();
                return true;
            }

            if (state.turn === "w") {
                setStatus(isInCheck(state, "w") ? "Du bist im Schach – dein Zug." : "Du bist dran (Weiß).", "normal");
            } else {
                setStatus(isInCheck(state, "b") ? "Computer ist im Schach …" : "Computer denkt …", "thinking");
            }
            renderBoard();
            return false;
        }

        function scheduleAi() {
            clearTimeout(aiTimer);
            aiTimer = window.setTimeout(function () {
                if (!state || state.gameOver || state.turn !== "b") return;
                const move = chooseAiMove(state);
                if (!move) {
                    afterMove();
                    return;
                }
                state = makeMove(state, move);
                selected = null;
                afterMove();
            }, 480);
        }

        function handleSquareClick(square) {
            if (!state || state.gameOver || state.turn !== "w") return;
            const piece = state.board[square];

            if (selected === null) {
                if (piece && pieceColor(piece) === "w") {
                    selected = square;
                    renderBoard();
                }
                return;
            }

            if (piece && pieceColor(piece) === "w") {
                selected = square;
                renderBoard();
                return;
            }

            const possible = legalMoves(state, "w").filter(function (move) {
                return move.from === selected && move.to === square;
            });

            if (!possible.length) {
                selected = null;
                renderBoard();
                return;
            }

            state = makeMove(state, possible[0]);
            selected = null;
            if (!afterMove()) scheduleAi();
        }

        function renderBoard() {
            const root = getRoot();
            if (!root || !state) return;
            const boardEl = root.querySelector(".pl-chess__board");
            if (!boardEl) return;
            boardEl.innerHTML = "";

            const selectedMoves = selected === null ? [] : legalMoves(state, "w").filter(function (move) {
                return move.from === selected;
            });
            const destinationMap = {};
            selectedMoves.forEach(function (move) { destinationMap[move.to] = move; });

            for (let square = 0; square < 64; square++) {
                const pos = rc(square);
                const piece = state.board[square];
                const button = document.createElement("button");
                button.type = "button";
                button.className = "pl-chess__square " + (((pos[0] + pos[1]) % 2) ? "is-dark" : "is-light");
                button.setAttribute("data-square", String(square));
                button.setAttribute("aria-label", (piece ? (pieceColor(piece) === "w" ? "Weiß " : "Schwarz ") + PIECE_NAMES[pieceType(piece)] + " auf " : "Feld ") + squareName(square));

                if (square === selected) button.classList.add("is-selected");
                if (destinationMap[square]) {
                    button.classList.add(piece ? "is-capture" : "is-legal");
                }
                if (piece) {
                    const span = document.createElement("span");
                    span.className = "pl-chess__piece";
                    span.textContent = PIECE_SYMBOLS[piece];
                    button.appendChild(span);
                }

                if (pos[1] === 0) {
                    const rank = document.createElement("span");
                    rank.className = "pl-chess__coord pl-chess__coord--rank";
                    rank.textContent = String(8 - pos[0]);
                    button.appendChild(rank);
                }
                if (pos[0] === 7) {
                    const file = document.createElement("span");
                    file.className = "pl-chess__coord pl-chess__coord--file";
                    file.textContent = "abcdefgh".charAt(pos[1]);
                    button.appendChild(file);
                }

                boardEl.appendChild(button);
            }
        }

        function resetGame() {
            clearTimeout(aiTimer);
            state = initialState();
            selected = null;
            const root = getRoot();
            if (root) {
                const prize = root.querySelector(".pl-chess__voucher");
                if (prize) prize.hidden = !wasWinner();
            }
            setStatus("Du spielst Weiß. Mach den ersten Zug.", "normal");
            renderBoard();
        }

        function celebrate() {
            const root = getRoot();
            if (!root) return;
            const layer = root.querySelector(".pl-chess__confetti");
            if (!layer) return;
            layer.innerHTML = "";
            const chars = ["♟", "♙", "★", "●", "◆"];
            for (let i = 0; i < 28; i++) {
                const bit = document.createElement("span");
                bit.textContent = chars[i % chars.length];
                bit.style.setProperty("--x", String(5 + Math.random() * 90) + "%");
                bit.style.setProperty("--delay", String(Math.random() * 0.55) + "s");
                bit.style.setProperty("--dur", String(1.8 + Math.random() * 1.5) + "s");
                layer.appendChild(bit);
            }
            window.setTimeout(function () { layer.innerHTML = ""; }, 3800);
        }

        function buildModal() {
            if (!document.body || getRoot()) return;

            const root = document.createElement("div");
            root.id = ROOT_ID;
            root.className = "pl-chess";
            root.hidden = true;
            root.innerHTML = '' +
                '<div class="pl-chess__backdrop" data-pl-chess-close="true"></div>' +
                '<section class="pl-chess__dialog" role="dialog" aria-modal="true" aria-labelledby="pl-chess-title">' +
                    '<div class="pl-chess__confetti" aria-hidden="true"></div>' +
                    '<header class="pl-chess__head">' +
                        '<div><div class="pl-chess__eyebrow">PreisLando Easter Egg</div><h2 id="pl-chess-title">♟ Schach um 10 %</h2><p>Schlag den Computer und hol dir den Gutschein.</p></div>' +
                        '<button type="button" class="pl-chess__close" data-pl-chess-close="true" aria-label="Schach schließen">×</button>' +
                    '</header>' +
                    '<div class="pl-chess__body">' +
                        '<div class="pl-chess__game">' +
                            '<div class="pl-chess__status" role="status" aria-live="polite">Du spielst Weiß. Mach den ersten Zug.</div>' +
                            '<div class="pl-chess__board" role="grid" aria-label="Schachbrett"></div>' +
                        '</div>' +
                        '<aside class="pl-chess__side">' +
                            '<div class="pl-chess__rules"><strong>So geht’s</strong><span>Du spielst Weiß.</span><span>Schachmatt = 10 % Gutschein.</span><span>Die Computer-KI spielt absichtlich auf leicht.</span></div>' +
                            '<div class="pl-chess__voucher" hidden>' +
                                '<div class="pl-chess__voucher-title">🏆 Gewonnen!</div>' +
                                '<div class="pl-chess__voucher-copy">Dein 10%-Gutscheincode:</div>' +
                                '<code>' + VOUCHER_CODE + '</code>' +
                                '<button type="button" class="pl-chess__copy">Code kopieren</button>' +
                            '</div>' +
                            '<button type="button" class="pl-chess__new">Neue Partie</button>' +
                            '<div class="pl-chess__tiny">Nur ein kleines PreisLando-Easter-Egg 😉</div>' +
                        '</aside>' +
                    '</div>' +
                '</section>';

            document.body.appendChild(root);

            root.addEventListener("click", function (event) {
                const close = event.target.closest("[data-pl-chess-close]");
                if (close) {
                    event.preventDefault();
                    closeModal();
                    return;
                }

                const square = event.target.closest(".pl-chess__square");
                if (square) {
                    handleSquareClick(parseInt(square.getAttribute("data-square"), 10));
                    return;
                }

                const newGame = event.target.closest(".pl-chess__new");
                if (newGame) {
                    resetGame();
                    return;
                }

                const copy = event.target.closest(".pl-chess__copy");
                if (copy) {
                    const text = VOUCHER_CODE;
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).then(function () {
                            copy.textContent = "Kopiert ✓";
                            window.setTimeout(function () { copy.textContent = "Code kopieren"; }, 1600);
                        }).catch(function () {});
                    }
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && !root.hidden) closeModal();
            });

            resetGame();
        }

        function openModal() {
            buildModal();
            const root = getRoot();
            if (!root) return;
            lastFocusedElement = document.activeElement;
            root.hidden = false;
            document.documentElement.classList.add("pl-chess-open");
            const close = root.querySelector(".pl-chess__close");
            window.requestAnimationFrame(function () {
                if (close) close.focus();
            });
        }

        function closeModal() {
            const root = getRoot();
            if (!root) return;
            root.hidden = true;
            document.documentElement.classList.remove("pl-chess-open");
            if (lastFocusedElement && typeof lastFocusedElement.focus === "function") {
                lastFocusedElement.focus();
            }
        }

        function installFooterTrigger() {
            const candidates = Array.from(document.querySelectorAll('a[href*="plentymarkets.eu"], .copyright a'));
            const anchor = candidates.find(function (link) {
                const text = (link.textContent || "").replace(/\s+/g, " ").trim();
                return text.indexOf("HTI-Line GmbH") !== -1 && text.indexOf("PreisLando") !== -1;
            });
            if (!anchor || anchor.getAttribute("data-pl-chess-trigger") === "1") return false;

            const walker = document.createTreeWalker(anchor, NodeFilter.SHOW_TEXT, null);
            let textNode = null;
            while (walker.nextNode()) {
                if ((walker.currentNode.nodeValue || "").indexOf("GmbH") !== -1) {
                    textNode = walker.currentNode;
                    break;
                }
            }
            if (!textNode) return false;

            const text = textNode.nodeValue || "";
            const base = text.indexOf("GmbH");
            if (base < 0) return false;
            const bIndex = base + 2;
            const before = document.createTextNode(text.slice(0, bIndex));
            const secret = document.createElement("span");
            secret.className = "pl-chess-easter-trigger";
            secret.textContent = text.charAt(bIndex);
            secret.setAttribute("aria-label", "b");
            const after = document.createTextNode(text.slice(bIndex + 1));

            const parent = textNode.parentNode;
            parent.insertBefore(before, textNode);
            parent.insertBefore(secret, textNode);
            parent.insertBefore(after, textNode);
            parent.removeChild(textNode);
            anchor.setAttribute("data-pl-chess-trigger", "1");

            secret.addEventListener("click", function (event) {
                event.preventDefault();
                event.stopPropagation();
                openModal();
            });

            return true;
        }

        function refreshChessTrigger() {
            buildModal();
            installFooterTrigger();
        }

        registerRefresh(refreshChessTrigger);
    })();

    onReady(boot);

})();
</script>
