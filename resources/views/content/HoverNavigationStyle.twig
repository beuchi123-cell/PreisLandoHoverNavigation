<style>
/* =========================================================
   PreisLando Clean Rebuild 2.0.0.0
   Eine CSS-Quelle. Keine historischen Override-Ketten.
   ========================================================= */
:root {
    --pl-green: #51c817;
    --pl-green-dark: #3fa90f;
    --pl-bg: #f3f3f3;
    --pl-text: #222;
    --pl-muted: #666;
    --pl-border: #e2e2e2;
    --pl-header-max: 1400px;
    --pl-mobile-drawer-top: 96px;
}

* { box-sizing: border-box; }
body { background: var(--pl-bg); }

/* ---------------------------------------------------------
   HEADER / NO-FLASH
   Das Plenty-Root "Neuetischkultur SW5" wird direkt per CSS
   ausgeblendet. Das PreisLando-Menü wird als Geschwister-LI
   in dieselbe UL gesetzt. So gibt es kein altes Menü-Blitzen.
   --------------------------------------------------------- */
#page-header-parent,
#page-header,
.header-container {
    background: #fff;
}

@media (min-width: 1200px) {
    #page-header-parent,
    #page-body {
        width: calc(100% - 60px);
        max-width: var(--pl-header-max);
        margin-left: auto;
        margin-right: auto;
    }
}

#page-header-parent li:has(> a[href$="/neuetischkultur-sw5"]),
#page-header-parent li:has(> a[href$="/neuetischkultur-sw5/"]),
#page-header li:has(> a[href$="/neuetischkultur-sw5"]),
#page-header li:has(> a[href$="/neuetischkultur-sw5/"]),
.header-container li:has(> a[href$="/neuetischkultur-sw5"]),
.header-container li:has(> a[href$="/neuetischkultur-sw5/"]) {
    display: none !important;
}

.preis-lando-navigation,
.preis-lando-navigation > .widget-inner,
.preis-lando-navigation-root {
    overflow: visible !important;
}

.preis-lando-navigation {
    position: relative;
    z-index: 10000;
    width: 100%;
    background: #fff;
}

.preis-lando-navigation .brand-wrapper,
.preis-lando-navigation .navbar-brand,
.preis-lando-navigation .brand {
    display: none !important;
}

.preis-lando-navigation .main-navbar-collapsable {
    display: block !important;
    width: 100%;
}

.preis-lando-navigation-root {
    position: relative;
    display: grid !important;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    z-index: 10001;
}

.preis-lando-original-root { display: none !important; }

.preis-lando-nav-category {
    position: static;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
}

.preis-lando-nav-link {
