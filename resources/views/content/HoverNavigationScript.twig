<script>
(function () {

    "use strict";

    const DESKTOP_BREAKPOINT = 1200;
    const MAX_CHILDREN = 100;

    /*
     * Cache für bereits geladene Unterkategorien.
     *
     * Beispiel:
     * {
     *   1234: [...],
     *   5678: [...]
     * }
     */
    const childCache = {};

    /*
     * Verhindert doppelte parallele Requests,
     * wenn man schnell mehrfach über dieselbe
     * Kategorie fährt.
     */
    const childRequests = {};


    /* =====================================================
       ALLGEMEINE HILFSFUNKTIONEN
       ===================================================== */

    function isDesktop()
    {
        return window.innerWidth >= DESKTOP_BREAKPOINT;
    }


    function normalizePath(url)
    {
        if (!url)
        {
            return "";
        }

        try
        {
            const parsed =
                new URL(url, window.location.origin);

            return parsed.pathname
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
        catch (error)
        {
            return String(url)
                .split("?")[0]
                .split("#")[0]
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
    }


    function getCategoryName(category)
    {
        if (
            category &&
            category.details &&
            category.details[0] &&
            category.details[0].name
        )
        {
            return category.details[0].name;
        }

        return "";
    }


    function getCategoryUrl(category)
    {
        if (!category || !category.url)
        {
            return "#";
        }

        let url = category.url;

        if (url.charAt(0) !== "/")
        {
            url = "/" + url;
        }

        /*
         * Sprachpräfix berücksichtigen,
         * falls plentyShop Sprach-URLs nutzt.
         */
        if (
            typeof App !== "undefined" &&
            App.urls &&
            App.urls.includeLanguage &&
            App.language
        )
        {
            const languagePrefix =
                "/" + App.language;

            if (
                url !== languagePrefix &&
                url.indexOf(languagePrefix + "/") !== 0
            )
            {
                url =
                    languagePrefix + url;
            }
        }

        return url;
    }


    /* =====================================================
       BILDER DER UNTERKATEGORIEN
       ===================================================== */

    function getImageSource()
    {
        /*
         * Das ursprüngliche Vue-Element ist nach
         * dem Mount nicht mehr vorhanden.
         *
         * Deshalb verwenden wir image2Path bevorzugt
         * und imagePath als Fallback.
         */
        return "image2Path";
    }


    function getCategoryImage(category)
    {
        if (
            !category ||
            !category.details ||
            !category.details[0]
        )
        {
            return "";
        }

        const details =
            category.details[0];

        const preferredSource =
            getImageSource();

        let imagePath =
            details[preferredSource] ||
            details.image2Path ||
            details.imagePath ||
            "";

        if (!imagePath)
        {
            return "";
        }

        /*
         * Bereits vollständige URL?
         */
        if (
            imagePath.indexOf("https://") === 0 ||
            imagePath.indexOf("http://") === 0
        )
        {
            return imagePath;
        }

        imagePath =
            imagePath.replace(/^\/+/, "");

        /*
         * Falls /documents/ bereits enthalten ist.
         */
        if (
            imagePath.indexOf("documents/") === 0
        )
        {
            return "/" + imagePath;
        }

        return "/documents/" + imagePath;
    }


    /* =====================================================
       VUE / VUEX FINDEN
       ===================================================== */

    function findVueInstance(widget)
    {
        /*
         * Vue 2 hinterlegt an gerenderten DOM-Knoten
         * üblicherweise eine Referenz auf die Vue-Instanz.
         */
        if (widget.__vue__)
        {
            return widget.__vue__;
        }

        const elements =
            widget.querySelectorAll("*");

        for (const element of elements)
        {
            if (element.__vue__)
            {
                return element.__vue__;
            }
        }

        return null;
    }


    function findNavigationStore(widget)
    {
        let vm =
            findVueInstance(widget);

        /*
         * Falls die gefundene Komponente selbst
         * keinen Store hat, Elternkomponenten prüfen.
         */
        while (vm)
        {
            if (
                vm.$store &&
                vm.$store.state &&
                vm.$store.state.navigation
            )
            {
                return vm.$store;
            }

            vm = vm.$parent;
        }

        return null;
    }


    function getLoadedMainCategories(widget)
    {
        const store =
            findNavigationStore(widget);

        if (
            store &&
            store.state &&
            store.state.navigation &&
            Array.isArray(
                store.state.navigation.categoryChildren
            )
        )
        {
            return store.state.navigation.categoryChildren;
        }

        return [];
    }


    /* =====================================================
       SICHTBAREN LINK EINER KATEGORIE ZUORDNEN
       ===================================================== */

    function findCategoryForLink(widget, link)
    {
        const categories =
            getLoadedMainCategories(widget);

        if (!categories.length)
        {
            return null;
        }

        const visiblePath =
            normalizePath(link.href);


        /*
         * 1. Exakter URL-Vergleich
         */
        for (const category of categories)
        {
            const categoryPath =
                normalizePath(
                    getCategoryUrl(category)
                );

            if (
                categoryPath &&
                categoryPath === visiblePath
            )
            {
                return category;
            }
        }


        /*
         * 2. Fallback:
         * URL aus Kategorieobjekt ohne Sprachpräfix.
         */
        for (const category of categories)
        {
            const categoryPath =
                normalizePath(category.url);

            if (
                categoryPath &&
                visiblePath.endsWith(categoryPath)
            )
            {
                return category;
            }
        }


        /*
         * 3. Letzter Fallback:
         * Kategoriename vergleichen.
         */
        const visibleName =
            (
                link.textContent || ""
            )
                .trim()
                .toLowerCase();

        for (const category of categories)
        {
            const categoryName =
                getCategoryName(category)
                    .trim()
                    .toLowerCase();

            if (
                categoryName &&
                categoryName === visibleName
            )
            {
                return category;
            }
        }

        return null;
    }


    /* =====================================================
       API: DIREKTE UNTERKATEGORIEN LADEN
       ===================================================== */

   function fetchCategoryChildren(categoryId)
{
    const url =
        "/rest/io/categorytree/children" +
        "?categoryId=" +
        encodeURIComponent(categoryId) +
        "&indexStart=0" +
        "&maxCount=" +
        MAX_CHILDREN;

    return fetch(
        url,
        {
            credentials: "same-origin",
            headers:
            {
                "X-Requested-With":
                    "XMLHttpRequest"
            }
        }
    )
        .then(function (response)
        {
            if (!response.ok)
            {
                throw new Error(
                    "HTTP " + response.status
                );
            }

            return response.json();
        })
        .then(function (response)
        {
            /*
             * Plenty liefert:
             *
             * {
             *     events: [],
             *     data: [...]
             * }
             *
             * Wir brauchen nur das data-Array.
             */
            if (
                response &&
                Array.isArray(response.data)
            )
            {
                return response.data;
            }

            /*
             * Fallback, falls Plenty irgendwann
             * direkt ein Array liefert.
             */
            if (Array.isArray(response))
            {
                return response;
            }

            return [];
        });
}


    function loadCategoryChildren(categoryId)
    {
        /*
         * Schon im Cache?
         */
        if (
            Object.prototype.hasOwnProperty.call(
                childCache,
                categoryId
            )
        )
        {
            return Promise.resolve(
                childCache[categoryId]
            );
        }


        /*
         * Request läuft schon?
         */
        if (childRequests[categoryId])
        {
            return childRequests[categoryId];
        }


        childRequests[categoryId] =
            fetchCategoryChildren(categoryId)
                .then(function (children)
                {
                    childCache[categoryId] =
                        Array.isArray(children)
                            ? children
                            : [];

                    return childCache[categoryId];
                })
                .catch(function (error)
                {
                    console.error(
                        "PreisLando HoverNavigation:",
                        "Unterkategorien konnten nicht geladen werden.",
                        error
                    );

                    return [];
                })
                .finally(function ()
                {
                    delete childRequests[categoryId];
                });


        return childRequests[categoryId];
    }


    /* =====================================================
       HOVER-DROPDOWN ERZEUGEN
       ===================================================== */

    function getOrCreateMenu(box)
    {
        let menu =
            box.querySelector(
                ":scope > .preis-lando-hover-menu"
            );

        if (menu)
        {
            return menu;
        }

        menu =
            document.createElement("div");

        menu.className =
            "preis-lando-hover-menu";

        box.appendChild(menu);

        return menu;
    }


    function showLoading(menu)
    {
        menu.innerHTML = "";

        menu.classList.remove(
            "is-empty"
        );

        menu.classList.add(
            "is-loading"
        );

        menu.classList.add(
            "is-visible"
        );


        const loading =
            document.createElement("div");

        loading.className =
            "preis-lando-hover-loading";

        loading.textContent =
            "Kategorien werden geladen …";

        menu.appendChild(loading);
    }


    /* =====================================================
       UNTERKATEGORIEN RENDERN
       ===================================================== */

    function renderChildren(menu, children)
    {
        menu.innerHTML = "";

        menu.classList.remove(
            "is-loading"
        );


        /*
         * Keine Unterkategorien vorhanden.
         */
        if (
            !children ||
            !children.length
        )
        {
            menu.classList.add(
                "is-empty"
            );

            menu.classList.remove(
                "is-visible"
            );

            return;
        }


        menu.classList.remove(
            "is-empty"
        );


        for (const category of children)
        {
            const item =
                document.createElement("a");

            item.className =
                "preis-lando-hover-item";

            item.href =
                getCategoryUrl(category);


            /* ---------------------------------------------
               BILD
               --------------------------------------------- */

            const imageUrl =
                getCategoryImage(category);

            if (imageUrl)
            {
                const image =
                    document.createElement("img");

                image.className =
                    "preis-lando-hover-image";

                image.src =
                    imageUrl;

                image.alt =
                    getCategoryName(category);

                image.loading =
                    "lazy";

                item.appendChild(image);
            }
            else
            {
                /*
                 * Platzhalter, damit alle Texte
                 * gleich ausgerichtet bleiben.
                 */
                const placeholder =
                    document.createElement("span");

                placeholder.className =
                    "preis-lando-hover-image " +
                    "preis-lando-hover-image-empty";

                item.appendChild(
                    placeholder
                );
            }


            /* ---------------------------------------------
               NAME
               --------------------------------------------- */

            const text =
                document.createElement("span");

            text.className =
                "preis-lando-hover-text";

            text.textContent =
                getCategoryName(category);

            item.appendChild(text);


            menu.appendChild(item);
        }


        menu.classList.add(
            "is-visible"
        );
    }


    /* =====================================================
       EINZELNE HAUPTKATEGORIE VORBEREITEN
       ===================================================== */

    function prepareCategoryBox(
        widget,
        box
    )
    {
        /*
         * Schon vorbereitet?
         */
        if (
            box.dataset.preisLandoHoverReady
            === "1"
        )
        {
            return;
        }


        const link =
            box.querySelector(":scope > a");

        if (!link)
        {
            return;
        }


        box.dataset.preisLandoHoverReady =
            "1";

        box.classList.add(
            "preis-lando-hover-parent"
        );


        /* ---------------------------------------------
           MOUSE ENTER
           --------------------------------------------- */

        box.addEventListener(
            "mouseenter",
            function ()
            {
                if (!isDesktop())
                {
                    return;
                }


                const category =
                    findCategoryForLink(
                        widget,
                        link
                    );


                /*
                 * Kategorie konnte noch nicht
                 * gefunden werden.
                 *
                 * Das kann direkt während des
                 * Vue-Mountings kurz vorkommen.
                 */
                if (
                    !category ||
                    !category.id
                )
                {
                    console.warn(
                        "PreisLando HoverNavigation:",
                        "Kategorie konnte nicht zugeordnet werden:",
                        link.href
                    );

                    return;
                }


                const menu =
                    getOrCreateMenu(box);


                /*
                 * Bereits einmal geladen?
                 */
                if (
                    menu.dataset.loaded === "1"
                )
                {
                    if (
                        !menu.classList.contains(
                            "is-empty"
                        )
                    )
                    {
                        menu.classList.add(
                            "is-visible"
                        );
                    }

                    return;
                }


                showLoading(menu);


                loadCategoryChildren(
                    category.id
                )
                    .then(function (children)
                    {
                        menu.dataset.loaded =
                            "1";

                        renderChildren(
                            menu,
                            children
                        );
                    });
            }
        );


        /* ---------------------------------------------
           MOUSE LEAVE
           --------------------------------------------- */

        box.addEventListener(
            "mouseleave",
            function ()
            {
                const menu =
                    box.querySelector(
                        ":scope > " +
                        ".preis-lando-hover-menu"
                    );

                if (menu)
                {
                    menu.classList.remove(
                        "is-visible"
                    );
                }
            }
        );
    }


    /* =====================================================
       NAVIGATION INITIALISIEREN
       ===================================================== */

    function initializeHoverNavigation()
    {
        if (!isDesktop())
        {
            return;
        }


        const widget =
            document.querySelector(
                ".kategorie-11-spalten"
            );

        if (!widget)
        {
            return;
        }


        /*
         * Nur echte Kategorie-Kacheln.
         *
         * Der "Mehr anzeigen"-Button würde
         * ansonsten ebenfalls getroffen.
         */
        const boxes =
            widget.querySelectorAll(
                ".row > div"
            );


        boxes.forEach(
            function (box)
            {
                if (
                    box.querySelector(
                        ":scope > a"
                    )
                )
                {
                    prepareCategoryBox(
                        widget,
                        box
                    );
                }
            }
        );
    }


    /* =====================================================
       ALLE HOVER-MENÜS SCHLIESSEN
       ===================================================== */

    function closeAllHoverMenus()
    {
        document
            .querySelectorAll(
                ".preis-lando-hover-menu"
            )
            .forEach(
                function (menu)
                {
                    menu.classList.remove(
                        "is-visible"
                    );
                }
            );
    }


    /* =====================================================
       START
       ===================================================== */

    function start()
    {
        initializeHoverNavigation();


        /*
         * plentyShop rendert die Kategorien über Vue.
         * Deshalb DOM-Änderungen beobachten.
         */
        const observer =
            new MutationObserver(
                function ()
                {
                    if (isDesktop())
                    {
                        initializeHoverNavigation();
                    }
                }
            );


        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );


        /* ---------------------------------------------
           DESKTOP / MOBIL WECHSEL
           --------------------------------------------- */

        let resizeTimer = null;


        window.addEventListener(
            "resize",
            function ()
            {
                clearTimeout(
                    resizeTimer
                );


                resizeTimer =
                    setTimeout(
                        function ()
                        {
                            if (isDesktop())
                            {
                                initializeHoverNavigation();
                            }
                            else
                            {
                                closeAllHoverMenus();
                            }
                        },
                        100
                    );
            }
        );
    }


    /*
     * Start abhängig davon,
     * ob DOMContentLoaded bereits vorbei ist.
     */
    if (
        document.readyState === "loading"
    )
    {
        document.addEventListener(
            "DOMContentLoaded",
            start
        );
    }
    else
    {
        start();
    }

})();
</script>
