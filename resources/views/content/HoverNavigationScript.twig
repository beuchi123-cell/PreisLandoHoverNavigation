    /* =====================================================
       PREISLANDO WARENKORB + ARTIKELDETAIL v1.4.17.7
       Bestätigter F12-Test:
       - Warenkorb-Unterteil weiß
       - Artikeldetail-Hauptbereich weiß
       - Weitere Details per CSS (PreisLandoStyle.twig)
       ===================================================== */
    (function setupPreisLandoProductAndCartPanels() {
        let timer = null;

        function exactText(text) {
            const hits = Array.from(document.querySelectorAll("body *"))
                .filter(function (el) {
                    return el.textContent && el.textContent.trim() === text;
                })
                .sort(function (a, b) {
                    return a.getBoundingClientRect().width - b.getBoundingClientRect().width;
                });

            return hits[0] || null;
        }

        function commonParent(a, b) {
            if (!a || !b) return null;

            const parents = [];
            let x = a;

            while (x) {
                parents.push(x);
                x = x.parentElement;
            }

            x = b;

            while (x) {
                if (parents.indexOf(x) !== -1) return x;
                x = x.parentElement;
            }

            return null;
        }

        function applyPanels() {
            /* -------------------------------------------------
               Warenkorb: Lieferland + Summe gemeinsamer Weißblock
               ------------------------------------------------- */
            const land = exactText("Lieferland");
            const summe = exactText("Summe");

            let lower = commonParent(land, summe);

            if (lower) {
                while (
                    lower.parentElement &&
                    lower.parentElement !== document.body &&
                    lower.getBoundingClientRect().width < 600
                ) {
                    lower = lower.parentElement;
                }

                if (lower && lower !== document.body) {
                    lower.classList.add("pl-cart-lower-panel-v2");
                }
            }

            /* -------------------------------------------------
               Artikeldetail: Produktbild + Kaufbox als Weißblock
               ------------------------------------------------- */
            const cartButton = Array.from(document.querySelectorAll("a,button"))
                .find(function (el) {
                    return el.textContent &&
                        el.textContent.trim().toUpperCase().includes("IN DEN WARENKORB");
                });

            if (cartButton) {
                const imgs = Array.from(document.querySelectorAll("img"))
                    .filter(function (img) {
                        const r = img.getBoundingClientRect();
                        return (
                            r.width > 150 &&
                            r.height > 150 &&
                            r.top > 50 &&
                            r.top < window.innerHeight
                        );
                    })
                    .sort(function (a, b) {
                        const ra = a.getBoundingClientRect();
                        const rb = b.getBoundingClientRect();
                        return (rb.width * rb.height) - (ra.width * ra.height);
                    });

                const mainImage = imgs[0];
                let productBox = commonParent(mainImage, cartButton);

                if (productBox) {
                    while (
                        productBox.parentElement &&
                        productBox.parentElement !== document.body &&
                        productBox.getBoundingClientRect().width < 650
                    ) {
                        productBox = productBox.parentElement;
                    }

                    if (productBox && productBox !== document.body) {
                        productBox.classList.add("pl-product-main-box");
                    }
                }
            }
        }

        function schedule() {
            clearTimeout(timer);
            timer = setTimeout(applyPanels, 60);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", applyPanels);
        } else {
            applyPanels();
        }

        const observer = new MutationObserver(schedule);
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        window.addEventListener("resize", schedule);
    })();

