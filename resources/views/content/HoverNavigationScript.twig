    }

    function installRouteSignals() {
        ["pushState", "replaceState"].forEach(function (name) {
            const original = history[name];
            if (!original || original.__plWrapped) return;
            function wrapped() {
                const result = original.apply(this, arguments);
                window.dispatchEvent(new Event("preislando:route"));
                return result;
            }
            wrapped.__plWrapped = true;
            history[name] = wrapped;
        });
        window.addEventListener("popstate", function () { window.dispatchEvent(new Event("preislando:route")); });
        window.addEventListener("preislando:route", function () {
            state.routeHref = window.location.href;
            closeHoverMenu();
            closeMobileDrawer();
            scheduleRefresh(null);
        });
    }

    function installGlobalEvents() {
        document.addEventListener("click", function (event) {
            const mobileButton = event.target.closest && event.target.closest(".kategorie-mobile-button");
            if (mobileButton && window.innerWidth < BREAKPOINT) {
                event.preventDefault();
                const drawer = getMobileDrawer();
                if (drawer && drawer.classList.contains("is-open")) closeMobileDrawer(); else openMobileDrawer();
                return;
            }
            const drawer = getMobileDrawer();
            if (drawer && event.target === drawer) closeMobileDrawer();
        }, true);

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") { closeHoverMenu(); closeMobileDrawer(); }
        });

        let resizeTimer = null;
        window.addEventListener("resize", function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () { refreshAll(null); }, 100);
        });
    }

    function boot() {
        a11y.build();
        a11y.apply();
        installRouteSignals();
        installGlobalEvents();
        refreshAll(null);

        state.observer = new MutationObserver(function (mutations) {
            scheduleRefresh(mutations);
        });
        state.observer.observe(document.body, { childList: true, subtree: true });

        console.info("[PreisLandoHoverNavigation] Clean Rebuild " + VERSION + " geladen");
    }


