            return piece ? piece.charAt(0) : "";
        }

        function pieceType(piece) {
            return piece ? piece.charAt(1) : "";
        }

        function kingSquare(board, color) {
            return board.indexOf(color + "K");
        }

        function isSquareAttacked(board, square, byColor) {
            const target = rc(square);
            const tr = target[0];
            const tc = target[1];

            for (let from = 0; from < 64; from++) {
                const piece = board[from];
                if (!piece || pieceColor(piece) !== byColor) continue;

                const pos = rc(from);
                const r = pos[0];
                const c = pos[1];
                const type = pieceType(piece);

                if (type === "P") {
                    const dr = byColor === "w" ? -1 : 1;
                    if (r + dr === tr && (c - 1 === tc || c + 1 === tc)) return true;
                    continue;
                }

                if (type === "N") {
                    const steps = [[-2,-1],[-2,1],[-1,-2],[-1,2],[1,-2],[1,2],[2,-1],[2,1]];
                    for (let i = 0; i < steps.length; i++) {
                        if (r + steps[i][0] === tr && c + steps[i][1] === tc) return true;
                    }
                    continue;
                }

                if (type === "K") {
                    if (Math.max(Math.abs(r - tr), Math.abs(c - tc)) === 1) return true;
                    continue;
                }

                const directions = [];
                if (type === "B" || type === "Q") {
                    directions.push([-1,-1],[-1,1],[1,-1],[1,1]);
