<script>
(function () {
    "use strict";

    /* =====================================================
       PREISLANDO HOVER NAVIGATION
       Standard-Kategorienavigation -> Root 1838 ausblenden
       und direkte Kinder als sichtbare Hauptnavigation zeigen.
       ===================================================== */

    const ROOT_CATEGORY_ID = 1838;
    const ROOT_CATEGORY_PATH = "/neuetischkultur-sw5";
    const ROOT_CATEGORY_NAME = "neuetischkultur sw5";

    const HOVER_BREAKPOINT = 768;
    const MAX_CHILDREN = 100;
    const HOVER_OPEN_DELAY = 120;
    const HOVER_CLOSE_DELAY = 350;
    const IMAGE_PRELOAD_CONCURRENCY = 4;
    
    window.PreisLandoHoverVersion = "1.4.26.0";
    document.documentElement.setAttribute("data-preislando-hover-version", "1.4.26.0");
    console.info("[PreisLandoHoverNavigation] v1.4.26.0 geladen");

    let hoverOpenTimer = null;
    let hoverCloseTimer = null;
    let activeHoverBox = null;
    let initializeTimer = null;
    let rootCategoriesPromise = null;

    const childCache = {};
    const childRequests = {};
    const categoryImageCache = {};
    const categoryImageRequests = {};

    const imagePreloadQueue = [];
    let activeImagePreloads = 0;

    function isHoverMode() {
        return window.innerWidth >= HOVER_BREAKPOINT;
    }

    function normalizePath(url) {
        if (!url) return "";

        try {
            return new URL(url, window.location.origin)
                .pathname
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        } catch (error) {
            return String(url)
                .split("?")[0]
                .split("#")[0]
                .replace(/\/+/g, "/")
                .replace(/\/$/, "")
                .toLowerCase();
        }
    }

    function getCategoryName(category) {
        return category && category.details && category.details[0]
            ? (category.details[0].name || "")
            : "";
    }

    function getCategoryUrl(category) {
        if (!category || !category.url) return "#";

        let url = String(category.url);
        if (url.charAt(0) !== "/") url = "/" + url;

        if (
            typeof App !== "undefined" &&
            App.urls &&
            App.urls.includeLanguage &&
            App.language
        ) {
            const languagePrefix = "/" + App.language;
            if (url !== languagePrefix && url.indexOf(languagePrefix + "/") !== 0) {
                url = languagePrefix + url;
            }
        }

        return url;
    }

    function fetchCategoryChildren(categoryId) {
        const url =
            "/rest/io/categorytree/children" +
            "?categoryId=" + encodeURIComponent(categoryId) +
            "&indexStart=0" +
            "&maxCount=" + MAX_CHILDREN;

        return fetch(url, {
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
            .then(function (response) {
                if (!response.ok) throw new Error("HTTP " + response.status);
                return response.json();
            })
            .then(function (response) {
                if (response && Array.isArray(response.data)) return response.data;
                if (Array.isArray(response)) return response;
                return [];
            });
    }

    function loadCategoryChildren(categoryId) {
        if (Object.prototype.hasOwnProperty.call(childCache, categoryId)) {
            return Promise.resolve(childCache[categoryId]);
        }

        if (childRequests[categoryId]) return childRequests[categoryId];

        childRequests[categoryId] = fetchCategoryChildren(categoryId)
            .then(function (children) {
                childCache[categoryId] = Array.isArray(children) ? children : [];
                return childCache[categoryId];
            })
            .catch(function (error) {
                console.error(
                    "PreisLando HoverNavigation: Unterkategorien konnten nicht geladen werden.",
                    categoryId,
                    error
                );
                childCache[categoryId] = [];
                return [];
            })
            .finally(function () {
                delete childRequests[categoryId];
            });

        return childRequests[categoryId];
    }

    function loadRootCategories() {
        /* v1.4.26: Kein Session-Cache fuer leere/fehlgeschlagene Antworten.
           Genau so konnte vorher ein einziger zu frueher API-Aufruf die
           Navigation fuer den Rest der Sitzung leer halten. */
        if (Array.isArray(childCache[ROOT_CATEGORY_ID]) && childCache[ROOT_CATEGORY_ID].length) {
            return Promise.resolve(childCache[ROOT_CATEGORY_ID]);
        }
        if (rootCategoriesPromise) return rootCategoriesPromise;

        const retryDelays = [0, 180, 500, 1100, 2200];

        function attempt(index) {
            const delay = retryDelays[index] || 0;
            const wait = delay > 0
                ? new Promise(function (resolve) { window.setTimeout(resolve, delay); })
                : Promise.resolve();

            return wait.then(function () {
                return fetchCategoryChildren(ROOT_CATEGORY_ID);
            }).then(function (categories) {
                if (Array.isArray(categories) && categories.length) {
                    childCache[ROOT_CATEGORY_ID] = categories;
                    return categories;
                }

                if (index + 1 < retryDelays.length) {
                    return attempt(index + 1);
                }

                console.warn("PreisLando HoverNavigation: Root-Kategorien sind noch leer; spaeterer Neuversuch folgt.");
                return [];
            }).catch(function (error) {
                if (index + 1 < retryDelays.length) {
                    return attempt(index + 1);
                }
                console.error("PreisLando HoverNavigation: Root-Kategorien konnten nicht geladen werden.", error);
                return [];
            });
        }

        rootCategoriesPromise = attempt(0).then(function (categories) {
            if (!categories.length) {
                /* Wichtig: leeres Ergebnis NICHT festhalten. Der Mutation-/Route-
                   Observer darf beim naechsten Durchlauf erneut anfragen. */
                rootCategoriesPromise = null;
            }
            return categories;
        });

        return rootCategoriesPromise;
    }

    function getCategoryImage(category) {
        if (!category || !category.details || !category.details[0]) return "";

        const details = category.details[0];
        let imagePath = details.image2Path || details.imagePath || "";
        if (!imagePath) return "";

        if (/^https?:\/\//i.test(imagePath)) return imagePath;

        imagePath = imagePath.replace(/^\/+/, "");
        return imagePath.indexOf("documents/") === 0
            ? "/" + imagePath
            : "/documents/" + imagePath;
    }

    function loadFallbackCategoryImage(category) {
        if (!category || !category.id) return Promise.resolve("");

        const categoryId = category.id;

        if (Object.prototype.hasOwnProperty.call(categoryImageCache, categoryId)) {
            return Promise.resolve(categoryImageCache[categoryId]);
        }

        if (categoryImageRequests[categoryId]) {
            return categoryImageRequests[categoryId];
        }

        const url = "/rest/preislando/category-image/" + encodeURIComponent(categoryId);

        categoryImageRequests[categoryId] = fetch(url, {
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
            .then(function (response) {
                if (!response.ok) throw new Error("Kategorie-Bild HTTP " + response.status);
                return response.json();
            })
            .then(function (data) {
                const image = data && data.success && data.image ? data.image : "";
                categoryImageCache[categoryId] = image;
                return image;
            })
            .catch(function (error) {
                console.warn(
                    "PreisLando HoverNavigation: Kategorie-Bild konnte nicht geladen werden",
                    categoryId,
                    error
                );
                categoryImageCache[categoryId] = "";
                return "";
            })
            .finally(function () {
                delete categoryImageRequests[categoryId];
            });

        return categoryImageRequests[categoryId];
    }

    function runImagePreloadQueue() {
        while (
            activeImagePreloads < IMAGE_PRELOAD_CONCURRENCY &&
            imagePreloadQueue.length
        ) {
            const job = imagePreloadQueue.shift();
            activeImagePreloads++;

            Promise.resolve()
                .then(job)
                .catch(function () {})
                .finally(function () {
                    activeImagePreloads--;
                    runImagePreloadQueue();
                });
        }
    }

    function queueImagePreload(job) {
        imagePreloadQueue.push(job);
        runImagePreloadQueue();
    }

    function preloadImage(url) {
        if (!url) return Promise.resolve();
        return new Promise(function (resolve) {
            const img = new Image();
            let done = false;
            function finish() {
                if (done) return;
                done = true;
                resolve();
            }
            img.onload = finish;
            img.onerror = finish;
            img.src = url;
            if (img.complete) finish();
        });
    }

    /* =====================================================
       STANDARDNAVIGATION FINDEN
       ===================================================== */

    function findRootLink() {
        const preferred = document.querySelector(".preis-lando-navigation");

        function findIn(scope) {
            if (!scope || !scope.querySelectorAll) return null;
            const links = Array.from(scope.querySelectorAll("li.ddown > a, a"));
            return links.find(function (link) {
                const path = normalizePath(link.getAttribute("href") || link.href);
                const text = (link.textContent || "").trim().toLowerCase();

                return path === ROOT_CATEGORY_PATH ||
                    path.endsWith(ROOT_CATEGORY_PATH) ||
                    text === ROOT_CATEGORY_NAME;
            }) || null;
        }

        /* Bei plentyShop-Seitenwechseln kann die bereits markierte Navigation
           kurzzeitig noch auf die alte DOM-Huelle zeigen. Deshalb bei einem
           Trefferfehler immer noch einmal im gesamten Dokument suchen. */
        return findIn(preferred) || findIn(document);
    }

    function findTopList(rootLink) {
        if (!rootLink) return null;
        const rootLi = rootLink.closest("li");
        if (!rootLi) return null;
        return rootLi.parentElement && rootLi.parentElement.tagName === "UL"
            ? rootLi.parentElement
            : null;
    }

    function getGeneratedBoxes(topList) {
        return Array.from(
            topList.querySelectorAll(":scope > li.preis-lando-nav-category")
        );
    }

    function categoryMatchesLink(category, link) {
        const categoryPath = normalizePath(getCategoryUrl(category));
        const linkPath = normalizePath(link.getAttribute("href") || link.href);

        if (categoryPath && linkPath && (
            categoryPath === linkPath ||
            linkPath.endsWith(categoryPath) ||
            categoryPath.endsWith(linkPath)
        )) {
            return true;
        }

        return getCategoryName(category).trim().toLowerCase() ===
            (link.textContent || "").trim().toLowerCase();
    }

    /* =====================================================
       HAUPTKATEGORIEN AUS ROOT HOCHZIEHEN
       ===================================================== */

    function buildPromotedNavigation(rootLink, categories) {
        const rootLi = rootLink.closest("li");
        const topList = findTopList(rootLink);

        if (!rootLi || !topList || !categories.length) return null;

        topList.classList.add("preis-lando-navigation-root");
        rootLi.classList.add("preis-lando-original-root");

        if (topList.dataset.preisLandoPromoted === "1") {
            const generated = getGeneratedBoxes(topList);
            if (generated.length === categories.length && generated.length > 0) {
                return topList;
            }

            /* plentyShop kann beim internen Seitenwechsel die UL-Huelle
               behalten, aber deren Kinder neu rendern. Dann darf das alte
               data-Flag den Neuaufbau nicht blockieren. */
            generated.forEach(function (entry) { entry.remove(); });
            const staleMenu = getSharedMenu(topList);
            if (staleMenu) staleMenu.remove();
            delete topList.dataset.preisLandoPromoted;
            delete topList.dataset.preisLandoHoverBoundary;
            delete topList.dataset.preisLandoPreloadStarted;
        }

        categories.forEach(function (category) {
            if (!category || !category.id) return;

            const box = document.createElement("li");
            box.className =
                "preis-lando-nav-category preis-lando-hover-parent";
            box.dataset.categoryId = String(category.id);

            const link = document.createElement("a");
            link.className = "preis-lando-nav-link";
            link.href = getCategoryUrl(category);
            link.setAttribute("itemprop", "name");
            link.textContent = getCategoryName(category);

            box.appendChild(link);
            topList.insertBefore(box, rootLi);

            prepareCategoryBox(topList, box, category);
        });

        topList.dataset.preisLandoPromoted = "1";
        return topList;
    }

    /* =====================================================
       GEMEINSAMES RASTER / HOVER-MENÜ
       Der Hover-Bereich ist EIN gemeinsames Grid-Element unter
       allen Hauptkategorien. Er hängt nicht mehr an einem einzelnen LI.
       ===================================================== */

    function cancelHoverOpen() {
        if (hoverOpenTimer) {
            clearTimeout(hoverOpenTimer);
            hoverOpenTimer = null;
        }
    }

    function cancelHoverClose() {
        if (hoverCloseTimer) {
            clearTimeout(hoverCloseTimer);
            hoverCloseTimer = null;
        }
    }

    function getSharedMenu(topList) {
        return topList
            ? topList.querySelector(":scope > .preis-lando-hover-menu")
            : null;
    }

    function closeAllHoverMenus() {
        cancelHoverOpen();
        cancelHoverClose();

        document.querySelectorAll(".preis-lando-hover-menu").forEach(function (menu) {
            menu.classList.remove("is-visible", "is-loading", "is-empty");
        });

        document.querySelectorAll(".preis-lando-hover-parent").forEach(function (box) {
            box.classList.remove("is-hover-active");
        });

        document.querySelectorAll(".preis-lando-navigation-root").forEach(function (root) {
            /* v1.4.16: auch die graue Unterzeilen-Brücke vollständig zurücksetzen. */
            setActiveCategory(root, null);
            root.classList.remove("preis-lando-hover-open");
        });

        activeHoverBox = null;
    }

    function closeActiveHoverMenu() {
        if (!activeHoverBox) {
            closeAllHoverMenus();
            return;
        }

        const topList = activeHoverBox.closest(".preis-lando-navigation-root");
        const menu = getSharedMenu(topList);
        if (menu) menu.classList.remove("is-visible", "is-loading");

        activeHoverBox.classList.remove("is-hover-active");
        if (topList) {
            /* v1.4.16: graue Unterzeilen-Brücke + aria/tabindex sauber zurücksetzen. */
            setActiveCategory(topList, null);
            topList.classList.remove("preis-lando-hover-open");
        }
        activeHoverBox = null;
    }

    function setActiveCategory(topList, box) {
        const boxes = getGeneratedBoxes(topList);
        const activeRect = box ? box.getBoundingClientRect() : null;
        const activeCenter = activeRect ? activeRect.left + activeRect.width / 2 : null;

        boxes.forEach(function (entry) {
            entry.classList.toggle("is-hover-active", entry === box);
            entry.classList.remove("preis-lando-hover-under-active");

            const entryLink = entry.querySelector(":scope > .preis-lando-nav-link");
            if (entryLink) {
                entryLink.removeAttribute("aria-hidden");
                if (entryLink.dataset.plOriginalTabindex === "__none__") {
                    entryLink.removeAttribute("tabindex");
                } else if (entryLink.dataset.plOriginalTabindex !== undefined) {
                    entryLink.setAttribute("tabindex", entryLink.dataset.plOriginalTabindex);
                }
            }

            if (!box || entry === box || !activeRect) return;

            const entryRect = entry.getBoundingClientRect();
            const entryCenter = entryRect.left + entryRect.width / 2;

            /* Liegt in einer tieferen Menüzeile exakt unter der aktiven Spalte? */
            if (
                entryRect.top > activeRect.top + 2 &&
                Math.abs(entryCenter - activeCenter) < Math.max(3, activeRect.width * 0.15)
            ) {
                entry.classList.add("preis-lando-hover-under-active");

                /* Dieser Menüpunkt ist während des Hover-Pfads nur noch
                   graue Verbindungsfläche und darf nicht anklickbar/fokussierbar sein. */
                if (entryLink) {
                    if (entryLink.dataset.plOriginalTabindex === undefined) {
                        entryLink.dataset.plOriginalTabindex = entryLink.hasAttribute("tabindex")
                            ? entryLink.getAttribute("tabindex")
                            : "__none__";
                    }
                    entryLink.setAttribute("tabindex", "-1");
                    entryLink.setAttribute("aria-hidden", "true");
                }
            }
        });
    }

    function updateSharedMenuPointer(topList, box, menu) {
        if (!topList || !box || !menu) return;

        const rootRect = topList.getBoundingClientRect();
        const boxRect = box.getBoundingClientRect();
        const left = Math.max(0, boxRect.left - rootRect.left) + "px";
        const width = boxRect.width + "px";

        menu.style.setProperty("--pl-active-left", left);
        menu.style.setProperty("--pl-active-width", width);

        /* Auch am Root setzen: damit die freie Zelle unter Spalte 1/6
           nur bei Bedarf grau dargestellt wird. */
        topList.style.setProperty("--pl-active-left", left);
        topList.style.setProperty("--pl-active-width", width);
    }

    function getOrCreateSharedMenu(topList) {
        let menu = getSharedMenu(topList);
        if (menu) return menu;

        menu = document.createElement("li");
        menu.className = "preis-lando-hover-menu";
        menu.setAttribute("aria-live", "polite");

        const closeButton = document.createElement("button");
        closeButton.type = "button";
        closeButton.className = "preis-lando-hover-close";
        closeButton.innerHTML =
            "<span>Schließen</span><span class=\"preis-lando-hover-close-x\">×</span>";

        closeButton.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
            closeAllHoverMenus();
        });

        const content = document.createElement("div");
        content.className = "preis-lando-hover-content";

        menu.appendChild(closeButton);
        menu.appendChild(content);

        menu.addEventListener("mouseenter", function () {
            cancelHoverClose();
        });

        menu.addEventListener("mouseleave", function () {
            cancelHoverClose();
            hoverCloseTimer = setTimeout(function () {
                closeActiveHoverMenu();
            }, HOVER_CLOSE_DELAY);
        });

        const originalRoot = topList.querySelector(":scope > .preis-lando-original-root");
        if (originalRoot) topList.insertBefore(menu, originalRoot);
        else topList.appendChild(menu);

        return menu;
    }

    function showLoading(menu) {
        const content = menu.querySelector(".preis-lando-hover-content");
        if (!content) return;

        content.innerHTML = "";
        menu.classList.remove("is-empty");
        menu.classList.add("is-loading", "is-visible");

        const loading = document.createElement("div");
        loading.className = "preis-lando-hover-loading";
        loading.textContent = "Kategorien werden geladen …";
        content.appendChild(loading);
    }

    function createCategoryImageElement(category) {
        const image = document.createElement("img");
        image.className = "preis-lando-hover-image";
        image.alt = getCategoryName(category);
        image.loading = "lazy";

        const directImage = getCategoryImage(category);
        if (directImage) {
            image.src = directImage;
            return image;
        }

        image.classList.add("preis-lando-hover-image-empty");
        image.style.visibility = "hidden";

        loadFallbackCategoryImage(category).then(function (fallbackImage) {
            if (!fallbackImage) return;
            image.src = fallbackImage;
            image.classList.remove("preis-lando-hover-image-empty");
            image.style.visibility = "visible";
        });

        return image;
    }

    function renderChildren(menu, children) {
        const content = menu.querySelector(".preis-lando-hover-content");
        if (!content) return;

        content.innerHTML = "";
        menu.classList.remove("is-loading");

        if (!children || !children.length) {
            menu.classList.add("is-empty");
            menu.classList.remove("is-visible");
            return;
        }

        menu.classList.remove("is-empty");

        children.forEach(function (category) {
            const item = document.createElement("a");
            item.className = "preis-lando-hover-item";
            item.href = getCategoryUrl(category);

            item.appendChild(createCategoryImageElement(category));

            const text = document.createElement("span");
            text.className = "preis-lando-hover-text";
            text.textContent = getCategoryName(category);
            item.appendChild(text);

            content.appendChild(item);
        });

        menu.classList.add("is-visible");
    }

    /* =====================================================
       v1.4.12 – Desktop-Hover als gemeinsamer Bereich

       Wichtig: Das Menü wird NICHT mehr beim Verlassen eines einzelnen
       Kategorien-LI geschlossen. Solange sich die Maus irgendwo im
       gemeinsamen Navigations-Grid (inkl. grauer Verbindungszelle und
       Mega-Menü) befindet, bleibt die aktive Hauptkategorie offen.
       Dadurch funktioniert der Weg z.B.
       Gedeckter Tisch -> Sale -> Mega-Menü ohne Overlay/Mousemove-Tricks.
       ===================================================== */
    function ensureHoverBoundary(topList) {
        if (!topList || topList.dataset.preisLandoHoverBoundary === "1") return;
        topList.dataset.preisLandoHoverBoundary = "1";

        topList.addEventListener("mouseenter", function () {
            if (!isHoverMode()) return;
            cancelHoverClose();
        });

        topList.addEventListener("mouseleave", function () {
            if (!isHoverMode()) return;

            cancelHoverOpen();
            cancelHoverClose();
            hoverCloseTimer = setTimeout(function () {
                closeActiveHoverMenu();
            }, HOVER_CLOSE_DELAY);
        });
    }

    function prepareCategoryBox(topList, box, category) {
        ensureHoverBoundary(topList);
        if (box.dataset.preisLandoHoverReady === "1") return;
        box.dataset.preisLandoHoverReady = "1";

        function openMenu() {
            if (!isHoverMode()) return;

            cancelHoverClose();

            if (activeHoverBox && activeHoverBox !== box) {
                activeHoverBox.classList.remove("is-hover-active");
            }

            activeHoverBox = box;
            setActiveCategory(topList, box);
            topList.classList.add("preis-lando-hover-open");

            const menu = getOrCreateSharedMenu(topList);
            updateSharedMenuPointer(topList, box, menu);
            const categoryId = String(category.id);

            if (menu.dataset.categoryId === categoryId && menu.dataset.loaded === "1") {
                if (!menu.classList.contains("is-empty")) menu.classList.add("is-visible");
                return;
            }

            menu.dataset.categoryId = categoryId;
            menu.dataset.loaded = "0";
            showLoading(menu);

            loadCategoryChildren(category.id).then(function (children) {
                if (activeHoverBox !== box || menu.dataset.categoryId !== categoryId) return;

                menu.dataset.loaded = "1";
                renderChildren(menu, children);
            });
        }

        box.addEventListener("mouseenter", function () {
            if (!isHoverMode()) return;

            /* v1.4.12: Die graue Zelle unter der aktiven Hauptkategorie
               ist nur eine Brücke zum Mega-Menü. Sie darf niemals ihr
               eigenes Hover-Menü öffnen. */
            if (box.classList.contains("preis-lando-hover-under-active")) {
                cancelHoverOpen();
                cancelHoverClose();
                return;
            }

            cancelHoverOpen();
            cancelHoverClose();
            hoverOpenTimer = setTimeout(function () {
                hoverOpenTimer = null;
                openMenu();
            }, HOVER_OPEN_DELAY);
        });

        box.addEventListener("mouseleave", function () {
            if (!isHoverMode()) return;

            /* v1.4.12: Hier nur einen noch nicht ausgeführten OPEN-Timer
               abbrechen. Das Schließen übernimmt ausschließlich der
               gemeinsame topList-Hoverbereich. */
            cancelHoverOpen();
        });
    }

    function preloadHoverImages(categories) {
        if (!isHoverMode() || !Array.isArray(categories)) return;

        categories.forEach(function (mainCategory) {
            if (!mainCategory || !mainCategory.id) return;

            loadCategoryChildren(mainCategory.id).then(function (children) {
                children.forEach(function (child) {
                    if (!child || !child.id) return;

                    const directImage = getCategoryImage(child);
                    if (directImage) {
                        queueImagePreload(function () { return preloadImage(directImage); });
                        return;
                    }

                    queueImagePreload(function () {
                        return loadFallbackCategoryImage(child)
                            .then(function (url) { return preloadImage(url); });
                    });
                });
            });
        });
    }

    /* =====================================================
       MOBILE DRAWER – DIALOG / TOP LAYER
       Liegt technisch immer vor Header, Banner und Shopinhalt.
       ===================================================== */

    function getMobileDialog() {
        return document.querySelector(".preis-lando-mobile-drawer");
    }

    function setMobileButtonState(open) {
        document.querySelectorAll(".kategorie-mobile-button").forEach(function (button) {
            button.classList.toggle("is-open", !!open);
            button.setAttribute("aria-expanded", open ? "true" : "false");
        });
    }

    function closeMobileDrawer() {
        document.documentElement.classList.remove("preis-lando-mobile-menu-open");
        document.body.classList.remove("preis-lando-mobile-menu-open");

        const dialog = getMobileDialog();
        if (dialog) {
            dialog.classList.remove("is-open");
            dialog.setAttribute("aria-hidden", "true");
        }

        setMobileButtonState(false);
    }

    function openMobileDrawer() {
        if (isHoverMode()) return;

        const dialog = getMobileDialog();
        if (!dialog) return;

        dialog.setAttribute("aria-hidden", "false");

        /* v1.4.15: exakt die mobil live getestete Drawer-Geometrie.
           Drawer beginnt direkt unter der sichtbaren Suche. */
        const searchBox =
            document.querySelector(".always-visible-search .position-relative") ||
            document.querySelector(".always-visible-search");
        const panel = dialog.querySelector(".preis-lando-mobile-drawer-panel");
        const bottom = searchBox
            ? Math.max(0, Math.round(searchBox.getBoundingClientRect().bottom))
            : 100;

        dialog.style.setProperty("position", "fixed", "important");
        dialog.style.setProperty("inset", "auto 0 0 0", "important");
        dialog.style.setProperty("top", bottom + "px", "important");
        dialog.style.setProperty("bottom", "0", "important");
        dialog.style.setProperty("height", "calc(100dvh - " + bottom + "px)", "important");
        dialog.style.setProperty("padding-top", "0", "important");

        if (panel) {
            panel.style.setProperty("position", "absolute", "important");
            panel.style.setProperty("inset", "0", "important");
            panel.style.setProperty("height", "100%", "important");
        }

        requestAnimationFrame(function () {
            dialog.classList.add("is-open");
        });

        document.documentElement.classList.add("preis-lando-mobile-menu-open");
        document.body.classList.add("preis-lando-mobile-menu-open");
        setMobileButtonState(true);
    }

    function toggleMobileDrawer() {
        const dialog = getMobileDialog();
        if (!dialog) return;
        if (dialog.classList.contains("is-open")) closeMobileDrawer();
        else openMobileDrawer();
    }

    function buildMobileDrawer(categories) {
        if (!Array.isArray(categories) || !categories.length) return;

        let dialog = getMobileDialog();
        if (!dialog) {
            dialog = document.createElement("div");
            dialog.className = "preis-lando-mobile-drawer";
            dialog.setAttribute("role", "dialog");
            dialog.setAttribute("aria-modal", "true");
            dialog.setAttribute("aria-hidden", "true");
            dialog.setAttribute("aria-label", "Kategorien");

            const panel = document.createElement("div");
            panel.className = "preis-lando-mobile-drawer-panel";
            const list = document.createElement("div");
            list.className = "preis-lando-mobile-drawer-list preis-lando-mobile-tile-grid";
            panel.appendChild(list);
            dialog.appendChild(panel);
            document.body.appendChild(dialog);
            dialog.addEventListener("click", function (event) {
                if (event.target === dialog) closeMobileDrawer();
            });
        }

        const list = dialog.querySelector(".preis-lando-mobile-drawer-list");
        if (!list || list.dataset.ready === "1") return;

        categories.forEach(function (category) {
            if (!category || !category.id) return;
            const card = document.createElement("a");
            card.className = "preis-lando-mobile-tile";
            card.href = getCategoryUrl(category);

            const name = document.createElement("span");
            name.className = "preis-lando-mobile-tile-name";
            name.textContent = getCategoryName(category);

            const imageWrap = document.createElement("span");
            imageWrap.className = "preis-lando-mobile-tile-image-wrap";
            const image = document.createElement("img");
            image.className = "preis-lando-mobile-tile-image";
            image.alt = "";
            image.loading = "lazy";
            imageWrap.appendChild(image);

            card.appendChild(name);
            card.appendChild(imageWrap);
            list.appendChild(card);

            const directImage = getCategoryImage(category);
            if (directImage) {
                image.src = directImage;
            } else {
                loadFallbackCategoryImage(category).then(function (url) {
                    if (url) image.src = url;
                    else imageWrap.classList.add("is-empty");
                }).catch(function () {
                    imageWrap.classList.add("is-empty");
                });
            }
        });
        list.dataset.ready = "1";
    }

    function ensureMobileMenuButton() {
        let button = document.querySelector(".kategorie-mobile-button");
        let topBar = document.querySelector(".preis-lando-topbar") || findTopBarHost(getHeaderScope());

        if (topBar && !topBar.classList.contains("preis-lando-topbar")) {
            topBar.classList.add("preis-lando-topbar", "preis-lando-auto-topbar");
        }

        let host = topBar && (
            topBar.querySelector(".top-bar-items") ||
            topBar.querySelector(":scope > .widget-inner") ||
            topBar
        );

        /* Letzter Fallback fuer Unterseiten: plentyShop rendert die Top-Bar
           dort teilweise in einer anderen Huelle. */
        if (!host) {
            host = document.querySelector("#page-header-parent .top-bar-items, #page-header .top-bar-items, .top-bar-items");
            if (host) {
                topBar = host.parentElement || host;
                if (!topBar.classList.contains("preis-lando-topbar")) {
                    topBar.classList.add("preis-lando-topbar", "preis-lando-auto-topbar");
                }
            }
        }

        if (!button && host) {
            button = document.createElement("button");
            button.type = "button";
            button.className = "kategorie-mobile-button";
            button.setAttribute("aria-label", "Kategorien öffnen");
            button.setAttribute("aria-expanded", "false");
            button.innerHTML = "<span>Kategorien</span>";
            host.insertBefore(button, host.firstChild);
        }

        if (!button) return null;

        /* Mobil muss der Button in der sichtbaren Top Bar liegen –
           niemals in der ausgeblendeten Kategorienavigation. */
        if (window.innerWidth < 768 && host && button.parentNode !== host) {
            host.insertBefore(button, host.firstChild);
        }

        if (button.dataset.preisLandoDirectDrawer !== "1") {
            button.dataset.preisLandoDirectDrawer = "1";

            /* Capture: verhindert Doppel-Toggle durch ältere CustomJS-Handler. */
            button.addEventListener("click", function (event) {
                if (window.innerWidth >= 768) return;
                event.preventDefault();
                event.stopImmediatePropagation();
                toggleMobileDrawer();
            }, true);
        }

        return button;
    }

    /* =====================================================
       v1.4.20 – HEADER-KLASSEN AUF ALLEN SEITENTYPEN

       Hintergrund:
       Die PreisLando-CSS-Klassen wurden im ShopBuilder ursprünglich
       am Startseiten-Header vergeben. Auf Kategorie-, Artikel- und
       Content-Seiten kann plentyShop LTS denselben Header mit einer
       anderen Widget-Hülle rendern. Das zentrale CSS ist dort zwar
       geladen, die Selektoren .preis-lando-logo / -topbar greifen
       dann aber nicht. Ergebnis: großes Logo / Standard-Header.

       Diese Routine erkennt die vorhandenen plentyShop-Header-Elemente
       und ergänzt NUR fehlende Klassen. Bestehende Startseiten-Klassen
       werden nicht verändert oder verschoben.
       ===================================================== */

    function commonAncestorElement(a, b) {
        if (!a || !b) return null;
        const seen = new Set();
        let current = a;
        while (current) {
            seen.add(current);
            current = current.parentElement;
        }
        current = b;
        while (current) {
            if (seen.has(current)) return current;
            current = current.parentElement;
        }
        return null;
    }

    function getHeaderScope() {
        return document.querySelector("#page-header-parent") ||
            document.querySelector("#page-header") ||
            document.querySelector(".header-container") ||
            document.querySelector("header") ||
            document;
    }

    function findPreisLandoLogoImage(scope) {
        if (!scope || !scope.querySelectorAll) return null;

        const images = Array.from(scope.querySelectorAll("img"));
        let best = null;
        let bestScore = -1;

        images.forEach(function (img) {
            const src = String(img.currentSrc || img.src || img.getAttribute("src") || "").toLowerCase();
            const alt = String(img.getAttribute("alt") || "").toLowerCase();
            const title = String(img.getAttribute("title") || "").toLowerCase();
            const haystack = src + " " + alt + " " + title;

            /* Icons, Zahlungslogos und Produktbilder möglichst ausschließen. */
            let score = 0;
            if (haystack.indexOf("preislando") !== -1) score += 120;
            if (haystack.indexOf("preis-lando") !== -1) score += 120;
            if (haystack.indexOf("logo") !== -1) score += 45;
            if (haystack.indexOf("preis") !== -1 && haystack.indexOf("lando") !== -1) score += 80;
            if (img.closest(".widget-image-box")) score += 20;

            const width = img.naturalWidth || img.width || 0;
            const height = img.naturalHeight || img.height || 0;
            if (width >= 120 && height >= 25 && width > height) score += 12;
            if (width <= 64 && height <= 64) score -= 50;

            if (score > bestScore) {
                bestScore = score;
                best = img;
            }
        });

        return bestScore >= 30 ? best : null;
    }

    function findTopBarHost(scope) {
        const existing = document.querySelector(".preis-lando-topbar");
        if (existing) return existing;

        if (!scope || !scope.querySelector) return null;

        const topItems = scope.querySelector(".top-bar-items") ||
            document.querySelector("#page-header-parent .top-bar-items, #page-header .top-bar-items, .top-bar-items");
        if (topItems) {
            /* Klasse absichtlich auf eine Hülle setzen, damit bestehende
               Selektoren '.preis-lando-topbar .top-bar-items' greifen. */
            return topItems.parentElement || topItems;
        }

        const search = scope.querySelector(".always-visible-search") ||
            document.querySelector("#page-header-parent .always-visible-search, #page-header .always-visible-search, .always-visible-search");
        const controls = scope.querySelector(".controls, .controls-list") ||
            document.querySelector("#page-header-parent .controls, #page-header .controls, .controls, .controls-list");
        if (search && controls) {
            const common = commonAncestorElement(search, controls);
            if (common && common !== document.body && common !== document.documentElement) {
                return common;
            }
        }

        return null;
    }

    function findNavigationHost(rootLink) {
        const existing = document.querySelector(".preis-lando-navigation");
        if (existing) return existing;
        if (!rootLink) return null;

        let current = rootLink.parentElement;
        let fallback = null;
        while (current && current !== document.body) {
            if (current.matches && current.matches("nav, .main-navbar-collapsable, .widget-navigation-tree, .widget-navigation")) {
                fallback = current;
                if (current.parentElement && current.parentElement !== document.body) {
                    return current.parentElement;
                }
                return current;
            }
            if (!fallback && current.querySelector && current.querySelector(".main-navbar-collapsable")) {
                fallback = current;
            }
            current = current.parentElement;
        }
        return fallback;
    }

    function ensureGlobalPreisLandoHeaderClasses() {
        const scope = getHeaderScope();

        /* Logo: nur ergänzen, wenn der ShopBuilder die Klasse auf diesem
           Seitentyp nicht bereits mitliefert. */
        let logoHost = document.querySelector(".preis-lando-logo");
        if (!logoHost) {
            const logoImage = findPreisLandoLogoImage(scope);
            if (logoImage) {
                logoHost = logoImage.closest(".widget-image-box") ||
                    logoImage.closest("[class*='widget-image']") ||
                    logoImage.parentElement;
                if (logoHost) {
                    logoHost.classList.add("preis-lando-logo", "preis-lando-auto-logo");
                }
            }
        }

        let topBarHost = findTopBarHost(scope);
        if (topBarHost && !topBarHost.classList.contains("preis-lando-topbar")) {
            topBarHost.classList.add("preis-lando-topbar", "preis-lando-auto-topbar");
        }

        const rootLink = findRootLink();
        const navigationHost = findNavigationHost(rootLink);
        if (navigationHost && !navigationHost.classList.contains("preis-lando-navigation")) {
            navigationHost.classList.add("preis-lando-navigation", "preis-lando-auto-navigation");
        }

        /* Gemeinsame Header-Zeile nur dann ergänzen, wenn ein kompakter
           gemeinsamer Vorfahr vorhanden ist. Dadurch fassen wir nicht den
           kompletten page-header-parent als Flex-Zeile an. */
        if (!document.querySelector(".header-logo-suche") && logoHost && topBarHost) {
            const row = commonAncestorElement(logoHost, topBarHost);
            if (row &&
                row !== document.body &&
                row !== document.documentElement &&
                row.id !== "page-header-parent") {
                const rect = row.getBoundingClientRect();
                if (!rect.height || rect.height < 240) {
                    row.classList.add("header-logo-suche", "preis-lando-auto-header-row");
                }
            }
        }

        /* Mobile-Regeln erwarten diese Kennzeichnung an der Top Bar. */
        if (topBarHost) {
            topBarHost.classList.toggle("preis-lando-mobile-header", window.innerWidth < HOVER_BREAKPOINT);
        }
    }

    /* =====================================================
       v1.4.26 – EINZIGE HEADER-ANORDNUNG

       Diese Logik ersetzt das fruehere CustomJS im Plugin
       "Custom CSS/JS im Frontend". Sie wird bei echten Reloads
       UND bei internen plentyShop-Routen erneut ausgefuehrt.
       ===================================================== */

    const originalHeaderPositions = new WeakMap();

    function rememberHeaderPosition(element) {
        if (!element || !element.parentNode || originalHeaderPositions.has(element)) return;
        originalHeaderPositions.set(element, {
            parent: element.parentNode,
            next: element.nextSibling
        });
    }

    function restoreHeaderPosition(element) {
        if (!element) return;
        const saved = originalHeaderPositions.get(element);
        if (!saved || !saved.parent || !saved.parent.isConnected) return;
        if (element.parentNode === saved.parent && element.nextSibling === saved.next) return;
        if (saved.next && saved.next.parentNode === saved.parent) {
            saved.parent.insertBefore(element, saved.next);
        } else {
            saved.parent.appendChild(element);
        }
    }

    function syncPreisLandoHeaderLayout() {
        const scope = getHeaderScope();
        let topBar = document.querySelector(".preis-lando-topbar") || findTopBarHost(scope);
        if (!topBar) return;

        if (!topBar.classList.contains("preis-lando-topbar")) {
            topBar.classList.add("preis-lando-topbar", "preis-lando-auto-topbar");
        }

        const host = topBar.querySelector(".top-bar-items") ||
            topBar.querySelector(":scope > .widget-inner") ||
            topBar;

        const logo = document.querySelector(".preis-lando-logo");
        const controls = topBar.querySelector(".controls") ||
            document.querySelector("#page-header-parent .controls, #page-header .controls, .controls");
        const search = topBar.querySelector(".always-visible-search") ||
            document.querySelector("#page-header-parent .always-visible-search, #page-header .always-visible-search, .always-visible-search");
        const button = ensureMobileMenuButton();
        const mobile = window.innerWidth < HOVER_BREAKPOINT;

        if (mobile) {
            rememberHeaderPosition(logo);
            rememberHeaderPosition(search);

            if (button && button.parentNode !== host) {
                host.insertBefore(button, host.firstChild);
            }

            if (logo && logo.parentNode !== host) {
                if (controls && controls.parentNode === host) {
                    host.insertBefore(logo, controls);
                } else if (button && button.parentNode === host) {
                    button.insertAdjacentElement("afterend", logo);
                } else {
                    host.appendChild(logo);
                }
            }

            if (search && search.parentNode !== host) {
                host.appendChild(search);
            }

            if (search) search.classList.add("preis-lando-mobile-search");
            topBar.classList.add("preis-lando-mobile-header");

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    const headerRect = topBar.getBoundingClientRect();
                    const searchBox = search
                        ? (search.querySelector(".position-relative") || search)
                        : topBar;
                    const searchRect = searchBox.getBoundingClientRect();
                    const headerHeight = Math.ceil(headerRect.height);
                    const drawerTop = Math.max(0, Math.ceil(searchRect.bottom));
                    if (headerHeight > 0) {
                        document.documentElement.style.setProperty("--pl-mobile-header-height", headerHeight + "px");
                    }
                    if (drawerTop > 0) {
                        document.documentElement.style.setProperty("--pl-mobile-drawer-top", drawerTop + "px");
                    }
                });
            });
        } else {
            if (search) {
                search.classList.remove("preis-lando-mobile-search");
                restoreHeaderPosition(search);
            }
            restoreHeaderPosition(logo);
            topBar.classList.remove("preis-lando-mobile-header");
            closeMobileDrawer();
        }
    }

    /* =====================================================
       INITIALISIERUNG
       ===================================================== */

    function initializeHoverNavigation() {
        ensureGlobalPreisLandoHeaderClasses();
        syncPreisLandoHeaderLayout();
        const rootLink = findRootLink();
        if (!rootLink) return;

        loadRootCategories().then(function (categories) {
            if (!Array.isArray(categories) || !categories.length) {
                document.documentElement.classList.remove("preis-lando-nav-ready");
                window.setTimeout(scheduleInitialize, 900);
                return;
            }

            const topList = buildPromotedNavigation(rootLink, categories);
            if (!topList) {
                document.documentElement.classList.remove("preis-lando-nav-ready");
                window.setTimeout(scheduleInitialize, 500);
                return;
            }

            document.documentElement.classList.add("preis-lando-nav-ready");
            buildMobileDrawer(categories);
            ensureMobileMenuButton();

            if (!isHoverMode()) {
                closeAllHoverMenus();
                return;
            }

            if (topList.dataset.preisLandoPreloadStarted !== "1") {
                topList.dataset.preisLandoPreloadStarted = "1";
                setTimeout(function () {
                    preloadHoverImages(categories);
                }, 1500);
            }
        });
    }

    function scheduleInitialize() {
        clearTimeout(initializeTimer);
        initializeTimer = setTimeout(initializeHoverNavigation, 80);
    }

    function start() {
        ensureGlobalPreisLandoHeaderClasses();
        ensureMobileMenuButton();
        syncPreisLandoHeaderLayout();
        initializeHoverNavigation();

        const observer = new MutationObserver(function () {
            ensureGlobalPreisLandoHeaderClasses();
            syncPreisLandoHeaderLayout();
            scheduleInitialize();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        /* plentyShop LTS wechselt einige Seiten ohne klassischen Voll-Reload.
           Mehrere kurze Nachpruefungen sorgen dafuer, dass Navigation und
           Mobile-Button auch nach einem internen Route-Wechsel sofort wieder
           aufgebaut werden und kein manuelles Aktualisieren noetig ist. */
        let lastKnownUrl = window.location.href;
        function refreshAfterRouteChange() {
            [0, 80, 220, 500, 1000, 1800].forEach(function (delay) {
                window.setTimeout(function () {
                    ensureGlobalPreisLandoHeaderClasses();
                    ensureMobileMenuButton();
                    syncPreisLandoHeaderLayout();
                    initializeHoverNavigation();
                }, delay);
            });
        }

        window.addEventListener("popstate", refreshAfterRouteChange);
        window.addEventListener("hashchange", refreshAfterRouteChange);
        window.addEventListener("pageshow", refreshAfterRouteChange);

        document.addEventListener("click", function (event) {
            const link = event.target && event.target.closest
                ? event.target.closest("a[href]")
                : null;
            if (!link) return;
            try {
                const targetUrl = new URL(link.href, window.location.href);
                if (targetUrl.origin === window.location.origin) {
                    window.setTimeout(function () {
                        if (window.location.href !== lastKnownUrl) {
                            lastKnownUrl = window.location.href;
                            refreshAfterRouteChange();
                        } else {
                            /* Auch Router, die URL und DOM zeitversetzt aendern. */
                            refreshAfterRouteChange();
                        }
                    }, 60);
                }
            } catch (error) {}
        }, true);

        window.setInterval(function () {
            if (window.location.href !== lastKnownUrl) {
                lastKnownUrl = window.location.href;
                refreshAfterRouteChange();
            }
        }, 400);

        let resizeTimer = null;
        window.addEventListener("resize", function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                ensureGlobalPreisLandoHeaderClasses();
                syncPreisLandoHeaderLayout();
                initializeHoverNavigation();
                if (!isHoverMode()) {
                    closeAllHoverMenus();
                } else {
                    closeMobileDrawer();
                }
            }, 100);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
    } else {
        start();
    }

    /* =====================================================
       PREISLANDO SCHNELLSUCHE – PREISE
       ===================================================== */

    (function setupAutocompletePrices() {
        const priceCache = {};
        const pendingPrices = {};

        function getIdsFromAutocompleteUrl(url) {
            if (!url) return null;

            const cleanUrl = String(url)
                .split("?")[0]
                .replace(/\/+$/, "");

            const match = cleanUrl.match(/_(\d+)_(\d+)$/);
            if (!match) return null;

            return {
                itemId: parseInt(match[1], 10),
                variationId: parseInt(match[2], 10)
            };
        }

        function loadVariationPrice(itemId, variationId) {
            const cacheKey = itemId + "_" + variationId;

            if (Object.prototype.hasOwnProperty.call(priceCache, cacheKey)) {
                return Promise.resolve(priceCache[cacheKey]);
            }

            if (pendingPrices[cacheKey]) return pendingPrices[cacheKey];

            const url = "/rest/preislando/search-price/" + encodeURIComponent(variationId);

            pendingPrices[cacheKey] = fetch(url, {
                credentials: "same-origin",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (response) {
                    if (!response.ok) throw new Error("Preis HTTP " + response.status);
                    return response.json();
                })
                .then(function (data) {
                    const price = data && data.success && data.price ? data.price : "";
                    priceCache[cacheKey] = price;
                    return price;
                })
                .catch(function (error) {
                    console.warn(
                        "PreisLando Schnellsuche: Preis konnte nicht geladen werden",
                        itemId,
                        variationId,
                        error
                    );
                    priceCache[cacheKey] = "";
                    return "";
                })
                .finally(function () {
                    delete pendingPrices[cacheKey];
                });

            return pendingPrices[cacheKey];
        }

        function getOrCreatePriceElement(link) {
            let price = link.querySelector(":scope > .preis-lando-search-price");
            if (price) return price;

            price = document.createElement("span");
            price.className = "preis-lando-search-price";
            link.appendChild(price);
            return price;
        }

        function prepareAutocompleteItem(link) {
            if (link.dataset.preisLandoPriceReady === "1") return;

            const ids = getIdsFromAutocompleteUrl(link.getAttribute("href"));
            if (!ids) return;

            link.dataset.preisLandoPriceReady = "1";
            const priceElement = getOrCreatePriceElement(link);
            priceElement.textContent = "";

            loadVariationPrice(ids.itemId, ids.variationId).then(function (price) {
                if (price) priceElement.textContent = price;
            });
        }

        function initializeAutocompletePrices() {
            document.querySelectorAll(
                ".autocomplete-suggestions a.autocomplete-suggestion"
            ).forEach(prepareAutocompleteItem);
        }

        const autocompleteObserver = new MutationObserver(initializeAutocompletePrices);
        autocompleteObserver.observe(document.body, {
            childList: true,
            subtree: true
        });

        initializeAutocompletePrices();
    })();

    /* =====================================================
       PREISLANDO WARENKORB-STYLING v1.4.17.6
       Klassen werden anhand der tatsächlich sichtbaren Texte gesetzt.
       Dadurch bleibt das Styling unabhängig von Plenty-internen
       Basket-Klassennamen.
       ===================================================== */
    (function setupPreisLandoCartStyling() {
        let applyTimer = null;

        function normalizeText(element) {
            return element && element.textContent
                ? element.textContent.trim().toUpperCase()
                : "";
        }

        function findLeafText(text) {
            return Array.from(document.querySelectorAll("*")).find(function (element) {
                return element.children.length === 0 &&
                    element.textContent &&
                    element.textContent.trim() === text;
            }) || null;
        }

        function commonAncestor(a, b) {
            if (!a || !b) return null;

            const parents = [];
            let current = a;

            while (current) {
                parents.push(current);
                current = current.parentElement;
            }

            current = b;

            while (current) {
                if (parents.indexOf(current) !== -1) return current;
                current = current.parentElement;
            }

            return null;
        }

        function applyCartStyling() {
            const cartTitle = Array.from(
                document.querySelectorAll("h1,h2,h3,h4")
            ).find(function (element) {
                return normalizeText(element) === "WARENKORB";
            });

            if (cartTitle) {
                cartTitle.classList.add("pl-cart-title");

                let bar = cartTitle.parentElement;
                while (bar && bar !== document.body) {
                    const bg = window.getComputedStyle(bar).backgroundColor;
                    if (
                        bg &&
                        bg !== "rgba(0, 0, 0, 0)" &&
                        bg !== "transparent"
                    ) {
                        break;
                    }
                    bar = bar.parentElement;
                }

                if (bar && bar !== document.body) {
                    bar.classList.add("pl-cart-title-bar");
                }
            }

            Array.from(document.querySelectorAll("a,button")).forEach(function (element) {
                if (normalizeText(element) === "KASSE") {
                    element.classList.add("pl-cart-checkout-button");
                }
            });

            const land = findLeafText("Lieferland");
            const summe = findLeafText("Summe");
            const lowerPanel = commonAncestor(land, summe);

            if (lowerPanel && lowerPanel !== document.body) {
                lowerPanel.classList.add("pl-cart-lower-panel");
            }
        }

        function scheduleApply() {
            clearTimeout(applyTimer);
            applyTimer = setTimeout(applyCartStyling, 50);
