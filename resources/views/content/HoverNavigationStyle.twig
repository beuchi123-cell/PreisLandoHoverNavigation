        background: #eeeeee !important;
    }

    .preis-lando-hover-menu {
        border: 0 !important;
        outline: 0 !important;
    }

    .preis-lando-hover-item {
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
    }

