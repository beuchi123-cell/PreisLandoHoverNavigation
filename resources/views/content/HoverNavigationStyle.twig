   damit auch px-Schriftgrößen sichtbar mitwachsen.
   --------------------------------------------------------- */
html[data-pl-a11y-grayscale="on"] body > *:not(#pl-a11y-root):not(#pl-chess-easter) { filter:grayscale(1); }
html[data-pl-a11y-contrast="on"] body > *:not(#pl-a11y-root):not(#pl-chess-easter) { filter:contrast(1.28); }
html[data-pl-a11y-grayscale="on"][data-pl-a11y-contrast="on"] body > *:not(#pl-a11y-root):not(#pl-chess-easter) { filter:grayscale(1) contrast(1.28); }
